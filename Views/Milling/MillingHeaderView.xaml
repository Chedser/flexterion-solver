<UserControl x:Class="MechCore.Views.Milling.MillingHeaderView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:MechCore.Controls"
            xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
            xmlns:core="clr-namespace:MechCore.Core">

    <UserControl.Resources>
        <core:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1050">

            <!-- ЗАГОЛОВОК МОДУЛЯ -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Генератор шапки фрезерной программы (ЧПУ)"
                           FontSize="24" FontWeight="Bold" Foreground="#263238" />
                <TextBlock Text="Формирование безопасного начала фрезерной УП (Fanuc / Haas / Sinumerik) с проверкой корректоров и высоты подвода"
                           FontSize="13" Foreground="#546E7A" Margin="0,4,0,0" />
            </StackPanel>

            <!-- ОСНОВНАЯ ДВУХКОЛОНОЧНАЯ СЕТКА -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ КОЛОНКА: НАСТРОЙКИ ПАРАМЕТРОВ ШАПКИ -->
                <StackPanel Grid.Column="0">
                    <!-- Блок 1: Система ЧПУ и идентификация -->
                    <materialDesign:Card Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="1. Система ЧПУ и идентификация"
                                            FontSize="16" FontWeight="Bold" Foreground="#263238" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right"
                                        Content="Сброс"
                                        Command="{Binding ResetDefaultsCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="28" Padding="10,0" FontSize="12" Cursor="Hand" />
                            </DockPanel>

                            <ComboBox ItemsSource="{Binding SystemOptions}"
                                        SelectedItem="{Binding SelectedSystem}"
                                        DisplayMemberPath="Title"
                                        materialDesign:HintAssist.Hint="Диалект G-кодов стойки ЧПУ"
                                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                        Margin="0,0,0,8" />

                            <TextBlock Text="{Binding SelectedSystem.Subtitle}"
                                        FontSize="12" Foreground="#546E7A" TextWrapping="Wrap"
                                        Margin="0,0,0,14" />

                            <!-- Номер программы -->
                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <CheckBox Content="Номер программы (Oxxxx)"
                                                    IsChecked="{Binding IncludeProgramNumber}"
                                                    FontWeight="SemiBold" Foreground="#263238" Cursor="Hand" />
                                        <TextBlock Text="Добавляет символ начала файла % и 4-значный номер программы."
                                                    FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="24,2,0,0"
                                                    Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <TextBox Grid.Column="1"
                                            Text="{Binding ProgramNumberRaw, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IncludeProgramNumber}"
                                             MaxLength="4"
                                            core:NumericInputBehavior.IsInteger="True"
                                            materialDesign:HintAssist.Hint="0001"
                                            materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Блок 2: Строка безопасности (сброс режимов) -->
                    <materialDesign:Card Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="2. Строка безопасности (сброс режимов)"
                                        FontSize="16" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,12" />

                            <!-- Рабочая плоскость G17 / G18 / G19 -->
                            <ComboBox ItemsSource="{Binding WorkPlanes}"
                                        SelectedItem="{Binding SelectedWorkPlane}"
                                        materialDesign:HintAssist.Hint="Рабочая плоскость (G17 = XY)"
                                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                        Margin="0,0,0,6" />
                            <TextBlock Text="G17 задаёт рабочую плоскость XY и ось инструмента Z для круговой интерполяции G02/G03 и циклов сверления."
                                        FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="0,0,0,12"
                                        Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />

                            <!-- G21 / G71 -->
                            <StackPanel Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding UseMetricG21}" FontWeight="SemiBold" Foreground="#263238" Cursor="Hand">
                                    <TextBlock>
                                            <Run Text="{Binding MetricCodeLabel, Mode=OneWay}" />
                                            <Run Text=" — Метрическая система (мм)" />
                                    </TextBlock>
                                </CheckBox>
                                <TextBlock Text="Переключает стойку в миллиметры. Защищает от работы в дюймах (G20 / G70)."
                                            FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="24,2,0,0"
                                            Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- G40 -->
                            <StackPanel Margin="0,0,0,10">
                                <CheckBox Content="G40 — Отмена коррекции на радиус фрезы"
                                            IsChecked="{Binding UseG40}"
                                            FontWeight="SemiBold" Foreground="#263238" Cursor="Hand" />
                                <TextBlock Text="Сбрасывает активную компенсацию на радиус G41/G42 от прерванного контура."
                                            FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="24,2,0,0"
                                            Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- G49 -->
                            <StackPanel Margin="0,0,0,10"
                                        Visibility="{Binding IsSinumerikSystem, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <CheckBox Content="G49 — Отмена коррекции на длину инструмента"
                                            IsChecked="{Binding UseG49}"
                                            FontWeight="SemiBold" Foreground="#263238" Cursor="Hand" />
                                <TextBlock Text="Сбрасывает предыдущий вылет инструмента H перед установкой новой фрезы."
                                            FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="24,2,0,0"
                                            Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- G80 -->
                            <StackPanel Margin="0,0,0,10">
                                <CheckBox Content="G80 — Отмена постоянных циклов"
                                            IsChecked="{Binding UseG80}"
                                         FontWeight="SemiBold" Foreground="#263238" Cursor="Hand" />
                                <TextBlock Text="Отключает циклы сверления, растачивания и нарезания резьбы метчиком (G81–G89)."
                                            FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="24,2,0,0"
                                            Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- G90 -->
                            <StackPanel Margin="0,0,0,10">
                                <CheckBox Content="G90 — Абсолютные координаты"
                                            IsChecked="{Binding UseG90}"
                                            FontWeight="SemiBold" Foreground="#263238" Cursor="Hand" />
                                <TextBlock Text="Переводит станок в абсолютный отсчёт от нуля детали (G54), отменяя приращения G91."
                                            FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="24,2,0,0"
                                             Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- G94 -->
                            <StackPanel>
                                <CheckBox Content="G94 — Минутная подача (мм/мин)"
                                            IsChecked="{Binding UseG94}"
                                            FontWeight="SemiBold" Foreground="#263238" Cursor="Hand" />
                                <TextBlock Text="Задаёт подачу в миллиметрах в минуту (основной режим для фрезерования; защищает от подачи на оборот G95)."
                                             FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="24,2,0,0"
                                            Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Блок 3: Отвод шпинделя по Z и привязка (РСК) -->
                    <materialDesign:Card Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="3. Отвод шпинделя по Z и привязка (РСК)"
                                        FontSize="16" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,12" />

                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox Content="Подъём шпинделя по оси Z в ноль станка"
                                                IsChecked="{Binding UseSafeZHome}"
                                                FontWeight="SemiBold" Foreground="#263238" Cursor="Hand" />
                                    <TextBlock Text="Поднимает шпиндель в верхнюю безопасную точку перед поворотом магазина и сменой инструмента."
                                                FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="24,2,0,0"
                                                Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />

                                    <ComboBox ItemsSource="{Binding HomeSyntaxOptions}"
                                                SelectedItem="{Binding SelectedHomeSyntax}"
                                              IsEnabled="{Binding IsManualSystem}"
                                              Visibility="{Binding UseSafeZHome, Converter={StaticResource BoolToVis}}"
                                              materialDesign:HintAssist.Hint="Формат команды отвода по Z"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <ComboBox ItemsSource="{Binding WorkOffsets}"
                                      SelectedItem="{Binding SelectedWorkOffset}"
                                      materialDesign:HintAssist.Hint="Рабочая система координат (РСК)"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Margin="0,0,0,6" />
                            <TextBlock Text="Активирует нулевую точку детали (X0 Y0 Z0), привязанную наладчиком в тисках или на столе."
                                        FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap"
                                        Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Блок 4: Вызов и смена инструмента (M06) -->
                    <materialDesign:Card Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox Content="4. Вызов и смена инструмента (M06)"
                                      IsChecked="{Binding IncludeToolCall}"
                                      FontSize="16" FontWeight="Bold" Foreground="#263238" Cursor="Hand"
                                      Margin="0,0,0,10" />

                            <StackPanel IsEnabled="{Binding IncludeToolCall}">
                                <TextBlock Text="Вызывает фрезу/сверло из инструментального магазина (T) и устанавливает в шпиндель (M06)."
                                            FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="0,0,0,12"
                                            Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />

                                <ComboBox ItemsSource="{Binding ToolChangeSyntaxOptions}"
                                          SelectedItem="{Binding SelectedToolChangeSyntax}"
                                          IsEnabled="{Binding IsManualSystem}"
                                          materialDesign:HintAssist.Hint="Формат смены инструмента"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Margin="0,0,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding ToolNumbers}"
                                              SelectedItem="{Binding SelectedToolNumber}"
                                              materialDesign:HintAssist.Hint="Номер инструмента (T)"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding OffsetNumbers}"
                                              SelectedItem="{Binding SelectedLengthOffsetNumber}"
                                              materialDesign:HintAssist.Hint="{Binding OffsetComboHint}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Блок 5: Шпиндель, безопасный подвод Z и СОЖ -->
                    <materialDesign:Card Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="5. Шпиндель, безопасный подвод Z и СОЖ"
                                        FontSize="16" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,12" />

                            <!-- Вращение шпинделя -->
                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox Content="Включить вращение шпинделя (S / M03)"
                                              IsChecked="{Binding IncludeSpindleStart}"
                                              FontWeight="SemiBold" Foreground="#263238" Cursor="Hand"
                                              Margin="0,0,0,10" />

                                    <Grid IsEnabled="{Binding IncludeSpindleStart}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding SpindleRpmRaw, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="5"
                                                 core:NumericInputBehavior.IsInteger="True"
                                                 materialDesign:HintAssist.Hint="Обороты S (об/мин)"
                                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding SpindleDirections}"
                                                  SelectedItem="{Binding SelectedSpindleDirection}"
                                                  materialDesign:HintAssist.Hint="Направление вращения"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Компенсация длины G43 и безопасный подвод по Z -->
                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox Content="Компенсация длины G43 и подвод по Z"
                                              IsChecked="{Binding UseSafeZApproach}"
                                              FontWeight="SemiBold" Foreground="#263238" Cursor="Hand" />
                                    <TextBlock Text="Активирует вылет инструмента по оси Z (G43 H...) и подводит фрезу на безопасную высоту над заготовкой."
                                               FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="24,2,0,10"
                                               Visibility="{Binding IsOperatorMode, Converter={StaticResource BoolToVis}}" />

                                    <TextBox Text="{Binding SafeZHeightRaw, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding UseSafeZApproach}"
                                             MaxLength="6"
                                             core:NumericInputBehavior.IsDecimal="True"
                                             materialDesign:HintAssist.Hint="Безопасная высота Z (мм)"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                </StackPanel>
                            </Border>

                            <!-- Подача СОЖ / обдув -->
                            <ComboBox ItemsSource="{Binding CoolantOptions}"
                                      SelectedItem="{Binding SelectedCoolantOption}"
                                      materialDesign:HintAssist.Hint="Охлаждение / обдув зоны резания"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <!-- ПРАВАЯ КОЛОНКА: РЕЗУЛЬТАТ И ПОЯСНЕНИЯ -->
                <StackPanel Grid.Column="2">
                    <!-- Блок 6: Предупреждения и ошибки -->
                    <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding WarningMessage}" Foreground="#E65100" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="12.5" TextWrapping="Wrap" Margin="2,0,0,12"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <!-- Блок 7: Сгенерированный G-код и кнопка копирования -->
                    <materialDesign:Card Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Сгенерированный G-код (Фрезерный ЧПУ)"
                                            FontSize="16" FontWeight="Bold" Foreground="#263238" VerticalAlignment="Center" />

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Скопировано!"
                                               Foreground="#2E7D32"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Visibility="{Binding IsCopySuccessVisible, Converter={StaticResource BoolToVis}}" />

                                    <Button Command="{Binding CopyGCodeCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Height="32" Padding="12,0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Копировать" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Background="#263238" CornerRadius="6" Padding="14,12">
                                <TextBox Text="{Binding GeneratedGCode, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#ECEFF1"
                                         FontFamily="Consolas"
                                         FontSize="14"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="170" />
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Блок 8: Построчный разбор программы -->
                    <materialDesign:Card Padding="18">
                        <StackPanel>
                            <TextBlock Text="Построчный разбор программы"
                                        FontSize="16" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,4" />
                            <TextBlock Text="Что делает каждый кадр на реальном фрезерном обрабатывающем центре:"
                                        FontSize="12" Foreground="#546E7A" Margin="0,0,0,12" />

                            <ItemsControl ItemsSource="{Binding LineExplanations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Code}"
                                                           FontFamily="Consolas"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#1565C0"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Description}"
                                                           FontSize="12"
                                                           Foreground="#37474F"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
