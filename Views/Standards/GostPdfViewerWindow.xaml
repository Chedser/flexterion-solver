<Window x:Class="MechCore.Views.Standards.GostPdfViewerWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
         Title="Просмотр стандарта — MechCore"
         Height="680" Width="960"
         MinHeight="450" MinWidth="650"
         WindowStartupLocation="CenterScreen"
         Background="#ECEFF1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления просмотрщиком -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="14,8">
            <DockPanel LastChildFill="False">

                <!-- Название ГОСТа слева -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="FilePdfBox" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="HeaderTitleText"
                               Text="Просмотр документа ГОСТ"
                               FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="PageCountText"
                               Text=""
                               FontSize="12.5" Opacity="0.85" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- Кнопки масштаба и внешнего открытия справа -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button Click="OnZoomOutClicked"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="#88FFFFFF"
                            Width="32" Height="30" Padding="0" Margin="0,0,4,0" Cursor="Hand"
                            ToolTip="Уменьшить масштаб (Ctrl + Колесо мыши)">
                        <materialDesign:PackIcon Kind="MagnifyMinusOutline" Width="17" Height="17" />
                    </Button>

                    <Border Background="#28000000" CornerRadius="4" Padding="10,4" Margin="0,0,4,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ZoomLevelText" Text="100%" Foreground="White" FontWeight="Bold" FontSize="12.5" />
                    </Border>

                    <Button Click="OnZoomInClicked"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="#88FFFFFF"
                            Width="32" Height="30" Padding="0" Margin="0,0,4,0" Cursor="Hand"
                            ToolTip="Увеличить масштаб (Ctrl + Колесо мыши)">
                        <materialDesign:PackIcon Kind="MagnifyPlusOutline" Width="17" Height="17" />
                    </Button>

                    <Button Click="OnZoomResetClicked"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="#88FFFFFF"
                            Height="30" Padding="8,0" Margin="0,0,12,0" Cursor="Hand"
                            ToolTip="Сбросить масштаб до 100%">
                        <TextBlock Text="100%" FontSize="12" />
                    </Button>

                    <Button Click="OnOpenExternalClicked"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="#88FFFFFF"
                            Height="30" Padding="10,0" Cursor="Hand"
                            ToolTip="Открыть файл в системной программе">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="OpenInNew" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Внешний просмотр" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Индикатор загрузки страниц -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="36" Height="36" Margin="0,0,0,12" />
            <TextBlock Text="Загрузка и отрисовка страниц ГОСТа..." FontSize="14" Foreground="#37474F" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Область прокрутки отрендеренных страниц PDF -->
        <ScrollViewer x:Name="PagesScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      PreviewMouseWheel="OnScrollViewerPreviewMouseWheel"
                      Visibility="Collapsed">
            <ItemsControl x:Name="PagesItemsControl" HorizontalAlignment="Center" Margin="0,16">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform x:Name="PagesScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" Margin="0,0,0,16" Padding="0" CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" Color="#263238" />
                            </Border.Effect>
                            <Image Source="{Binding}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
