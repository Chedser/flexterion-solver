<UserControl x:Class="MechCore.Views.Materials.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MechCore.Controls"
             xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:core="clr-namespace:MechCore.Core">

    <UserControl.Resources>
        <core:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1050" Cursor="">

            <!-- ЗАГОЛОВОК МОДУЛЯ -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Материаловедение" FontSize="24" FontWeight="Bold" Foreground="#263238" />
                <TextBlock Text="Классификатор групп обрабатываемости по ISO 513"
                           FontSize="13" Foreground="#546E7A" Margin="0,4,0,0" />
            </StackPanel>

            <!-- КАРТОЧКА 1: КЛАССИФИКАТОР МАТЕРИАЛОВ ПО ISO 513 -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="1. Классификатор материалов по ISO 513 (P, M, K, N, S, H)" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                    <!-- 6 цветных кнопок групп ISO -->
                    <ItemsControl ItemsSource="{Binding IsoGroups}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectIsoGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,10,8" Padding="12,6" Height="38" Cursor="Hand"
                                        Background="{Binding BadgeColor}" BorderBrush="{Binding BadgeColor}" Foreground="White">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CodeLetter}" FontWeight="Bold" FontSize="15" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Карточка выбранной группы ISO -->
                    <Border Background="{Binding SelectedIsoGroup.BadgeBackground}"
                            BorderBrush="{Binding SelectedIsoGroup.BadgeColor}"
                            BorderThickness="1.5" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Цветной квадрат с буквой группы -->
                            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8"
                                    Background="{Binding SelectedIsoGroup.BadgeColor}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding SelectedIsoGroup.CodeLetter}" FontSize="28" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Характеристики и советы по резанию -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding SelectedIsoGroup.Name}" FontSize="16" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,6" />

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Коэффициент обрабатываемости Km: " FontSize="13" Foreground="#546E7A" />
                                    <TextBlock Text="{Binding SelectedIsoGroup.MachinabilityFactor, StringFormat='{}{0:0.00}'}" FontSize="13.5" FontWeight="Bold" Foreground="#263238" Margin="0,0,20,0" />

                                    <TextBlock Text="Базовая скорость резания Vc: " FontSize="13" Foreground="#546E7A" />
                                    <TextBlock Text="{Binding SelectedIsoGroup.RecommendedVcRange}" FontSize="13.5" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,20,0" />

                                    <TextBlock Text="СОЖ: " FontSize="13" Foreground="#546E7A" />
                                    <TextBlock Text="{Binding SelectedIsoGroup.CoolantAdvice}" FontSize="13.5" FontWeight="SemiBold" Foreground="#2E7D32" />
                                </WrapPanel>

                                <TextBlock Text="{Binding SelectedIsoGroup.ToolingTip}" FontSize="13" Foreground="#37474F" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- КАРТОЧКА 2: ГРАФИКИ ЗАВИСИМОСТЕЙ И АНАЛИЗ ОБРАБАТЫВАЕМОСТИ ПО ISO 513 -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Right"
                                 Background="#E3F2FD"
                                 BorderBrush="#90CAF9"
                                 BorderThickness="1"
                                 CornerRadius="6"
                                 Padding="12,5"
                                 VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Рабочая точка: " FontSize="12.5" Foreground="#1565C0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ChartValueBadge}" FontSize="14" FontWeight="Bold" Foreground="#0D47A1" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="4. Графики зависимостей обрабатываемости от твёрдости (ISO 513)"
                        FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Переключатель исследуемых параметров -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipPrimaryOutlineRadioButton}"
                          Content="Скорость резания Vc(HB)"
                          IsChecked="{Binding IsCuttingSpeedChart}"
                          Margin="0,0,8,4" />
                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipPrimaryOutlineRadioButton}"
                          Content="Удельная сила kc1.1(HB)"
                          IsChecked="{Binding IsCuttingForceChart}"
                          Margin="0,0,8,4" />
                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipPrimaryOutlineRadioButton}"
                          Content="Рекомендуемая подача f(HB)"
                          IsChecked="{Binding IsFeedChart}"
                          Margin="0,0,8,4" />
                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipPrimaryOutlineRadioButton}"
                          Content="Индекс обрабатываемости Km(%)"
                          IsChecked="{Binding IsMachinabilityChart}"
                          Margin="0,0,0,4" />
                    </WrapPanel>

                    <!-- Универсальный инженерный график -->
                    <controls:EngineeringChartControl MinHeight="290"
                                           ChartModel="{Binding MaterialChartModel}"
                                           IsEngineerMode="{Binding Main.IsEngineerMode}" />

                    <!-- Технологическая рекомендация под графиком -->
                    <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="6" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5E9" />
                                <Setter Property="BorderBrush" Value="#A5D6A7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChartHardnessCritical}" Value="True">
                                        <Setter Property="Background" Value="#FFF8E1" />
                                        <Setter Property="BorderBrush" Value="#FFE082" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding ChartRecommendedTool}" FontSize="13" FontWeight="Bold" Foreground="#263238" />
                            <TextBlock Text="{Binding ChartOperatorAdvice}" FontSize="12.5" Foreground="#37474F" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- КАРТОЧКА 3: ТАБЛИЦА И ПОИСК АНАЛОГОВ МАРОК СТАЛЕЙ И СПЛАВОВ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="2. Таблица аналогов марок (ГОСТ / DIN / AISI / GB)" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />

                        <CheckBox DockPanel.Dock="Right" Content="Только выбранная группа ISO"
                      IsChecked="{Binding FilterBySelectedGroup, Mode=TwoWay}"
                      FontSize="13" VerticalAlignment="Center" Cursor="Hand" />
                    </DockPanel>

                    <!-- Поле быстрого поиска -->
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                              materialDesign:HintAssist.Hint="Поиск марки (например: 40Х, 12Х18Н10Т, AISI 304, 42CrMo4, Д16Т, СЧ20...)"
                              Style="{StaticResource MaterialDesignOutlinedTextBox}"
                              FontSize="14" Padding="10,8" Margin="0,0,0,12" />
                    <!-- Таблица аналогов с горизонтальной и вертикальной прокруткой -->
                    <DataGrid ItemsSource="{Binding FilteredGrades}"
                              SelectedItem="{Binding SelectedGrade, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="280" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ISO" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsoBadgeColor}" CornerRadius="4" Width="26" Height="22" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding IsoCode}" Foreground="White" FontWeight="Bold" FontSize="12"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="ГОСТ (РФ)" Binding="{Binding GostGrade}" FontWeight="Bold" Width="125" />
                            <DataGridTextColumn Header="DIN / EN (Европа)" Binding="{Binding DinGrade}" Width="170" />
                            <DataGridTextColumn Header="AISI / ASTM (США)" Binding="{Binding AisiGrade}" Width="145" />
                            <DataGridTextColumn Header="GB (Китай)" Binding="{Binding GbGrade}" Width="120" />
                            <DataGridTextColumn Header="Твёрдость" Binding="{Binding TypicalHardness}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Блок отображения текста применения с переносом строк под таблицей -->
                    <Border Visibility="{Binding IsApplicationNoteVisible, Converter={StaticResource BoolToVis}}"
                                        Background="#F5F7F9" BorderBrush="#90CAF9" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,4">
                                            <Run Text="Применение — " />
                                            <Run Text="{Binding InspectedApplicationGrade.GostGrade, Mode=OneWay}" />
                                            <Run Text=" (" /><Run Text="{Binding InspectedApplicationGrade.TypicalHardness, Mode=OneWay}" /><Run Text="):" />
                                </TextBlock>
                                <TextBlock Text="{Binding InspectedApplicationGrade.ApplicationNote}"
                                            FontSize="13" Foreground="#263238" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="✕"
                                    Command="{Binding CloseApplicationCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="28" Height="28" Padding="0" VerticalAlignment="Top"
                                    ToolTip="Скрыть текст применения" Cursor="Hand" />
                        </Grid>
                    </Border>

                </StackPanel>
            </materialDesign:Card>
            
            <!-- КАРТОЧКА 4: КОНВЕРТЕР ТВЁРДОСТИ И ПРЕДЕЛА ПРОЧНОСТИ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="3. Конвертер твёрдости и предела прочности (ГОСТ 22761 / ISO 18265)" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                        <!-- Выбор исходной шкалы (HRC, HB, HV) -->
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Исходная шкала" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding HardnessScales}"
                          SelectedItem="{Binding SelectedHardnessScale, Mode=TwoWay}"
                          FontSize="16" FontWeight="Bold" Width="110" Padding="8,6" />
                        </StackPanel>

                        <!-- Поле ввода значения твёрдости -->
                        <StackPanel Margin="0,0,24,8">
                            <TextBlock Text="Значение твёрдости" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                            <TextBox Text="{Binding HardnessInputText, UpdateSourceTrigger=PropertyChanged}"
                                     core:NumericInputBehavior.IsDecimal="True"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     MaxLength="6" FontSize="18" FontWeight="Bold" Width="120" Padding="8,5" />
                        </StackPanel>

                        <!-- Плитка 1: Роквелл (HRC) -->
                        <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,12,8">
                            <StackPanel>
                                <TextBlock Text="Роквелл (HRC)" FontSize="11" Foreground="#1565C0" />
                                <TextBlock Text="{Binding HardnessResult.HrcText}" FontSize="16" FontWeight="Bold" Foreground="#0D47A1" />
                            </StackPanel>
                        </Border>

                        <!-- Плитка 2: Бринелль (HB) -->
                        <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,12,8">
                            <StackPanel>
                                <TextBlock Text="Бринелль (HB)" FontSize="11" Foreground="#2E7D32" />
                                <TextBlock Text="{Binding HardnessResult.HbText}" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" />
                            </StackPanel>
                        </Border>

                        <!-- Плитка 3: Виккерс (HV) -->
                        <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,12,8">
                            <StackPanel>
                                <TextBlock Text="Виккерс (HV)" FontSize="11" Foreground="#E65100" />
                                <TextBlock Text="{Binding HardnessResult.HvText}" FontSize="16" FontWeight="Bold" Foreground="#BF360C" />
                            </StackPanel>
                        </Border>

                        <!-- Плитка 4: Предел прочности -->
                        <Border Background="#F3E5F5" BorderBrush="#CE93D8" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Предел прочности σв" FontSize="11" Foreground="#6A1B9A" />
                                <TextBlock Text="{Binding HardnessResult.TensileStrengthText}" FontSize="16" FontWeight="Bold" Foreground="#4A148C" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Технологическая подсказка по обрабатываемости -->
                    <Border Background="#ECEFF1" CornerRadius="6" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#455A64" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding HardnessResult.MachinabilityNote}" FontSize="13" FontWeight="Medium" Foreground="#263238" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>
           
        </StackPanel>
    </ScrollViewer>
</UserControl>
