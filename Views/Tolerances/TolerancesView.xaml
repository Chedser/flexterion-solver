<UserControl x:Class="MechCore.Views.Tolerances.TolerancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MechCore.Controls"
             xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:core="clr-namespace:MechCore.Core">

    <UserControl.Resources>
        <core:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- Явный стиль для элементов списка букв -->
        <Style x:Key="LetterComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}">
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">

            <!-- ЗАГОЛОВОК РАЗДЕЛА -->
            <TextBlock Text="Допуски и посадки (ГОСТ 25347 / ISO 286)" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

            <!-- БЛОК ПРЕДУПРЕЖДЕНИЯ И ОШИБОК -->
            <Border Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#C62828" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ЖЁЛТАЯ ИНФОРМАЦИОННАЯ ПЛАШКА ДЛЯ РАЗМЕРОВ СВЫШЕ 500 ММ -->
            <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LargeSizeWarning}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="#EF6C00" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding LargeSizeWarning}" Foreground="#E65100" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- НАЧАЛО РЕЖИМА "НАЛАДКА" -->
            <StackPanel Visibility="{Binding Main.IsOperatorMode, Converter={StaticResource BoolToVis}}">

                <!-- Карточка 1: Параметры детали -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="1. Параметры обрабатываемой поверхности" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,24,8">
                                <TextBlock Text="Номинальный диаметр D, мм" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />

                                <!-- Поле ввода и значок таблицы в одну строку -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding NominalSizeText, UpdateSourceTrigger=PropertyChanged}" 
                                            core:NumericInputBehavior.IsDecimal="True"
                                            materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                            MaxLength="10"
                                            FontSize="20" FontWeight="Bold" Width="125" Padding="8,6" />

                                    <controls:NumberPickerButton SelectedValue="{Binding NominalSizeText, Mode=TwoWay}" 
                                     VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="Допустимо: свыше 0 до 3150 мм" FontSize="11" Opacity="0.6" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Текстовое отображение типа элемента (без радиокнопок) -->
                            <StackPanel Margin="0,0,24,8">
                                <TextBlock Text="Тип элемента" FontSize="12" Opacity="0.7" Margin="0,0,0,6" />
                                <Border Background="#ECEFF1" CornerRadius="6" Padding="12,6">
                                    <TextBlock Text="{Binding SetupElementTypeText}" 
                                               FontSize="16" FontWeight="Bold" Foreground="#263238" />
                                </Border>
                            </StackPanel>

                            <!-- Выбор для Вала -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSetupShaft, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Буква вала" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ShaftLetters}" SelectedItem="{Binding SelectedShaftLetter}" DisplayMemberPath="Letter" ItemContainerStyle="{StaticResource LetterComboBoxItemStyle}" FontSize="18" Width="85" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Квалитет" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedShaftGrade}" FontSize="18" Width="85" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Выбор для Отверстия -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSetupShaft, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Буква отверстия" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding HoleLetters}" SelectedItem="{Binding SelectedHoleLetter}" DisplayMemberPath="Letter" ItemContainerStyle="{StaticResource LetterComboBoxItemStyle}" FontSize="18" Width="85" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Квалитет" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedHoleGrade}" FontSize="18" Width="85" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="Быстрый выбор поля допуска:" FontSize="12" Opacity="0.7" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding QuickPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" 
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,8,8" Padding="14,6" FontSize="14" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Карточка 2: Главные цифры для стойки ЧПУ -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="2. Размеры для настройки станка и контроля" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Минимум -->
                            <Border Grid.Column="0" Background="#F5F7F9" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="МИНИМУМ (Нижний предел)" FontSize="11" FontWeight="Bold" Opacity="0.6" />
                                    <TextBlock Text="{Binding ActiveSetupResult.MinSize, StringFormat={}{0:0.0000} мм, TargetNullValue='—'}" FontSize="22" FontWeight="Bold" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding ActiveSetupResult.LowerDeviation, StringFormat=Откл: {0:+0.0000;-0.0000;0.0000}, TargetNullValue='Откл: —'}" FontSize="13" Opacity="0.8" />
                                </StackPanel>
                            </Border>

                            <!-- СЕРЕДИНА ПОЛЯ ДОПУСКА (Выделенная карточка) -->
                            <Border Grid.Column="1" Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="2" CornerRadius="8" Padding="16" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="НАСТРОЕЧНЫЙ (Середина)" FontSize="11" FontWeight="Bold" Foreground="#E65100" />
                                    <TextBlock Text="{Binding ActiveSetupResult.MeanSize, StringFormat={}{0:0.0000} мм, TargetNullValue='—'}" FontSize="26" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding ActiveSetupResult.MeanDeviation, StringFormat=Ср. откл: {0:+0.0000;-0.0000;0.0000}, TargetNullValue='Ср. откл: —'}" FontSize="13" FontWeight="Medium" />
                                </StackPanel>
                            </Border>

                            <!-- Максимум -->
                            <Border Grid.Column="2" Background="#F5F7F9" CornerRadius="8" Padding="16" Margin="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="МАКСИМУМ (Верхний предел)" FontSize="11" FontWeight="Bold" Opacity="0.6" />
                                    <TextBlock Text="{Binding ActiveSetupResult.MaxSize, StringFormat={}{0:0.0000} мм, TargetNullValue='—'}" FontSize="22" FontWeight="Bold" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding ActiveSetupResult.UpperDeviation, StringFormat=Откл: {0:+0.0000;-0.0000;0.0000}, TargetNullValue='Откл: —'}" FontSize="13" Opacity="0.8" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Карточка 3: Калькулятор коррекции по факту замера -->
                <materialDesign:Card Padding="20">
                    <StackPanel>
                        <TextBlock Text="3. Расчёт корректора по фактическому замеру" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                        <DockPanel LastChildFill="True">
                            <!-- Левая часть: поле ввода замера -->
                            <StackPanel DockPanel.Dock="Left" Margin="0,0,24,0">
                                <TextBlock Text="Показание микрометра (мм):" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MeasuredSizeText, UpdateSourceTrigger=PropertyChanged}" 
                                                core:NumericInputBehavior.IsDecimal="True"
                                                materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                MaxLength="10"
                                                Width="150" FontSize="20" FontWeight="Bold" Padding="8,6" />
                            </StackPanel>

                            <!-- Правая часть: развёрнутый вердикт и инструкция для стойки ЧПУ -->
                            <Border Background="#F5F7F9" CornerRadius="8" Padding="14,10" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="{Binding MeasurementStatusTitle}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#263238" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMeasurementScrap}" Value="True">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding MeasurementDetails}" FontSize="13.5" LineHeight="19" Foreground="#37474F" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ГРАФИЧЕСКАЯ СХЕМА ДЛЯ НАЛАДЧИКА -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <materialDesign:Card.Style>
                        <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SetupChart}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:Card.Style>

                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Графическая схема поля допуска и замера" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0" />

                            <!-- Легенда справа -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Border Width="14" Height="10" Background="#CFD8DC" BorderBrush="#455A64" BorderThickness="0,1.5,0,0" Margin="0,0,4,0" />
                                <TextBlock Text="Номинал" FontSize="11" Opacity="0.7" Margin="0,0,12,0" />

                                <Border Width="14" Height="10" Background="#40FFB300" BorderBrush="#FFB300" BorderThickness="1" Margin="0,0,4,0" />
                                <TextBlock Text="Допуск" FontSize="11" Opacity="0.7" Margin="0,0,12,0" />

                                <Line X1="0" Y1="5" X2="14" Y2="5" Stroke="#E65100" StrokeThickness="2" StrokeDashArray="2 2" Margin="0,0,4,0" />
                                <TextBlock Text="Середина" FontSize="11" Opacity="0.7" Margin="0,0,12,0" />

                                <Line X1="0" Y1="5" X2="14" Y2="5" Stroke="#2E7D32" StrokeThickness="2.5" Margin="0,0,4,0" />
                                <TextBlock Text="Замер" FontSize="11" Opacity="0.7" />
                            </StackPanel>
                        </DockPanel>

                        <!-- ОБЛАСТЬ ЧЕРТЕЖА -->
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Height="210" ClipToBounds="True" Background="#FAFAFA">
                            <Grid>
                                <!-- СЛОЙ 1: Тело металла относительно номинала (внизу для Вала, вверху для Отверстия) -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding SetupChart.AboveNominalHeight}" />
                                        <RowDefinition Height="{Binding SetupChart.BelowNominalHeight}" />
                                    </Grid.RowDefinitions>

                                    <!-- ВАЛ: закрашена нижняя область, подпись под линией номинала -->
                                    <Border Grid.Row="1" Background="#DCE4E8" BorderBrush="#37474F" BorderThickness="0,2,0,0"
                                            Visibility="{Binding SetupChart.IsShaft, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding SetupChart.NominalLabel}" 
                                                    FontSize="11" FontWeight="Bold" Foreground="#263238"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,4,0,0" />
                                    </Border>

                                    <!-- ОТВЕРСТИЕ: закрашена верхняя область, подпись над линией номинала -->
                                    <Border Grid.Row="0" Background="#DCE4E8" BorderBrush="#37474F" BorderThickness="0,0,0,2"
                                             Visibility="{Binding SetupChart.IsShaft, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                        <TextBlock Text="{Binding SetupChart.NominalLabel}" 
                                            FontSize="11" FontWeight="Bold" Foreground="#263238"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,4" />
                                    </Border>
                                </Grid>


                                <!-- СЛОЙ 2: Зона поля допуска (от Min до Max) -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding SetupChart.AboveToleranceHeight}" />
                                        <RowDefinition Height="{Binding SetupChart.ToleranceZoneHeight}" />
                                        <RowDefinition Height="{Binding SetupChart.BelowToleranceHeight}" />
                                    </Grid.RowDefinitions>

                                    <!-- Подпись MAX над верхней границей допуска -->
                                    <TextBlock Grid.Row="0" Text="{Binding SetupChart.MaxLabel}"
                               FontSize="11" FontWeight="SemiBold" Foreground="#455A64"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />

                                    <!-- Прямоугольник поля допуска -->
                                    <Border Grid.Row="1" Margin="140,0" Background="#45FFB300" BorderBrush="#546E7A" BorderThickness="1,1.5,1,1.5" />

                                    <!-- Подпись MIN под нижней границей допуска -->
                                    <TextBlock Grid.Row="2" Text="{Binding SetupChart.MinLabel}"
                               FontSize="11" FontWeight="SemiBold" Foreground="#455A64"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                                </Grid>

                                <!-- СЛОЙ 3: Настроечная линия (середина поля допуска) -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding SetupChart.AboveMeanHeight}" />
                                        <RowDefinition Height="{Binding SetupChart.BelowMeanHeight}" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="1" VerticalAlignment="Top">
                                        <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#E65100" StrokeThickness="2" StrokeDashArray="4 3" />
                                        <Border Background="#FFF8E1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right" Margin="0,-10,10,0">
                                            <TextBlock Text="{Binding SetupChart.MeanLabel}" FontSize="11" FontWeight="Bold" Foreground="#E65100" />
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- СЛОЙ 4: Линия фактического размера (Зелёная = годен, Оранжевая = припуск, Красная = брак) -->
                                <Grid Visibility="{Binding SetupChart.HasMeasuredLine, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding SetupChart.AboveMeasuredHeight}" />
                                        <RowDefinition Height="{Binding SetupChart.BelowMeasuredHeight}" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="1" VerticalAlignment="Top">
                                        <Rectangle Height="2.5">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="#C62828" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SetupChart.IsMeasuredInTolerance}" Value="True">
                                                            <Setter Property="Fill" Value="#2E7D32" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SetupChart.IsMeasuredReworkable}" Value="True">
                                                            <Setter Property="Fill" Value="#EF6C00" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>

                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="10,-12,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFEBEE" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SetupChart.IsMeasuredInTolerance}" Value="True">
                                                            <Setter Property="Background" Value="#E8F5E9" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SetupChart.IsMeasuredReworkable}" Value="True">
                                                            <Setter Property="Background" Value="#FFF3E0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SetupChart.MeasuredLabel}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SetupChart.IsMeasuredInTolerance}" Value="True">
                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SetupChart.IsMeasuredReworkable}" Value="True">
                                                                <Setter Property="Foreground" Value="#EF6C00" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
            <!-- КОНЕЦ РЕЖИМА "НАЛАДКА" -->

            <!-- НАЧАЛО РЕЖИМА "ИНЖЕНЕР" (КОНСТРУКТОР / ТЕХНОЛОГ) -->
            <StackPanel Visibility="{Binding Main.IsEngineerMode, Converter={StaticResource BoolToVis}}">

                <!-- ПОДСКАЗКА О РАЗНИЦЕ КВАЛИТЕТОВ (> 2 ступеней) -->
                <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GradeDifferenceWarning}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LightbulbOutline" Foreground="#EF6C00" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding GradeDifferenceWarning}" Foreground="#E65100" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Карточка 1: Выбор параметров сопряжения -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Выбор параметров сопряжения (Посадка)" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,24,8">
                                <TextBlock Text="Номинальный диаметр D, мм" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />

                                <!-- Поле ввода и значок таблицы в одну строку -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding NominalSizeText, UpdateSourceTrigger=PropertyChanged}" 
                                                    core:NumericInputBehavior.IsDecimal="True"
                                                    materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                    MaxLength="10"
                                                    FontSize="18" FontWeight="Bold" Width="120" />

                                    <controls:NumberPickerButton SelectedValue="{Binding NominalSizeText, Mode=TwoWay}" 
                                     VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="Допустимо: свыше 0 до 3150 мм" FontSize="11" Opacity="0.6" Margin="0,4,0,0" />
                            </StackPanel>


                            <Border Background="#E3F2FD" CornerRadius="6" Padding="12,8" Margin="0,0,16,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Отверстие:" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox ItemsSource="{Binding HoleLetters}" SelectedItem="{Binding SelectedHoleLetter}" DisplayMemberPath="Letter" ItemContainerStyle="{StaticResource LetterComboBoxItemStyle}" FontSize="16" Width="75" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedHoleGrade}" FontSize="16" Width="70" />
                                </StackPanel>
                            </Border>

                            <Border Background="#FCE4EC" CornerRadius="6" Padding="12,8" Margin="0,0,16,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Вал:" FontWeight="Bold" Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox ItemsSource="{Binding ShaftLetters}" SelectedItem="{Binding SelectedShaftLetter}" DisplayMemberPath="Letter" ItemContainerStyle="{StaticResource LetterComboBoxItemStyle}" FontSize="16" Width="75" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedShaftGrade}" FontSize="16" Width="70" />
                                </StackPanel>
                            </Border>

                            <!-- БЫСТРЫЙ ВЫБОР ТИПОВЫХ ПОСАДОК ПО РАЗДЕЛАМ -->
                            <StackPanel Margin="0,14,0,0">

                                <!-- 1. С ЗАЗОРОМ -->
                                <TextBlock Text="С зазором:" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ClearanceFits}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayText}"
                                                    Command="{Binding DataContext.ApplyFitPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Fit}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    BorderBrush="#A5D6A7" Foreground="#1B5E20"
                                                    Margin="0,0,8,6" Padding="10,4" Height="30" FontSize="12.5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 2. ПЕРЕХОДНЫЕ -->
                                <TextBlock Text="Переходные:" FontSize="12" FontWeight="Bold" Foreground="#EF6C00" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding TransitionFits}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayText}"
                                                    Command="{Binding DataContext.ApplyFitPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Fit}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    BorderBrush="#FFCC80" Foreground="#E65100"
                                                    Margin="0,0,8,6" Padding="10,4" Height="30" FontSize="12.5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 3. С НАТЯГОМ -->
                                <TextBlock Text="С натягом:" FontSize="12" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding InterferenceFits}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayText}"
                                                    Command="{Binding DataContext.ApplyFitPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Fit}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    BorderBrush="#EF9A9A" Foreground="#B71C1C"
                                                    Margin="0,0,8,6" Padding="10,4" Height="30" FontSize="12.5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </WrapPanel>
                        
                        <!-- ПЕРЕКЛЮЧАТЕЛЬ СИСТЕМЫ ОТВЕРСТИЯ / СИСТЕМЫ ВАЛА -->
                        <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="Система образования посадок:" FontSize="13" FontWeight="SemiBold" Foreground="#455A64" VerticalAlignment="Top" Margin="0,2,20,0" />

                                <!-- Подпись слева: Система отверстия -->
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Система отверстия (H)" FontSize="14" Cursor="Hand">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#263238" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsShaftSystem}" Value="True">
                                                        <Setter Property="Foreground" Value="#78909C" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="(рекомендуется)" 
                                               FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Круглый слайдер без галочки -->
                                <ToggleButton IsChecked="{Binding IsShaftSystem, Mode=TwoWay}"
                                              VerticalAlignment="Top"
                                              Margin="0,1,0,0"
                                              Cursor="Hand"
                                              Width="44" Height="22">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <!-- По умолчанию (слева — Система отверстия): фон синий -->
                                            <Border x:Name="Track" Background="#1565C0" CornerRadius="11" Padding="2">
                                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Когда включена Система вала (справа): бегунок вправо, фон серый -->
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="Track" Property="Background" Value="#B0BEC5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- Подпись справа: Система вала -->
                                <TextBlock Text="Система вала (h)" FontSize="14" VerticalAlignment="Top" Margin="12,0,0,0" Cursor="Hand">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#78909C" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShaftSystem}" Value="True">
                                                    <Setter Property="Foreground" Value="#1565C0" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Карточка 2: Подробная таблица расчёта посадки -->
                <materialDesign:Card Padding="20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="Результаты расчёта посадки" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Background="#ECEFF1" CornerRadius="4" Padding="12,6">
                                <TextBlock Text="{Binding FitResult.FitTypeDisplayName, TargetNullValue='—'}" FontSize="15" FontWeight="Bold" Foreground="#263238" />
                            </Border>
                        </DockPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Колонка Отверстия -->
                            <Border Grid.Column="0" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding HoleResult.ToleranceClass, StringFormat=Отверстие {0}}" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding HoleResult.UpperDeviation, StringFormat=Верхнее отклонение (ES): {0:+0.0000;-0.0000;0.0000} мм}" Margin="0,2" />
                                    <TextBlock Text="{Binding HoleResult.LowerDeviation, StringFormat=Нижнее отклонение (EI): {0:+0.0000;-0.0000;0.0000} мм}" Margin="0,2" />
                                    <TextBlock Text="{Binding HoleResult.ToleranceValue, StringFormat=Допуск (TD): {0:0.0000} мм}" FontWeight="Bold" Margin="0,4,0,6" />
                                    <Separator />
                                    <TextBlock Text="{Binding HoleResult.MaxSize, StringFormat=Наибольший размер (Dmax): {0:0.0000} мм}" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding HoleResult.MinSize, StringFormat=Наименьший размер (Dmin): {0:0.0000} мм}" Margin="0,2" />
                                </StackPanel>
                            </Border>

                            <!-- Колонка Вала -->
                            <Border Grid.Column="1" BorderBrush="#F8BBD0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ShaftResult.ToleranceClass, StringFormat=Вал {0}}" FontSize="16" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ShaftResult.UpperDeviation, StringFormat=Верхнее отклонение (es): {0:+0.0000;-0.0000;0.0000} мм}" Margin="0,2" />
                                    <TextBlock Text="{Binding ShaftResult.LowerDeviation, StringFormat=Нижнее отклонение (ei): {0:+0.0000;-0.0000;0.0000} мм}" Margin="0,2" />
                                    <TextBlock Text="{Binding ShaftResult.ToleranceValue, StringFormat=Допуск (Td): {0:0.0000} мм}" FontWeight="Bold" Margin="0,4,0,6" />
                                    <Separator />
                                    <TextBlock Text="{Binding ShaftResult.MaxSize, StringFormat=Наибольший размер (dmax): {0:0.0000} мм}" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding ShaftResult.MinSize, StringFormat=Наименьший размер (dmin): {0:0.0000} мм}" Margin="0,2" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#F5F5F5" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Предельные характеристики сопряжения:" FontWeight="Bold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding FitResult.MaxClearance, StringFormat=Smax (ES − ei): {0:+0.0000;-0.0000;0.0000} мм}" Margin="0,2" />
                                <TextBlock Text="{Binding FitResult.MinClearance, StringFormat=Smin (EI − es): {0:+0.0000;-0.0000;0.0000} мм}" Margin="0,2" />
                                <TextBlock Text="{Binding FitResult.MaxInterference, StringFormat=Nmax (es − EI): {0:+0.0000;-0.0000;0.0000} мм}" Margin="0,2" />
                                <TextBlock Text="{Binding FitChart.MeanFitSummary, TargetNullValue='Средний (вероятностный) зазор / натяг: —'}"  Margin="0,2"  />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- ГРАФИЧЕСКАЯ СХЕМА ПОСАДКИ (РЕЖИМ ИНЖЕНЕР) -->
                <materialDesign:Card Padding="20" Margin="0,16,0,0">
                    <materialDesign:Card.Style>
                        <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FitChart}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:Card.Style>

                    <StackPanel>
                        <!-- Заголовок, легенда и чекбокс под легендой -->
                        <StackPanel Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock Text="Схема расположения полей допусков" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Border Width="14" Height="10" Background="#BBDEFB" BorderBrush="#1565C0" BorderThickness="1" Margin="0,0,4,0" />
                                    <TextBlock Text="Отверстие" FontSize="11" Opacity="0.7" Margin="0,0,12,0" />

                                    <Border Width="14" Height="10" Background="#FFCDD2" BorderBrush="#C62828" BorderThickness="1" Margin="0,0,4,0" />
                                    <TextBlock Text="Вал" FontSize="11" Opacity="0.7" Margin="0,0,12,0" />

                                    <Line X1="0" Y1="5" X2="14" Y2="5" Stroke="#37474F" StrokeThickness="2" Margin="0,0,4,0" />
                                    <TextBlock Text="Нулевая линия" FontSize="11" Opacity="0.7" />

                                    <!-- Элемент легенды появляется только при включении чекбокса -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowExtraFitInfo, Converter={StaticResource BoolToVis}}" Margin="12,0,0,0">
                                        <Line X1="0" Y1="5" X2="14" Y2="5" Stroke="#E65100" StrokeThickness="2" StrokeDashArray="2 2" Margin="0,0,4,0" />
                                        <TextBlock Text="Середина допуска" FontSize="11" Opacity="0.7" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- Чекбоксы настроек схемы под легендой -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox Content="Дополнительная информация"
                                          IsChecked="{Binding ShowExtraFitInfo, Mode=TwoWay}"
                                          FontSize="13" Cursor="Hand" Margin="0,0,24,0" />

                                <CheckBox Content="Предельные размеры (Ø)"
                                          IsChecked="{Binding ShowNominalSizesOnChart, Mode=TwoWay}"
                                          FontSize="13" Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ОБЛАСТЬ ЧЕРТЕЖА -->
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Height="230" ClipToBounds="True" Background="#FAFAFA">
                            <Grid>
                                <!-- СЛОЙ 1: Нулевая линия (0.000) -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding FitChart.AboveZeroHeight}" />
                                        <RowDefinition Height="{Binding FitChart.BelowZeroHeight}" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="1" BorderBrush="#37474F" BorderThickness="0,2,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding FitChart.ZeroLabel}"
                                   FontSize="11" FontWeight="Bold" Foreground="#263238"
                                   HorizontalAlignment="Left" Margin="12,3,0,0" />
                                    </Border>
                                </Grid>

                                <!-- СЛОЙ 2: Колонки для Отверстия (слева) и Вала (справа) -->
                                <Grid Margin="130,0,30,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ЛЕВАЯ КОЛОНКА: ПОЛЕ ДОПУСКА ОТВЕРСТИЯ (СИНЕЕ) -->
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding FitChart.AboveHoleHeight}" />
                                            <RowDefinition Height="{Binding FitChart.HoleZoneHeight}" />
                                            <RowDefinition Height="{Binding FitChart.BelowHoleHeight}" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding FitChart.HoleUpperLabel}"
                                                    FontSize="11" FontWeight="Bold" Foreground="#1565C0"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />

                                        <Border Grid.Row="1" Background="#CCBBDEFB" BorderBrush="#1565C0" BorderThickness="1.5" CornerRadius="2">
                                            <TextBlock Text="{Binding FitChart.HoleClassLabel}"
                                       FontSize="12" FontWeight="Bold" Foreground="#0D47A1"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Row="2" Text="{Binding FitChart.HoleLowerLabel}"
                                   FontSize="11" FontWeight="Bold" Foreground="#1565C0"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    </Grid>

                                    <!-- ПРАВАЯ КОЛОНКА: ПОЛЕ ДОПУСКА ВАЛА (КРАСНОЕ) -->
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding FitChart.AboveShaftHeight}" />
                                            <RowDefinition Height="{Binding FitChart.ShaftZoneHeight}" />
                                            <RowDefinition Height="{Binding FitChart.BelowShaftHeight}" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding FitChart.ShaftUpperLabel}"
                                   FontSize="11" FontWeight="Bold" Foreground="#C62828"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />

                                        <Border Grid.Row="1" Background="#CCFFCDD2" BorderBrush="#C62828" BorderThickness="1.5" CornerRadius="2">
                                            <TextBlock Text="{Binding FitChart.ShaftClassLabel}"
                                       FontSize="12" FontWeight="Bold" Foreground="#B71C1C"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Row="2" Text="{Binding FitChart.ShaftLowerLabel}"
                                   FontSize="11" FontWeight="Bold" Foreground="#C62828"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    </Grid>
                                </Grid>

                                <!-- СЛОЙ 3: Сквозные линии середин (Em, em) и закрашенная зона между ними -->
                                <Grid Margin="115,0,15,0" Visibility="{Binding ShowExtraFitInfo, Converter={StaticResource BoolToVis}}" Cursor="">

                                    <!-- 1. Закрашенная область между линиями Em и em (средний зазор / натяг) -->
                                    <Grid Margin="15,0,15,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding FitChart.AboveMeanZoneHeight}" />
                                            <RowDefinition Height="{Binding FitChart.MeanZoneHeight}" />
                                            <RowDefinition Height="{Binding FitChart.BelowMeanZoneHeight}" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="1" Background="#38FFB300" />
                                    </Grid>

                                    <!-- 2. Сквозная линия середины отверстия (Em) -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding FitChart.AboveHoleMeanHeight}" />
                                            <RowDefinition Height="{Binding FitChart.BelowHoleMeanHeight}" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="1" VerticalAlignment="Top">
                                            <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#E65100" StrokeThickness="1.8" StrokeDashArray="4 2" />
                                            <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left" Margin="0,-10,0,0">
                                                <TextBlock Text="{Binding FitChart.HoleMeanLabel}" FontSize="10.5" FontWeight="Bold" Foreground="#E65100" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- 3. Сквозная линия середины вала (em) -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding FitChart.AboveShaftMeanHeight}" />
                                            <RowDefinition Height="{Binding FitChart.BelowShaftMeanHeight}" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="1" VerticalAlignment="Top">
                                            <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#E65100" StrokeThickness="1.8" StrokeDashArray="4 2" />
                                            <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right" Margin="0,-10,0,0">
                                                <TextBlock Text="{Binding FitChart.ShaftMeanLabel}" FontSize="10.5" FontWeight="Bold" Foreground="#E65100" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Сводная плашка среднего зазора/натяга (появляется при включении чекбокса) -->
                        <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                                Visibility="{Binding ShowExtraFitInfo, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FunctionVariant" Foreground="#EF6C00" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding FitChart.MeanFitSummary}" FontSize="13.5" FontWeight="SemiBold" Foreground="#E65100" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
            <!-- КОНЕЦ РЕЖИМА "ИНЖЕНЕР" -->

        </StackPanel>
    </ScrollViewer>
</UserControl>
