<UserControl x:Class="MechCore.Views.Threads.ThreadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MechCore.Controls"
             xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:core="clr-namespace:MechCore.Core">

    <UserControl.Resources>
        <core:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1050">

            <!-- ЗАГОЛОВОК МОДУЛЯ -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Справочник резьб и расчёт параметров" FontSize="24" FontWeight="Bold" Foreground="#263238" />
                    <TextBlock Text="{Binding SelectedThreadType.Standard, StringFormat=Действующий стандарт: {0}}"
                               FontSize="13" Foreground="#546E7A" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- КАРТОЧКА 1: ВЫБОР ТИПА И РАЗМЕРА РЕЗЬБЫ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="1. Выбор типа и размера резьбы" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

                    <!-- Кнопки быстрого выбора стандарта резьбы -->
                    <TextBlock Text="Стандарт резьбы:" FontSize="12" Opacity="0.7" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding ThreadTypes}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Command="{Binding DataContext.SelectThreadTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        BorderBrush="#B0BEC5" Foreground="#37474F"
                                        Margin="0,0,8,8" Padding="14,6" Height="34" FontSize="13.5" Cursor="Hand" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Параметры резьбы: Размер, Шаг и Наружная/Внутренняя -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">

                        <!-- Выпадающий список: Обозначение размера -->
                        <StackPanel Margin="0,0,24,10">
                            <TextBlock Text="Размер резьбы" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableSizes}"
                                      SelectedItem="{Binding SelectedSize, Mode=TwoWay}"
                                      FontSize="17" FontWeight="Bold" Width="160" Padding="8,6" />
                        </StackPanel>

                        <!-- Выпадающий список: Шаг P / число ниток -->
                        <StackPanel Margin="0,0,28,10">
                            <TextBlock Text="Шаг P / ряд" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailablePitches}"
                                      SelectedItem="{Binding SelectedSpec, Mode=TwoWay}"
                                      DisplayMemberPath="FullDesignation"
                                      FontSize="15" FontWeight="SemiBold" MinWidth="260" Padding="8,7" />
                        </StackPanel>

                        <!-- Переключатель: Наружная / Внутренняя резьба -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Тип поверхности" FontSize="12" Opacity="0.7" Margin="0,0,0,6" />
                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Наружная (вал)" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="#263238" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInternalThread}" Value="True">
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="Foreground" Value="#78909C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ToggleButton IsChecked="{Binding IsInternalThread, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Cursor="Hand" Width="44" Height="22">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Track" Background="#1565C0" CornerRadius="11" Padding="2">
                                                    <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                                        <Setter TargetName="Track" Property="Background" Value="#2E7D32" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <TextBlock Text="Внутренняя (отверстие)" FontSize="13.5" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="Foreground" Value="#78909C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInternalThread}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </WrapPanel>

                    <!-- Учёт материала заготовки (опционально) -->
                    <Border Background="#F5F7F8" CornerRadius="6" Padding="10,8" Margin="0,4,0,8">
                        <CheckBox Content="Учитывать материал заготовки (коррекция сверла под вязкость и числа проходов G76)"
                                  IsChecked="{Binding ConsiderThreadMaterial, Mode=TwoWay}"
                                  FontSize="12.5" Cursor="Hand" />
                    </Border>

                    <!-- Выбор группы ISO 513 и конкретной марки (видим при включённом чекбоксе) -->
                    <StackPanel Visibility="{Binding ConsiderThreadMaterial, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,8">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>

                            <!-- 6 цветных кнопок групп ISO -->
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding IsoGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectThreadIsoGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{Binding BadgeColor}"
                                                BorderBrush="{Binding BadgeColor}"
                                                Foreground="White"
                                                Width="36" Height="34" Margin="0,0,4,0" Padding="0"
                                                FontSize="13.5" FontWeight="Bold" Cursor="Hand"
                                                ToolTip="{Binding Name}">
                                            <TextBlock Text="{Binding CodeLetter}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Бейдж выбранной группы ISO -->
                            <Border Grid.Column="2"
                                    Background="{Binding SelectedThreadIsoGroup.BadgeBackground}"
                                    BorderBrush="{Binding SelectedThreadIsoGroup.BadgeColor}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding SelectedThreadIsoGroup.BadgeColor}" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SelectedThreadIsoGroup.CodeLetter}" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedThreadIsoGroup.Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Выпадающий список марок выбранной группы ISO -->
                            <Grid Grid.Column="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding FilteredThreadGrades}"
                                          SelectedItem="{Binding SelectedThreadMaterial}"
                                          materialDesign:HintAssist.Hint="Марка (необязательно)"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Padding="10,6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding GostGrade}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding DinGrade, StringFormat='({0})'}" Foreground="#78909C" FontSize="11.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="1"
                                        Content="✕"
                                        Command="{Binding ClearThreadGradeCommand}"
                                        Visibility="{Binding HasSelectedThreadMaterial, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Width="34" Height="34" Padding="0" Margin="6,0,0,0"
                                        ToolTip="Сбросить выбор марки"
                                        Cursor="Hand" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- Краткая сводная строка по выбранному стандарту -->
                    <Border Background="#ECEFF1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Выбрано: " FontSize="13.5" Foreground="#546E7A" />
                            <TextBlock Text="{Binding SelectedSpec.FullDesignation}" FontSize="13.5" FontWeight="Bold" Foreground="#263238" />

                            <TextBlock Text="  |  Наружный (d / D): " FontSize="13.5" Foreground="#546E7A" />
                            <TextBlock Text="{Binding SelectedSpec.NominalDiameter, StringFormat={}{0:0.###} мм}" FontSize="13.5" FontWeight="Bold" Foreground="#1565C0" />

                            <TextBlock Text="  |  Внутренний базовый (d₁ / D₁): " FontSize="13.5" Foreground="#546E7A" />
                            <TextBlock Text="{Binding SelectedSpec.MinorDiameter, StringFormat={}{0:0.###} мм}" FontSize="13.5" FontWeight="Bold" Foreground="#2E7D32" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <StackPanel Visibility="{Binding Main.IsOperatorMode, Converter={StaticResource BoolToVis}}">
                <!-- КАРТОЧКА 2: ПОДГОТОВКА ПОВЕРХНОСТИ И ПАРАМЕТРЫ ДЛЯ ЧПУ (G76) -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="2. Подготовка заготовки и параметры для цикла ЧПУ (G76)" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- ЛЕВАЯ КОЛОНКА: Крупный блок диаметра сверла или проточки -->
                            <!-- ЛЕВАЯ КОЛОНКА: Крупный блок диаметра сверла / раскатника или проточки -->
                            <Border Grid.Column="0" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel VerticalAlignment="Center">
                                    <!-- Переключатель Метчик / Раскатник (только для внутренней резьбы) -->
                                    <Border Background="White" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                            Visibility="{Binding IsInternalThread, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <TextBlock Text="Инструмент:" FontSize="12" Foreground="#546E7A" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Метчик / Резец" FontSize="12" FontWeight="SemiBold" Foreground="#0D47A1" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <CheckBox IsChecked="{Binding IsRollFormingThread, Mode=TwoWay}"
                                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                          VerticalAlignment="Center" Cursor="Hand" />
                                                <TextBlock Text="Раскатник" FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Text="{Binding OperatorResult.PrepTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding OperatorResult.PrepDiameterText}" FontSize="30" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding OperatorResult.PrepNote}" FontSize="12.5" LineHeight="18" Foreground="#37474F" TextWrapping="Wrap" />

                                    <!-- Предупреждение о несовместимости материала с раскатником -->
                                    <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                            Visibility="{Binding OperatorResult.HasWarning, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding OperatorResult.WarningMessage}" Foreground="#E65100" FontSize="12" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ПРАВАЯ КОЛОНКА: Таблица параметров профиля для забивки в стойку ЧПУ -->
                            <Border Grid.Column="2" Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Данные для наладки и цикла резания:" FontSize="13.5" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,10" />

                                    <!-- Шаг резьбы P -->
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Шаг резьбы (P):" Foreground="#546E7A" />
                                        <TextBlock Text="{Binding OperatorResult.Pitch, StringFormat={}{0:0.###} мм}" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <!-- Высота профиля H1 -->
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Высота профиля H₁ (на сторону):" Foreground="#546E7A" />
                                        <TextBlock Text="{Binding OperatorResult.ThreadHeightH1, StringFormat={}{0:0.###} мм}" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <!-- Средний диаметр d2 / D2 -->
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Средний диаметр (d₂ / D₂):" Foreground="#546E7A" />
                                        <TextBlock Text="{Binding OperatorResult.PitchDiameter, StringFormat={}{0:0.###} мм}" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <Separator Margin="0,4,0,8" />

                                    <!-- Рекомендуемое число проходов -->
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Рекомендуемое число проходов:" Foreground="#546E7A" />
                                        <TextBlock Text="{Binding OperatorResult.RecommendedPasses, StringFormat={}{0} прох.}" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <!-- Глубина первого прохода -->
                                    <DockPanel>
                                        <TextBlock Text="Глубина 1-го чернового прохода:" Foreground="#546E7A" />
                                        <TextBlock Text="{Binding OperatorResult.FirstPassDepth, StringFormat={}{0:0.###} мм}" FontWeight="SemiBold" Foreground="#37474F" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- КАРТОЧКА 3: КОНТРОЛЬ СРЕДНЕГО ДИАМЕТРА И ГЕНЕРАЦИЯ КАДРА G76 -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="3. Контроль среднего диаметра (d₂ / D₂) и черновой кадр G76 (Fanuc)" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>

                            <!-- ЛЕВАЯ КОЛОНКА: Контроль по среднему диаметру и сводка координат -->
                            <Border Grid.Column="0" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Допустимый средний диаметр (6g / 6H):" FontSize="13" FontWeight="SemiBold" Foreground="#E65100" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding ControlAndG76Result.PitchDiameterRangeText}" FontSize="22" FontWeight="Bold" Foreground="#BF360C" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ControlAndG76Result.ControlNote}" FontSize="12.5" LineHeight="18" Foreground="#37474F" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <Separator Margin="0,0,0,10" />

                                    <TextBlock Text="Итоговые координаты цикла (ноль справа Z0):" FontSize="12.5" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding ControlAndG76Result.StartZ, StringFormat=Точка старта цикла (Z нач.): {0:+0.00;-0.00;0.00} мм}" FontSize="12.5" Foreground="#455A64" />
                                    <TextBlock Text="{Binding ControlAndG76Result.EndZ, StringFormat=Конец резания (Z кон.): {0:+0.00;-0.00;0.00} мм}" FontSize="12.5" Foreground="#455A64" />
                                </StackPanel>
                            </Border>

                            <!-- ПРАВАЯ КОЛОНКА: Настройки координат и готовый кадр G76 -->
                            <Border Grid.Column="2" Background="#263238" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <!-- Ряд полей ввода: Начало Z0, Длина L, Подвод, Перебег -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">

                                        <!-- Поле 1: Начало Z0 (по умолчанию 0) -->
                                        <StackPanel Margin="0,0,12,6">
                                            <TextBlock Text="Начало Z₀, мм" FontSize="11.5" Foreground="#B0BEC5" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding ThreadStartZText, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                     MaxLength="7" Width="68" FontSize="14.5" FontWeight="Bold"
                                                     Foreground="White" CaretBrush="White" Padding="6,4" />
                                        </StackPanel>

                                        <!-- Поле 2: Длина резьбы L -->
                                        <StackPanel Margin="0,0,12,6">
                                            <TextBlock Text="Длина L, мм" FontSize="11.5" Foreground="#B0BEC5" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding ThreadLengthText, UpdateSourceTrigger=PropertyChanged}"
                                                         core:NumericInputBehavior.IsDecimal="True"
                                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                         MaxLength="7" Width="68" FontSize="14.5" FontWeight="Bold"
                                                        Foreground="White" CaretBrush="White" Padding="6,4" />
                                                <controls:NumberPickerButton SelectedValue="{Binding ThreadLengthText, Mode=TwoWay}" Margin="2,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Поле 3: Подвод на входе (по умолчанию 2) -->
                                        <StackPanel Margin="0,0,12,6">
                                            <TextBlock Text="Подвод, мм" FontSize="11.5" Foreground="#B0BEC5" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding LeadInText, UpdateSourceTrigger=PropertyChanged}"
                                                     core:NumericInputBehavior.IsDecimal="True"
                                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                     MaxLength="7" Width="62" FontSize="14.5" FontWeight="Bold"
                                                     Foreground="White" CaretBrush="White" Padding="6,4" />
                                        </StackPanel>

                                        <!-- Поле 4: Перебег на выходе (по умолчанию 0) -->
                                        <StackPanel Margin="0,0,12,6">
                                            <TextBlock Text="Перебег, мм" FontSize="11.5" Foreground="#B0BEC5" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding OvertravelText, UpdateSourceTrigger=PropertyChanged}"
                                                    core:NumericInputBehavior.IsDecimal="True"
                                                    materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                    MaxLength="7" Width="62" FontSize="14.5" FontWeight="Bold"
                                                    Foreground="White" CaretBrush="White" Padding="6,4" />
                                        </StackPanel>

                                    </WrapPanel>

                                    <!-- Чекбокс выхода в канавку -->
                                    <CheckBox Content="Выход в канавку (обнулить сбег P0200..)"
                                            IsChecked="{Binding HasReliefGroove, Mode=TwoWay}"
                                            Foreground="#ECEFF1" FontSize="12.5" Margin="0,0,0,12" Cursor="Hand" />

                                    <!-- Окно с готовым G-кодом и кнопкой копирования -->
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Управляющий блок Fanuc (G76):" FontSize="12" Foreground="#90CAF9" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Command="{Binding CopyG76Command}"
                                                Content="Копировать код" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#81C784" BorderBrush="#81C784" Height="26" Padding="10,0" FontSize="11.5" Cursor="Hand" />
                                    </DockPanel>

                                    <Border Background="#1C2429" BorderBrush="#37474F" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <TextBlock Text="{Binding ControlAndG76Result.G76CodeBlock}"
                                       FontFamily="Consolas" FontSize="14" LineHeight="20" Foreground="#A5D6A7" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- КАРТОЧКА 4 (ОПЕРАТОР): СХЕМА ТРАЕКТОРИИ РЕЗЦА ДЛЯ ЦИКЛА G76 -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="4. Схема траектории резца в цикле G76 (карта наладки по оси Z)" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />

                            <!-- Легенда схемы -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Line X1="0" Y1="5" X2="18" Y2="5" Stroke="#C62828" StrokeThickness="2" StrokeDashArray="3 2" Margin="0,0,4,0" />
                                <TextBlock Text="Ускоренный ход (G00)" FontSize="11.5" Opacity="0.7" Margin="0,0,14,0" />

                                <Line X1="0" Y1="5" X2="18" Y2="5" Stroke="#1565C0" StrokeThickness="2.5" Margin="0,0,4,0" />
                                <TextBlock Text="Рабочий ход резания (G76)" FontSize="11.5" Opacity="0.7" />
                            </StackPanel>
                        </DockPanel>

                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#FAFAFA" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="520" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- ЛЕВАЯ ЧАСТЬ: Векторная схема заготовки и траектории (Canvas) -->
                                <Canvas Grid.Column="0" Width="510" Height="215" ClipToBounds="True" Cursor="">

                                    <!-- 1. Осевая линия детали -->
                                    <Line X1="20" Y1="175" X2="495" Y2="175" Stroke="#78909C" StrokeThickness="1.5" StrokeDashArray="10 3 2 3" />
                                    <TextBlock Canvas.Left="25" Canvas.Top="180" Text="Ось шпинделя (X0)" FontSize="10.5" Foreground="#78909C" />

                                    <!-- 2. ВАРИАНТ А: НАРУЖНАЯ РЕЗЬБА (ВАЛ) -->
                                    <Canvas Visibility="{Binding ControlAndG76Result.IsExternal, Converter={StaticResource BoolToVis}}">
                                        <Rectangle Canvas.Left="40" Canvas.Top="80" Width="320" Height="95" Fill="#ECEFF1" Stroke="#455A64" StrokeThickness="1.5" />
                                        <Rectangle Canvas.Left="20" Canvas.Top="55" Width="20" Height="120" Fill="#CFD8DC" Stroke="#455A64" StrokeThickness="1.5" />
                                        <Rectangle Canvas.Left="170" Canvas.Top="80" Width="190" Height="14" Fill="#BBDEFB" Stroke="#1565C0" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="148" Canvas.Top="80" Width="22" Height="18" Fill="#FAFAFA" Stroke="#455A64" StrokeThickness="1.2"
                   Visibility="{Binding ControlAndG76Result.HasReliefGroove, Converter={StaticResource BoolToVis}}" />

                                        <Polyline Points="470,40 430,52" Stroke="#C62828" StrokeThickness="2" StrokeDashArray="4 2" />
                                        <Ellipse Canvas.Left="426" Canvas.Top="48" Width="8" Height="8" Fill="#C62828" />

                                        <Line X1="430" Y1="52" X2="430" Y2="92" Stroke="#1565C0" StrokeThickness="2" />
                                        <Line X1="430" Y1="92" X2="360" Y2="92" Stroke="#2E7D32" StrokeThickness="2.5" />
                                        <Line X1="360" Y1="92" X2="170" Y2="92" Stroke="#1565C0" StrokeThickness="3" />

                                        <Polyline Points="170,92 158,92 158,52 430,52" Stroke="#C62828" StrokeThickness="1.8" StrokeDashArray="4 2"
                  Visibility="{Binding ControlAndG76Result.HasReliefGroove, Converter={StaticResource BoolToVis}}" />
                                        <Polyline Points="170,92 145,52 430,52" Stroke="#C62828" StrokeThickness="1.8" StrokeDashArray="4 2"
                  Visibility="{Binding ControlAndG76Result.HasReliefGroove, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                    </Canvas>

                                    <!-- 3. ВАРИАНТ Б: ВНУТРЕННЯЯ РЕЗЬБА (ОТВЕРСТИЕ) -->
                                    <Canvas Visibility="{Binding ControlAndG76Result.IsInternal, Converter={StaticResource BoolToVis}}">
                                        <Rectangle Canvas.Left="40" Canvas.Top="50" Width="320" Height="45" Fill="#CFD8DC" Stroke="#455A64" StrokeThickness="1.5" />
                                        <Rectangle Canvas.Left="40" Canvas.Top="95" Width="70" Height="80" Fill="#CFD8DC" Stroke="#455A64" StrokeThickness="1.5" />
                                        <Rectangle Canvas.Left="170" Canvas.Top="81" Width="190" Height="14" Fill="#BBDEFB" Stroke="#1565C0" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="148" Canvas.Top="77" Width="22" Height="18" Fill="#FAFAFA" Stroke="#455A64" StrokeThickness="1.2"
                   Visibility="{Binding ControlAndG76Result.HasReliefGroove, Converter={StaticResource BoolToVis}}" />

                                        <Polyline Points="475,135 430,125" Stroke="#C62828" StrokeThickness="2" StrokeDashArray="4 2" />
                                        <Ellipse Canvas.Left="426" Canvas.Top="121" Width="8" Height="8" Fill="#C62828" />

                                        <Line X1="430" Y1="125" X2="430" Y2="83" Stroke="#1565C0" StrokeThickness="2" />
                                        <Line X1="430" Y1="83" X2="360" Y2="83" Stroke="#2E7D32" StrokeThickness="2.5" />
                                        <Line X1="360" Y1="83" X2="170" Y2="83" Stroke="#1565C0" StrokeThickness="3" />

                                        <Polyline Points="170,83 158,83 158,125 430,125" Stroke="#C62828" StrokeThickness="1.8" StrokeDashArray="4 2"
                  Visibility="{Binding ControlAndG76Result.HasReliefGroove, Converter={StaticResource BoolToVis}}" />
                                        <Polyline Points="170,83 145,125 430,125" Stroke="#C62828" StrokeThickness="1.8" StrokeDashArray="4 2"
                  Visibility="{Binding ControlAndG76Result.HasReliefGroove, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                    </Canvas>

                                    <!-- 4. ВЫНОСКИ КООРДИНАТ ПО ОСИ Z -->
                                    <Line X1="430" Y1="22" X2="430" Y2="175" Stroke="#C62828" StrokeThickness="1" StrokeDashArray="2 2" />
                                    <Border Canvas.Left="398" Canvas.Top="4" Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="{Binding ControlAndG76Result.StartZBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#B71C1C" />
                                    </Border>

                                    <Line X1="360" Y1="22" X2="360" Y2="175" Stroke="#2E7D32" StrokeThickness="1" StrokeDashArray="2 2" />
                                    <Border Canvas.Left="344" Canvas.Top="4" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="{Binding ControlAndG76Result.ThreadStartBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#1B5E20" />
                                    </Border>

                                    <Line X1="170" Y1="28" X2="360" Y2="28" Stroke="#1565C0" StrokeThickness="1.5" />
                                    <Border Canvas.Left="228" Canvas.Top="16" Background="#FAFAFA" Padding="4,0">
                                        <TextBlock Text="{Binding ControlAndG76Result.ThreadLengthBadgeText}" FontSize="11.5" FontWeight="Bold" Foreground="#1565C0" />
                                    </Border>

                                    <Line X1="170" Y1="22" X2="170" Y2="175" Stroke="#1565C0" StrokeThickness="1" StrokeDashArray="2 2" />
                                    <Border Canvas.Left="136" Canvas.Top="4" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="{Binding ControlAndG76Result.EndZBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#0D47A1" />
                                    </Border>
                                </Canvas>

                                <!-- ПРАВАЯ ЧАСТЬ: Пояснение этапов цикла для наладчика -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Этапы траектории цикла:" FontSize="14" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,10" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="10" Height="10" Fill="#C62828" Margin="0,4,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="1. Точка подхода (Z нач.): быстрое позиционирование G00 на безопасном расстоянии перед началом резьбы."
                                                    FontSize="12.5" LineHeight="17" Foreground="#37474F" TextWrapping="Wrap" Width="380" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="10" Height="10" Fill="#2E7D32" Margin="0,4,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="2. Участок подвода (разгона): синхронизация оборотов шпинделя и подачи суппорта до касания детали (Z₀)."
                                                    FontSize="12.5" LineHeight="17" Foreground="#37474F" TextWrapping="Wrap" Width="380" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="#1565C0" Margin="0,4,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="3. Рабочий ход и выход: нарезание профиля на длину L + перебег и отвод резца (в канавку или со сбегом)."
                                                    FontSize="12.5" LineHeight="17" Foreground="#37474F" TextWrapping="Wrap" Width="380" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
            <!-- ========================================================================= -->
            <!-- БЛОК РЕЖИМА «ИНЖЕНЕР» (Конструкторский расчёт и ГОСТ 10549-80)            -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding Main.IsEngineerMode, Converter={StaticResource BoolToVis}}">

                <!-- КАРТОЧКА 2 (ИНЖЕНЕР): ВЫБОР КЛАССОВ ТОЧНОСТИ И ТАБЛИЦА ПРЕДЕЛЬНЫХ РАЗМЕРОВ -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="2. Конструкторский расчёт допусков и свинчиваемости (ГОСТ 16093)" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="{Binding EngineerResult.FitDesignation}" FontSize="13.5" FontWeight="Bold" Foreground="#1B5E20" />
                            </Border>
                        </DockPanel>

                        <!-- Выбор полей допусков болта и гайки -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,24,8">
                                <TextBlock Text="Поле допуска гайки (внутр.)" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding NutToleranceClasses}"
                              SelectedItem="{Binding SelectedNutClass, Mode=TwoWay}"
                              FontSize="16" FontWeight="Bold" Width="140" Padding="8,6" />
                            </StackPanel>

                            <StackPanel Margin="0,0,24,8">
                                <TextBlock Text="Поле допуска болта (наруж.)" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding BoltToleranceClasses}"
                              SelectedItem="{Binding SelectedBoltClass, Mode=TwoWay}"
                              FontSize="16" FontWeight="Bold" Width="140" Padding="8,6" />
                            </StackPanel>

                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Угол профиля резьбы:" FontSize="11.5" Opacity="0.7" />
                                    <TextBlock Text="{Binding EngineerResult.ProfileAngleText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#263238" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- БЫСТРЫЙ ВЫБОР ТИПОВЫХ ПОСАДОК РЕЗЬБЫ (ГОСТ 16093) -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Типовые посадки по ГОСТ 16093:" FontSize="12" Opacity="0.7" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding ThreadFitPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyThreadFitPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                BorderBrush="#90CAF9" Foreground="#1565C0"
                                                Margin="0,0,8,6" Padding="12,4" Height="32" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Description, StringFormat=({0})}" FontSize="12" Opacity="0.8" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Две колонки: Предельные размеры Гайки (слева) и Болта (справа) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- КОЛОНКА 1: ГАЙКА (ВНУТРЕННЯЯ РЕЗЬБА) -->
                            <Border Grid.Column="0" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Гайка (внутренняя резьба)" FontSize="14" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding EngineerResult.NutAllowanceText}" FontSize="12" Foreground="#1565C0" Margin="0,0,0,10" />

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Наружный диаметр (D):" Foreground="#37474F" />
                                        <TextBlock Text="{Binding EngineerResult.NutMajorRange}" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Средний диаметр (D₂):" Foreground="#37474F" />
                                        <TextBlock Text="{Binding EngineerResult.NutPitchRange}" FontWeight="Bold" Foreground="#0D47A1" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Внутренний диаметр (D₁):" Foreground="#37474F" />
                                        <TextBlock Text="{Binding EngineerResult.NutMinorRange}" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- КОЛОНКА 2: БОЛТ (НАРУЖНАЯ РЕЗЬБА) -->
                            <Border Grid.Column="2" Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Болт (наружная резьба)" FontSize="14" FontWeight="Bold" Foreground="#B71C1C" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding EngineerResult.BoltAllowanceText}" FontSize="12" Foreground="#C62828" Margin="0,0,0,10" />

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Наружный диаметр (d):" Foreground="#37474F" />
                                        <TextBlock Text="{Binding EngineerResult.BoltMajorRange}" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Средний диаметр (d₂):" Foreground="#37474F" />
                                        <TextBlock Text="{Binding EngineerResult.BoltPitchRange}" FontWeight="Bold" Foreground="#B71C1C" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Внутренний диаметр (d₁):" Foreground="#37474F" />
                                        <TextBlock Text="{Binding EngineerResult.BoltMinorRange}" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Сводная плашка свинчиваемости и зазоров по среднему диаметру -->
                        <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,14,0,0">
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Зазор по среднему диаметру (D₂ − d₂):  " FontSize="13" Foreground="#546E7A" />
                                <TextBlock Text="{Binding EngineerResult.MinPitchClearance, StringFormat='Smin = +{0:0.0000} мм'}" FontSize="13.5" FontWeight="Bold" Foreground="#E65100" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding EngineerResult.MaxPitchClearance, StringFormat='Smax = +{0:0.0000} мм'}" FontSize="13.5" FontWeight="Bold" Foreground="#BF360C" Margin="0,0,24,0" />

                                <TextBlock Text="Нормальная длина свинчивания:  " FontSize="13" Foreground="#546E7A" />
                                <TextBlock Text="{Binding EngineerResult.EngagementLengthRange}" FontSize="13.5" FontWeight="Bold" Foreground="#2E7D32" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- КАРТОЧКА 3 (ИНЖЕНЕР): КОНСТРУКТИВНЫЕ ЭЛЕМЕНТЫ ПО ГОСТ 10549-80 (ФАСКА, ПРОТОЧКА, СБЕГ) -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="3. Конструктивные элементы резьбы: фаски, проточки и сбеги (ГОСТ 10549-80)" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- С выходом инструмента в проточенную канавку -->
                            <Border Grid.Column="0" Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="С проточкой (канавкой) для выхода инструмента:" FontSize="13.5" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,10" />

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Заходная фаска на торце:" Foreground="#546E7A" />
                                        <TextBlock Text="{Binding EngineerResult.EntryChamferText}" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Ширина канавки (f):" Foreground="#546E7A" />
                                        <TextBlock Text="{Binding EngineerResult.GrooveWidthText}" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Угол стенки выхода:" Foreground="#546E7A" />
                                        <TextBlock Text="{Binding EngineerResult.GrooveWallAngleText}" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding EngineerResult.GrooveDiameterText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#37474F" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Без канавки (сбег и недорез) -->
                            <Border Grid.Column="2" Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Без канавки (выход на гладкий цилиндр / в упор):" FontSize="13.5" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,10" />

                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Заходная фаска на торце:" Foreground="#546E7A" />
                                        <TextBlock Text="{Binding EngineerResult.EntryChamferText}" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding EngineerResult.RunoutAndUndercutText}" FontSize="13" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,6" />

                                    <TextBlock Text="Сбег x — участок неполного профиля при отводе резца. Недорез a — минимальное расстояние от конца полного профиля до уступа (буртика) детали."
                                   FontSize="12" LineHeight="17" Foreground="#546E7A" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- КАРТОЧКА 4 (ИНЖЕНЕР): ГРАФИЧЕСКАЯ СХЕМА ПРОФИЛЯ РЕЗЬБЫ -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="4. Схема профиля резьбы и базовые диаметры" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="{Binding EngineerResult.AngleBadgeText, StringFormat='Угол профиля: {0}'}"
                           FontSize="13" FontWeight="Bold" Foreground="#0D47A1" />
                            </Border>
                        </DockPanel>

                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#FAFAFA" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="430" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- ЛЕВАЯ ЧАСТЬ: Векторный чертёж профиля зуба (Canvas) -->
                                <Canvas Grid.Column="0" Width="420" Height="200" ClipToBounds="True">

                                    <!-- Выносная размерная линия шага P (сверху) -->
                                    <Line X1="115" Y1="18" X2="115" Y2="45" Stroke="#546E7A" StrokeThickness="1" />
                                    <Line X1="285" Y1="18" X2="285" Y2="45" Stroke="#546E7A" StrokeThickness="1" />
                                    <Line X1="115" Y1="24" X2="285" Y2="24" Stroke="#1565C0" StrokeThickness="1.5" />
                                    <Border Canvas.Left="165" Canvas.Top="6" Background="#FAFAFA" Padding="4,0">
                                        <TextBlock Text="{Binding EngineerResult.PitchDimensionLabel}" FontSize="12" FontWeight="Bold" Foreground="#1565C0" />
                                    </Border>

                                    <!-- Линия наружного диаметра d / D (верхняя пунктирная) -->
                                    <Line X1="10" Y1="45" X2="410" Y2="45" Stroke="#1565C0" StrokeThickness="1.2" StrokeDashArray="4 2" />
                                    <TextBlock Canvas.Left="10" Canvas.Top="28" Text="d / D" FontSize="11" FontWeight="Bold" Foreground="#1565C0" />

                                    <!-- Линия среднего диаметра d2 / D2 (оранжевая штрихпунктирная по центру) -->
                                    <Line X1="10" Y1="95" X2="410" Y2="95" Stroke="#E65100" StrokeThickness="1.5" StrokeDashArray="6 3 2 3" />
                                    <TextBlock Canvas.Left="10" Canvas.Top="78" Text="d₂ / D₂" FontSize="11" FontWeight="Bold" Foreground="#E65100" />

                                    <!-- Линия внутреннего диаметра d1 / D1 (нижняя пунктирная) -->
                                    <Line X1="10" Y1="145" X2="410" Y2="145" Stroke="#2E7D32" StrokeThickness="1.2" StrokeDashArray="4 2" />
                                    <TextBlock Canvas.Left="10" Canvas.Top="148" Text="d₁ / D₁" FontSize="11" FontWeight="Bold" Foreground="#2E7D32" />

                                    <!-- Контур профиля резьбы (автоматически меняет форму: M / Tr / S) -->
                                    <Polyline Points="{Binding EngineerResult.ProfileGeometryPoints}"
                                                Stroke="#263238" StrokeThickness="2.8" StrokeLineJoin="Round" />

                                    <!-- Выносная линия рабочей высоты профиля H1 (справа) -->
                                    <Line X1="382" Y1="45" X2="382" Y2="145" Stroke="#C62828" StrokeThickness="1.5" />
                                    <Line X1="376" Y1="45" X2="388" Y2="45" Stroke="#C62828" StrokeThickness="1.5" />
                                    <Line X1="376" Y1="145" X2="388" Y2="145" Stroke="#C62828" StrokeThickness="1.5" />
                                    <Border Canvas.Left="305" Canvas.Top="102" Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="{Binding EngineerResult.HeightDimensionLabel}" FontSize="11" FontWeight="Bold" Foreground="#B71C1C" />
                                    </Border>

                                    <!-- Осевая линия детали (снизу) -->
                                    <Line X1="10" Y1="182" X2="410" Y2="182" Stroke="#78909C" StrokeThickness="1.5" StrokeDashArray="10 3 2 3" />
                                    <TextBlock Canvas.Left="160" Canvas.Top="166" Text="Ось вращения детали" FontSize="10.5" Foreground="#78909C" />
                                </Canvas>

                                <!-- ПРАВАЯ ЧАСТЬ: Расшифровка базовых диаметров -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Базовые диаметры профиля:" FontSize="14" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,10" />

                                    <Border Background="#E3F2FD" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding EngineerResult.MajorDiameterLabel}" FontSize="13.5" FontWeight="Bold" Foreground="#0D47A1" />
                                    </Border>

                                    <Border Background="#FFF8E1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding EngineerResult.PitchDiameterLabel}" FontSize="13.5" FontWeight="Bold" Foreground="#E65100" />
                                    </Border>

                                    <Border Background="#E8F5E9" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding EngineerResult.MinorDiameterLabel}" FontSize="13.5" FontWeight="Bold" Foreground="#1B5E20" />
                                    </Border>

                                    <TextBlock Text="На схеме показаны теоретические границы профиля (d, d₂, d₁), шаг P и рабочая высота перекрытия витков H₁."
                                                FontSize="12" LineHeight="17" Foreground="#546E7A" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
