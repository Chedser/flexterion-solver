<UserControl x:Class="MechCore.Views.Geometry.GeometryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MechCore.Controls"
             xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:core="clr-namespace:MechCore.Core">

    <UserControl.Resources>
        <core:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1050">

            <!-- ЗАГОЛОВОК МОДУЛЯ -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Геометрический и тригонометрический решатель" FontSize="24" FontWeight="Bold" Foreground="#263238" />
                <TextBlock Text="Расчёт прямоугольных и косоугольных треугольников, координат фасок и заборного конуса сверла"
                           FontSize="13" Foreground="#546E7A" Margin="0,4,0,0" />
            </StackPanel>

            <!-- КАРТОЧКА 1: ТРИГОНОМЕТРИЧЕСКИЙ РЕШАТЕЛЬ ТРЕУГОЛЬНИКОВ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="1. Расчёт токарных фасок и траектории подвода резца"
                                   FontSize="16" FontWeight="Bold" Foreground="#263238" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" Background="#ECEFF1" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding SelectedChamferAngle, StringFormat='Угол фаски: {0:0.##}°'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#37474F" />
                        </Border>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ЛЕВАЯ КОЛОНКА -->
                        <StackPanel Grid.Column="0">

                            <!-- БЛОК ИЗ 3 ПЕРЕКЛЮЧАТЕЛЕЙ -->
                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- Переключатель 1 -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="На увеличение X" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsChamferDecreasingX, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="На уменьшение X" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <!-- Переключатель 2 -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Справа налево" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsChamferLeftToRight, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Слева направо" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <!-- Переключатель 3 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Вал (наружная)" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsChamferHole, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Отверстие (внутр.)" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Выбор стандартного угла фаски -->
                            <TextBlock Text="Угол фаски α (стандартный ряд):" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6" />
                            <UniformGrid Columns="5" Margin="0,0,0,14">
                                <Button Content="15°" Command="{Binding SelectChamferAngleCommand}" CommandParameter="15"
                                        Background="{Binding Angle15Bg}" Foreground="{Binding Angle15Fg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="12.5" FontWeight="Bold" Cursor="Hand" />
                                <Button Content="20°" Command="{Binding SelectChamferAngleCommand}" CommandParameter="20"
                                        Background="{Binding Angle20Bg}" Foreground="{Binding Angle20Fg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="12.5" FontWeight="Bold" Cursor="Hand" />
                                <Button Content="30°" Command="{Binding SelectChamferAngleCommand}" CommandParameter="30"
                                        Background="{Binding Angle30Bg}" Foreground="{Binding Angle30Fg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="12.5" FontWeight="Bold" Cursor="Hand" />
                                <Button Content="45°" Command="{Binding SelectChamferAngleCommand}" CommandParameter="45"
                                        Background="{Binding Angle45Bg}" Foreground="{Binding Angle45Fg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="12.5" FontWeight="Bold" Cursor="Hand" />
                                <Button Content="60°" Command="{Binding SelectChamferAngleCommand}" CommandParameter="60"
                                        Background="{Binding Angle60Bg}" Foreground="{Binding Angle60Fg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0" Padding="0" FontSize="12.5" FontWeight="Bold" Cursor="Hand" />
                            </UniformGrid>

                            <!-- Катет фаски c (по оси Z) -->
                            <TextBox Text="{Binding ChamferAxialLegText, UpdateSourceTrigger=PropertyChanged}"
                                     core:NumericInputBehavior.IsDecimal="True"
                                     materialDesign:HintAssist.Hint="Катет фаски c по оси Z (мм)"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     MaxLength="7"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="14" Padding="10,8" Margin="0,0,0,12" />

                            <!-- Координаты начала фаски (X_нач и Z_нач) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding ChamferStartXText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Диаметр начала X_нач (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding ChamferStartZText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Координата Z_нач (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />
                            </Grid>

                            <!-- Настройка безопасного подвода резца по Z -->
                            <Border Background="#F5F7F8" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <CheckBox Content="Рассчитывать вынесенный подвод по углу фаски"
                                          IsChecked="{Binding UseChamferApproach, Mode=TwoWay}"
                                          FontSize="12.5" Cursor="Hand" />
                            </Border>

                            <TextBox Text="{Binding ChamferApproachZText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseChamferApproach}"
                                     core:NumericInputBehavior.IsDecimal="True"
                                     materialDesign:HintAssist.Hint="Величина подвода резца по Z (мм)"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     MaxLength="7"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="14" Padding="10,8" Margin="0,0,0,12" />

                            <!-- Настройка рабочей подачи F и автоподбора по материалу -->
                            <Border Background="#F5F7F8" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox Content="Учитывать рабочую подачу F в G-коде"
                                              IsChecked="{Binding UseChamferFeed, Mode=TwoWay}"
                                              FontSize="12.5" Cursor="Hand" />

                                    <CheckBox Content="Автоматически подобрать подачу по материалу"
                                              IsChecked="{Binding AutoCalculateChamferFeed, Mode=TwoWay}"
                                              IsEnabled="{Binding UseChamferFeed}"
                                              FontSize="12.5" Margin="0,6,0,0" Cursor="Hand" />
                                </StackPanel>
                            </Border>

                            <!-- Выбор группы ISO 513 и конкретной марки (видим при включённом автоподборе) -->
                            <StackPanel Visibility="{Binding AutoCalculateChamferFeed, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding IsChamferMaterialSelectorActive}"
                                        Margin="0,0,0,6">

                                <!-- 6 цветных кнопок групп ISO -->
                                <ItemsControl ItemsSource="{Binding IsoGroups}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectChamferIsoGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{Binding BadgeColor}"
                                                    BorderBrush="{Binding BadgeColor}"
                                                    Foreground="White"
                                                    Height="32" Margin="0,0,4,0" Padding="0"
                                                    FontSize="13.5" FontWeight="Bold" Cursor="Hand"
                                                    ToolTip="{Binding Name}">
                                                <TextBlock Text="{Binding CodeLetter}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Бейдж выбранной группы ISO -->
                                <Border Background="{Binding SelectedChamferIsoGroup.BadgeBackground}"
                                        BorderBrush="{Binding SelectedChamferIsoGroup.BadgeColor}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{Binding SelectedChamferIsoGroup.BadgeColor}" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedChamferIsoGroup.CodeLetter}" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedChamferIsoGroup.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Выпадающий список марок выбранной группы ISO -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding FilteredChamferGrades}"
                                              SelectedItem="{Binding SelectedChamferMaterial}"
                                              materialDesign:HintAssist.Hint="Конкретная марка (необязательно)"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GostGrade}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding DinGrade, StringFormat='({0})'}" Foreground="#78909C" FontSize="11.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding ClearChamferGradeCommand}"
                                            Visibility="{Binding HasSelectedChamferMaterial, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Width="36" Height="36" Padding="0" Margin="8,0,0,0"
                                            ToolTip="Сбросить выбор марки (считать по группе ISO)"
                                            Cursor="" />
                                </Grid>
                                <!-- Пресеты интенсивности режимов (Щадящий / Оптимальный / Форсированный) -->
                                <TextBlock Text="Интенсивность режимов:" FontSize="12" Foreground="#546E7A" Margin="0,10,0,6" />
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Button Content="Щадящий" Command="{Binding SelectChamferIntensityCommand}" CommandParameter="Gentle"
                                            Background="{Binding ChamferGentleBg}" Foreground="{Binding ChamferGentleFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Оптимальный" Command="{Binding SelectChamferIntensityCommand}" CommandParameter="Optimal"
                                            Background="{Binding ChamferOptimalBg}" Foreground="{Binding ChamferOptimalFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Форсированный" Command="{Binding SelectChamferIntensityCommand}" CommandParameter="Aggressive"
                                            Background="{Binding ChamferAggressiveBg}" Foreground="{Binding ChamferAggressiveFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                </UniformGrid>
                                <TextBlock Text="{Binding ChamferIntensityNote}"
                                            FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="2,0,0,4" />
                            </StackPanel>

                            <TextBlock Text="{Binding ChamferFeedAutoNote}"
                                       Visibility="{Binding AutoCalculateChamferFeed, Converter={StaticResource BoolToVis}}"
                                       FontSize="11.5" Foreground="#1565C0" TextWrapping="Wrap" Margin="2,0,0,10" />

                            <!-- Поля рабочей подачи F (мм/об) и оборотов шпинделя S (об/мин) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding ChamferFeedRateText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UseChamferFeed}"
                                         IsReadOnly="{Binding AutoCalculateChamferFeed}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Рабочая подача F (мм/об)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding ChamferSpindleRpmText, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding AutoCalculateChamferFeed}"
                                         core:NumericInputBehavior.IsInteger="True"
                                         materialDesign:HintAssist.Hint="Обороты шпинделя S (об/мин)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="6"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />
                            </Grid>

                            <!-- Предупреждение о возможном зарезе при Z_нач < 0 -->
                            <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                    Visibility="{Binding ChamferResult.HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ChamferResult.WarningMessage}" Foreground="#E65100" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <!-- Сообщение об ошибке -->
                            <TextBlock Text="{Binding ChamferResult.ErrorMessage}" Foreground="#C62828" FontSize="12.5" TextWrapping="Wrap" Margin="2,0,0,0" />

                        </StackPanel>
                        <!-- ПРАВАЯ КОЛОНКА: РАСЧЁТНЫЕ КООРДИНАТЫ И G-КОД -->
                        <StackPanel Grid.Column="2">
                            <!-- Координаты точки подвода резца -->
                            <Border Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Точка подвода резца" FontSize="12.5" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,8" />

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Диаметр X_подв:" FontSize="13.5" Foreground="#37474F" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChamferResult.ApproachX, StringFormat='{}{0:0.###} мм'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <DockPanel>
                                        <TextBlock Text="Координата Z_подв:" FontSize="13.5" Foreground="#37474F" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChamferResult.ApproachZ, StringFormat='{}{0:0.###} мм'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Координаты точки конца фаски -->
                            <Border Background="#F5F7F8" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Точка конца фаски" FontSize="12.5" FontWeight="Bold" Foreground="#546E7A" Margin="0,0,0,8" />

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Диаметр X_кон:" FontSize="13.5" Foreground="#37474F" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChamferResult.EndX, StringFormat='{}{0:0.###} мм'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Координата Z_кон:" FontSize="13.5" Foreground="#37474F" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChamferResult.EndZ, StringFormat='{}{0:0.###} мм'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <Separator Margin="0,2,0,8" />

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Радиальный катет ΔR:" FontSize="13" Foreground="#546E7A" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChamferResult.RadialLeg, StringFormat='{}{0:0.###} мм'}"
                                                   FontSize="13.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <DockPanel>
                                        <TextBlock Text="Диаметральный перепад ΔX:" FontSize="13" Foreground="#546E7A" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChamferResult.DiameterDelta, StringFormat='{}{0:0.###} мм'}"
                                                   FontSize="13.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <Separator Margin="0,6,0,8" />

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Длина пути резания L_рез:" FontSize="13" Foreground="#546E7A" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChamferResult.CuttingPathLengthMm, StringFormat='{}{0:0.##} мм'}"
                                                    FontSize="13.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <DockPanel>
                                        <TextBlock Text="Машинное время прохода T_м:" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChamferResult.MachiningTimeText}"
                                                     FontSize="14" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Блок G-кода (режим Оператор) -->
                            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="12"
                                    Visibility="{Binding Main.IsOperatorMode, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding CopyChamferGCodeCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="32" Padding="10,0" VerticalAlignment="Center" Cursor="Hand"
                                            ToolTip="Скопировать кадры G00/G01">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Копировать" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{Binding ChamferResult.CncGCodeSnippet}"
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#1B5E20"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                           
                            <!-- ВЕКТОРНЫЙ ЭСКИЗ ФАСКИ (Canvas 320x200) -->
                            <Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8"
                                    VerticalAlignment="Top" Height="225">
                                <Grid>
                                    <TextBlock Text="Схема обработки фаски" FontSize="11" Foreground="#78909C" Margin="10,6,0,0" VerticalAlignment="Top" />

                                    <Canvas Width="320" Height="200" VerticalAlignment="Bottom"
                                            Visibility="{Binding ChamferResult.IsValid, Converter={StaticResource BoolToVis}}">

                                        <!-- Тело детали -->
                                        <Polygon Points="{Binding ChamferResult.PartBodyPoints}"
                                                Fill="#1E455A64" Stroke="Transparent" />

                                        <!-- Контур детали -->
                                        <Polyline Points="{Binding ChamferResult.PartOutlinePoints}"
                                                  Stroke="#455A64" StrokeThickness="2" StrokeLineJoin="Round" />

                                        <!-- Горизонтальный катет (осевая длина c) -->
                                        <Line X1="{Binding ChamferResult.CanvasStartX}" Y1="{Binding ChamferResult.CanvasStartY}"
                                              X2="{Binding ChamferResult.LegCornerX}" Y2="{Binding ChamferResult.LegCornerY}"
                                              Stroke="#00897B" StrokeThickness="1.5" StrokeDashArray="3 2" />

                                        <!-- Вертикальный катет (радиальный катет ΔR) -->
                                        <Line X1="{Binding ChamferResult.LegCornerX}" Y1="{Binding ChamferResult.LegCornerY}"
                                               X2="{Binding ChamferResult.CanvasEndX}" Y2="{Binding ChamferResult.CanvasEndY}"
                                               Stroke="#00897B" StrokeThickness="1.5" StrokeDashArray="3 2" />
                                       
                                        <!-- Подпись длины горизонтального катета -->
                                        <TextBlock Text="{Binding ChamferResult.HorizontalLegText}"
                                                   Canvas.Left="{Binding ChamferResult.LabelHorizLegX}"
                                                   Canvas.Top="{Binding ChamferResult.LabelHorizLegY}"
                                                   FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#00695C" />

                                        <!-- Подпись длины вертикального катета -->
                                        <TextBlock Text="{Binding ChamferResult.VerticalLegText}"
                                                    Canvas.Left="{Binding ChamferResult.LabelVertLegX}"
                                                    Canvas.Top="{Binding ChamferResult.LabelVertLegY}"
                                                    FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#00695C" />

                                        <!-- Осевая линия -->
                                        <Line X1="16" Y1="{Binding ChamferResult.CenterLineY}"
                                                X2="304" Y2="{Binding ChamferResult.CenterLineY}"
                                                Stroke="#2E7D32" StrokeThickness="1" StrokeDashArray="8 3 1 3" />
                                        <!-- Подпись линии X = 0 -->
                                        <TextBlock Text="X0"
                                           Canvas.Left="16"
                                           Canvas.Top="{Binding ChamferResult.CenterLineY}"
                                           Margin="0,-14,0,0"
                                           FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />

                                        <!-- Линия ноля детали (Z = 0) -->
                                        <Line X1="{Binding ChamferResult.ZeroLineX}" Y1="12"
                                              X2="{Binding ChamferResult.ZeroLineX}" Y2="188"
                                              Stroke="#2E7D32" StrokeThickness="1.2" StrokeDashArray="8 3 1 3" />

                                        <!-- Подпись линии Z = 0 -->
                                        <TextBlock Text="Z0"
                                                    Canvas.Left="{Binding ChamferResult.ZeroLineX}"
                                                    Canvas.Top="12"
                                                    Margin="4,0,0,0"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />

                                        <!-- Траектория подвода резца -->
                                        <Line Visibility="{Binding ChamferResult.ShowApproachLine, Converter={StaticResource BoolToVis}}"
                                              X1="{Binding ChamferResult.CanvasApproachX}" Y1="{Binding ChamferResult.CanvasApproachY}"
                                              X2="{Binding ChamferResult.CanvasStartX}" Y2="{Binding ChamferResult.CanvasStartY}"
                                             Stroke="{Binding ChamferResult.ApproachStrokeBrush}" StrokeThickness="2" StrokeDashArray="4 3" />

                                        <!-- Линия самой фаски -->
                                        <Line X1="{Binding ChamferResult.CanvasStartX}" Y1="{Binding ChamferResult.CanvasStartY}"
                                              X2="{Binding ChamferResult.CanvasEndX}" Y2="{Binding ChamferResult.CanvasEndY}"
                                              Stroke="{Binding ChamferResult.ChamferStrokeBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                        <!-- Вынесенный вектор направления подачи G01 -->
                                        <Line X1="{Binding ChamferResult.FeedVectorStartX}" Y1="{Binding ChamferResult.FeedVectorStartY}"
                                              X2="{Binding ChamferResult.FeedVectorEndX}" Y2="{Binding ChamferResult.FeedVectorEndY}"
                                              Stroke="{Binding ChamferResult.ChamferStrokeBrush}" StrokeThickness="1.8" />

                                        <!-- Наконечник стрелки направления подачи -->
                                        <Polygon Points="{Binding ChamferResult.FeedArrowHeadPoints}"
                                                 Fill="{Binding ChamferResult.ChamferStrokeBrush}" />

                                        <!-- Подпись подачи G01 -->
                                    <!--    <TextBlock Text="G01"
                                                   Canvas.Left="{Binding ChamferResult.LabelFeedX}"
                                                   Canvas.Top="{Binding ChamferResult.LabelFeedY}"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                   Foreground="{Binding ChamferResult.ChamferStrokeBrush}" /> -->

                                        <!-- Точка подвода -->
                                        <Ellipse Visibility="{Binding ChamferResult.ShowApproachLine, Converter={StaticResource BoolToVis}}"
                                                 Width="8" Height="8" Fill="{Binding ChamferResult.ApproachStrokeBrush}"
                                                 Canvas.Left="{Binding ChamferResult.CanvasApproachX}"
                                                 Canvas.Top="{Binding ChamferResult.CanvasApproachY}"
                                                 Margin="-4,-4,0,0" />

                                        <!-- Точка начала фаски -->
                                        <Ellipse Width="7" Height="7" Fill="#263238"
                                                 Canvas.Left="{Binding ChamferResult.CanvasStartX}"
                                                 Canvas.Top="{Binding ChamferResult.CanvasStartY}"
                                                 Margin="-3.5,-3.5,0,0" />

                                        <!-- Точка конца фаски -->
                                    <Ellipse Width="8" Height="8" Fill="{Binding ChamferResult.ChamferStrokeBrush}"
                                         Canvas.Left="{Binding ChamferResult.CanvasEndX}"
                                         Canvas.Top="{Binding ChamferResult.CanvasEndY}"
                                         Margin="-4,-4,0,0" />

                                        <!-- Подпись точки подвода -->
                                        <Border Visibility="{Binding ChamferResult.ShowApproachLine, Converter={StaticResource BoolToVis}}"
                                                Canvas.Left="{Binding ChamferResult.LabelApproachX}"
                                                Canvas.Top="{Binding ChamferResult.LabelApproachY}"
                                                Background="#E6FFFFFF" CornerRadius="3" Padding="3,1">
                                            <TextBlock Text="{Binding ChamferResult.ApproachLabelText}"
                                                       FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{Binding ChamferResult.ApproachStrokeBrush}" />
                                        </Border>

                                        <!-- Подпись точки начала фаски -->
                                        <Border Canvas.Left="{Binding ChamferResult.LabelStartX}"
                                                Canvas.Top="{Binding ChamferResult.LabelStartY}"
                                                Background="#E6FFFFFF" CornerRadius="3" Padding="3,1">
                                            <TextBlock Text="{Binding ChamferResult.StartLabelText}"
                                                FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"
                                                Foreground="#263238" />
                                        </Border>

                                        <!-- Подпись точки конца фаски -->
                                        <Border Canvas.Left="{Binding ChamferResult.LabelEndX}"
                                                Canvas.Top="{Binding ChamferResult.LabelEndY}"
                                                Background="#E6FFFFFF" CornerRadius="3" Padding="3,1">
                                            <TextBlock Text="{Binding ChamferResult.EndLabelText}"
                                                FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"
                                                Foreground="{Binding ChamferResult.ChamferStrokeBrush}" />
                                        </Border>
                                    </Canvas>

                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- КАРТОЧКА 2: КРУГОВАЯ ИНТЕРПОЛЯЦИЯ (СКРУГЛЕНИЯ И ГАЛТЕЛИ G02 / G03) -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="2. Расчёт круговой интерполяции (скругления и галтели)"
                                   FontSize="16" FontWeight="Bold" Foreground="#263238" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" Background="#E3F2FD" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding ArcResult.GCodeCommand, StringFormat='Кадр: {0}'}"
                                       FontSize="12" FontWeight="Bold" Foreground="#1565C0" />
                        </Border>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ЛЕВАЯ КОЛОНКА: ПЕРЕКЛЮЧАТЕЛИ И ВВОД ПАРАМЕТРОВ -->
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <!-- БЛОК ИЗ 4 СЛАЙДЕРОВ И РЕЗЦЕДЕРЖАТЕЛЯ -->
                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- Слайдер 1: Выпуклый радиус / Вогнутая галтель -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Выпуклый радиус" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsArcConcaveFillet, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Вогнутая галтель" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <!-- Слайдер 2: На увеличение X / На уменьшение X -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="На увеличение X" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsArcDecreasingX, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="На уменьшение X" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <!-- Слайдер 3: Справа налево / Слева направо -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Справа налево" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsArcLeftToRight, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Слева направо" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <!-- Слайдер 4: Вал / Отверстие -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Вал (наружная)" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsArcHole, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Отверстие (внутр.)" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <Separator Margin="0,2,0,8" />

                                    <!-- Переключатель резцедержателя (для автовыбора G02 / G03) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Задний резец" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsArcFrontTurret, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Передний резец" FontSize="12.5" FontWeight="SemiBold" Foreground="#E65100" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- БЛОК ВЫБОРА РЕЖИМА ЗАДАНИЯ КООРДИНАТ (3 КНОПКИ) -->
                            <TextBlock Text="Исходная точка для расчёта:" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6" />
                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                <Button Content="Вершина угла"
                                        Command="{Binding SelectArcInputModeCommand}"
                                        CommandParameter="ByCornerVertex"
                                        Background="{Binding ModeCornerBg}"
                                        Foreground="{Binding ModeCornerFg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="32" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />

                                <Button Content="Начало дуги"
                                        Command="{Binding SelectArcInputModeCommand}"
                                        CommandParameter="ByStartPoint"
                                        Background="{Binding ModeStartBg}"
                                        Foreground="{Binding ModeStartFg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="32" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />

                                <Button Content="Конец дуги"
                                        Command="{Binding SelectArcInputModeCommand}"
                                        CommandParameter="ByEndPoint"
                                        Background="{Binding ModeEndBg}"
                                        Foreground="{Binding ModeEndFg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="32" Margin="0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                            </UniformGrid>

                            <!-- БЛОК ПРЕСЕТОВ РАДИУСОВ И ПОЛЕЙ ВВОДА (R, X, Z) -->
                            <TextBlock Text="Стандартные радиусы R (ГОСТ 10948):" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6" />
                            <UniformGrid Columns="6" Margin="0,0,0,12">
                                <Button Content="0.5" Command="{Binding SelectArcRadiusCommand}" CommandParameter="0.5" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,3,0" Padding="0" FontSize="12" Cursor="Hand" />
                                <Button Content="1" Command="{Binding SelectArcRadiusCommand}" CommandParameter="1" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,3,0" Padding="0" FontSize="12" Cursor="Hand" />
                                <Button Content="1.6" Command="{Binding SelectArcRadiusCommand}" CommandParameter="1.6" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,3,0" Padding="0" FontSize="12" Cursor="Hand" />
                                <Button Content="2" Command="{Binding SelectArcRadiusCommand}" CommandParameter="2" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,3,0" Padding="0" FontSize="12" Cursor="Hand" />
                                <Button Content="3" Command="{Binding SelectArcRadiusCommand}" CommandParameter="3" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,3,0" Padding="0" FontSize="12" Cursor="Hand" />
                                <Button Content="5" Command="{Binding SelectArcRadiusCommand}" CommandParameter="5" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0" Padding="0" FontSize="12" Cursor="Hand" />
                            </UniformGrid>

                            <!-- Поле радиуса R -->
                            <TextBox Text="{Binding ArcRadiusText, UpdateSourceTrigger=PropertyChanged}"
                                     core:NumericInputBehavior.IsDecimal="True"
                                     materialDesign:HintAssist.Hint="Радиус дуги R (мм)"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     MaxLength="12"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="14" Padding="10,8" Margin="0,0,0,12" />

                            <!-- Поля координат X и Z (подсказка меняется от режима) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding ArcInputXText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="{Binding ArcInputXLabel}"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding ArcInputZText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="{Binding ArcInputZLabel}"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />
                            </Grid>

                            <!-- Настройка рабочей подачи F и автоподбора по материалу -->
                            <Border Background="#F5F7F8" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox Content="Учитывать рабочую подачу F в G-коде"
                                              IsChecked="{Binding UseArcFeed, Mode=TwoWay}"
                                              FontSize="12.5" Cursor="Hand" />

                                    <CheckBox Content="Автоматически подобрать подачу по материалу"
                                              IsChecked="{Binding AutoCalculateArcFeed, Mode=TwoWay}"
                                              IsEnabled="{Binding UseArcFeed}"
                                              FontSize="12.5" Margin="0,6,0,0" Cursor="Hand" />
                                </StackPanel>
                            </Border>

                            <!-- Выбор группы ISO 513 и конкретной марки (видим при включённом автоподборе) -->
                            <StackPanel Visibility="{Binding AutoCalculateArcFeed, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding IsArcMaterialSelectorActive}"
                                        Margin="0,0,0,6" Cursor="">

                                <!-- 6 цветных кнопок групп ISO -->
                                <ItemsControl ItemsSource="{Binding IsoGroups}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectArcIsoGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{Binding BadgeColor}"
                                                    BorderBrush="{Binding BadgeColor}"
                                                    Foreground="White"
                                                    Height="32" Margin="0,0,4,0" Padding="0"
                                                    FontSize="13.5" FontWeight="Bold" Cursor="Hand"
                                                    ToolTip="{Binding Name}">
                                                <TextBlock Text="{Binding CodeLetter}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Бейдж выбранной группы ISO -->
                                <Border Background="{Binding SelectedArcIsoGroup.BadgeBackground}"
                                        BorderBrush="{Binding SelectedArcIsoGroup.BadgeColor}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{Binding SelectedArcIsoGroup.BadgeColor}" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedArcIsoGroup.CodeLetter}" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedArcIsoGroup.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Выпадающий список марок выбранной группы ISO -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding FilteredArcGrades}"
                                              SelectedItem="{Binding SelectedArcMaterial}"
                                              materialDesign:HintAssist.Hint="Конкретная марка (необязательно)"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GostGrade}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding DinGrade, StringFormat='({0})'}" Foreground="#78909C" FontSize="11.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding ClearArcGradeCommand}"
                                            Visibility="{Binding HasSelectedArcMaterial, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Width="36" Height="36" Padding="0" Margin="8,0,0,0"
                                            ToolTip="Сбросить выбор марки (считать по группе ISO)"
                                            Cursor="Hand" />
                                </Grid>
                                <!-- Пресеты интенсивности режимов (Щадящий / Оптимальный / Форсированный) -->
                                <TextBlock Text="Интенсивность режимов:" FontSize="12" Foreground="#546E7A" Margin="0,10,0,6" />
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Button Content="Щадящий" Command="{Binding SelectArcIntensityCommand}" CommandParameter="Gentle"
                                            Background="{Binding ArcGentleBg}" Foreground="{Binding ArcGentleFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Оптимальный" Command="{Binding SelectArcIntensityCommand}" CommandParameter="Optimal"
                                            Background="{Binding ArcOptimalBg}" Foreground="{Binding ArcOptimalFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Форсированный" Command="{Binding SelectArcIntensityCommand}" CommandParameter="Aggressive"
                                            Background="{Binding ArcAggressiveBg}" Foreground="{Binding ArcAggressiveFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                </UniformGrid>
                                <TextBlock Text="{Binding ArcIntensityNote}"
                                            FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="2,0,0,4" />
                            </StackPanel>

                            <TextBlock Text="{Binding ArcFeedAutoNote}"
                                       Visibility="{Binding AutoCalculateArcFeed, Converter={StaticResource BoolToVis}}"
                                       FontSize="11.5" Foreground="#1565C0" TextWrapping="Wrap" Margin="2,0,0,10" />

                            <!-- Поля рабочей подачи F (мм/об) и оборотов шпинделя S (об/мин) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding ArcFeedRateText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UseArcFeed}"
                                         IsReadOnly="{Binding AutoCalculateArcFeed}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Подача F на дуге (мм/об)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding ArcSpindleRpmText, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding AutoCalculateArcFeed}"
                                         core:NumericInputBehavior.IsInteger="True"
                                         materialDesign:HintAssist.Hint="Обороты шпинделя S (об/мин)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="6"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />    
                            </Grid>

                            <!-- Предупреждение (если X уходит за ось симметрии) -->
                            <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                    Visibility="{Binding ArcResult.HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ArcResult.WarningMessage}" Foreground="#E65100" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <!-- Сообщение об ошибке -->
                            <TextBlock Text="{Binding ArcResult.ErrorMessage}" Foreground="#C62828" FontSize="12.5" TextWrapping="Wrap" Margin="2,0,0,0" />

                        </StackPanel>

                        <!-- ПРАВАЯ КОЛОНКА: РЕЗУЛЬТАТЫ, ДВОЙНОЙ G-КОД И ЭСКИЗ -->
                        <StackPanel Grid.Column="1">
                            <!-- ПОДКОЛОНКА 1: ЧИСЛОВЫЕ КООРДИНАТЫ И G-КОД -->
                            <StackPanel Margin="0,0,0,12">

                                <!-- БЛОК РАСЧЁТНЫХ КООРДИНАТ (НАЧАЛО, КОНЕЦ, ЦЕНТР I/K) -->
                                <Border Background="#F5F7F8" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Точка начала дуги (подход G01)" FontSize="12" FontWeight="Bold" Foreground="#546E7A" Margin="0,0,0,6" />

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Диаметр X_нач:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ArcResult.StartX, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel>
                                            <TextBlock Text="Координата Z_нач:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ArcResult.StartZ, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Точка конца дуги и центр (I, K)" FontSize="12" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,6" />

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Диаметр X_кон:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ArcResult.EndX, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Координата Z_кон:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ArcResult.EndZ, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <Separator Margin="0,2,0,6" />

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Смещение центра I (радиус):" FontSize="12.5" Foreground="#546E7A" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ArcResult.CenterOffsetI, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        
                                        <DockPanel>
                                            <TextBlock Text="Смещение центра K (ось Z):" FontSize="12.5" Foreground="#546E7A" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ArcResult.CenterOffsetK, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        
                                        <Separator Margin="0,6,0,6" />

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Длина дуги L_дуги (90°):" FontSize="12.5" Foreground="#546E7A" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ArcResult.ArcLengthMm, StringFormat='{}{0:0.##} мм'}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel>
                                            <TextBlock Text="Машинное время дуги T_м:" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ArcResult.MachiningTimeText}"
                                                      FontSize="14" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" />
                                        </DockPanel>

                                    </StackPanel>
                                </Border>

                                <!-- ДВОЙНОЙ БЛОК G-КОДА (R И I, K) -->
                                <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <!-- Вариант 1: Через радиус R -->
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Command="{Binding CopyArcGCodeRadiusCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Height="28" Padding="8,0" VerticalAlignment="Center" Cursor="Hand"
                                                    ToolTip="Скопировать G-код через радиус R">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock Text="R" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Через радиус (R):" FontSize="11" Foreground="#2E7D32" />
                                                <TextBlock Text="{Binding ArcResult.GCodeRadiusSnippet}"
                                                           FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#1B5E20" />
                                            </StackPanel>
                                        </DockPanel>

                                        <Separator Margin="0,0,0,8" />

                                        <!-- Вариант 2: Через координаты центра I, K -->
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Command="{Binding CopyArcGCodeIKCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Height="28" Padding="8,0" VerticalAlignment="Center" Cursor="Hand"
                                                    ToolTip="Скопировать G-код через центр I, K">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock Text="I, K" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Через центр (I, K):" FontSize="11" Foreground="#2E7D32" />
                                                <TextBlock Text="{Binding ArcResult.GCodeIKSnippet}"
                                                           FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#1B5E20" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ПОДКОЛОНКА 2: ВЕКТОРНЫЙ ЭСКИЗ ДУГИ -->
                            <Border Background="#FAFAFA" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8"
                                    VerticalAlignment="Top" Height="225">
                                <Grid>
                                    <TextBlock Text="Схема круговой интерполяции" FontSize="11" Foreground="#78909C" Margin="10,6,0,0" VerticalAlignment="Top" />

                                    <!-- CANVAS ЭСКИЗА ДУГИ -->
                                    <Canvas Width="320" Height="200" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                            Visibility="{Binding ArcResult.IsValid, Converter={StaticResource BoolToVis}}">

                                        <!-- Тело детали (заливка точно повторяет дугу) -->
                                        <Path Data="{Binding ArcResult.PartBodyPathData}"
                                              Fill="#1E455A64" />

                                        <!-- Контур детали -->
                                        <Path Data="{Binding ArcResult.PartOutlinePathData}"
                                             Stroke="#455A64" StrokeThickness="2" StrokeLineJoin="Round" />

                                        <!-- Линия ноля детали (X = 0) -->
                                        <Line X1="16" Y1="{Binding ArcResult.CenterLineY}"
                                              X2="304" Y2="{Binding ArcResult.CenterLineY}"
                                              Stroke="#2E7D32" StrokeThickness="1.2" StrokeDashArray="8 3 1 3" />

                                        <TextBlock Text="X0"
                                                   Canvas.Left="16"
                                                   Canvas.Top="{Binding ArcResult.CenterLineY}"
                                                   Margin="0,-14,0,0"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />

                                        <!-- Линия ноля детали (Z = 0) -->
                                        <Line X1="{Binding ArcResult.ZeroLineX}" Y1="12"
                                              X2="{Binding ArcResult.ZeroLineX}" Y2="188"
                                              Stroke="#2E7D32" StrokeThickness="1.2" StrokeDashArray="8 3 1 3" />

                                        <TextBlock Text="Z0"
                                                   Canvas.Left="{Binding ArcResult.ZeroLineX}"
                                                   Canvas.Top="12"
                                                   Margin="4,0,0,0"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />

                                        <!-- Пунктирная проекция вершины острого угла -->
                                        <Line X1="{Binding ArcResult.CanvasStartX}" Y1="{Binding ArcResult.CanvasStartY}"
                                              X2="{Binding ArcResult.CanvasCornerX}" Y2="{Binding ArcResult.CanvasCornerY}"
                                              Stroke="#90A4AE" StrokeThickness="1.2" StrokeDashArray="3 2" />
                                        <Line X1="{Binding ArcResult.CanvasCornerX}" Y1="{Binding ArcResult.CanvasCornerY}"
                                              X2="{Binding ArcResult.CanvasEndX}" Y2="{Binding ArcResult.CanvasEndY}"
                                              Stroke="#90A4AE" StrokeThickness="1.2" StrokeDashArray="3 2" />

                                        <!-- Вектор радиуса R от точки старта дуги к центру (I, K) -->
                                    <!--    <Line X1="{Binding ArcResult.CanvasStartX}" Y1="{Binding ArcResult.CanvasStartY}"
                                              X2="{Binding ArcResult.CanvasCenterX}" Y2="{Binding ArcResult.CanvasCenterY}"
                                              Stroke="#00897B" StrokeThickness="1.2" StrokeDashArray="3 2" /> -->

                                        <!-- Дуга скругления / галтели (G02 / G03) -->
                                        <Path Data="{Binding ArcResult.ArcPathData}"
                                              Stroke="{Binding ArcResult.ArcStrokeBrush}"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />

                                        <!-- Точка центра дуги (I, K) -->
                                     <!--   <Ellipse Width="5" Height="5" Fill="#00897B"
                                                 Canvas.Left="{Binding ArcResult.CanvasCenterX}"
                                                 Canvas.Top="{Binding ArcResult.CanvasCenterY}"
                                                 Margin="-2.5,-2.5,0,0" /> -->

                                        <!-- Точка начала дуги -->
                                        <Ellipse Width="7" Height="7" Fill="#263238"
                                                 Canvas.Left="{Binding ArcResult.CanvasStartX}"
                                                 Canvas.Top="{Binding ArcResult.CanvasStartY}"
                                                 Margin="-3.5,-3.5,0,0" />

                                        <!-- Точка конца дуги -->
                                        <Ellipse Width="8" Height="8" Fill="{Binding ArcResult.ArcStrokeBrush}"
                                                 Canvas.Left="{Binding ArcResult.CanvasEndX}"
                                                 Canvas.Top="{Binding ArcResult.CanvasEndY}"
                                                 Margin="-4,-4,0,0" />

                                        <!-- Подпись координат начала дуги -->
                                        <Border Canvas.Left="{Binding ArcResult.LabelStartX}"
                                                Canvas.Top="{Binding ArcResult.LabelStartY}"
                                                Background="#E6FFFFFF" CornerRadius="3" Padding="3,1">
                                            <TextBlock Text="{Binding ArcResult.StartLabelText}"
                                                       FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="#263238" />
                                        </Border>

                                        <!-- Подпись координат конца дуги -->
                                        <Border Canvas.Left="{Binding ArcResult.LabelEndX}"
                                                Canvas.Top="{Binding ArcResult.LabelEndY}"
                                                Background="#E6FFFFFF" CornerRadius="3" Padding="3,1">
                                            <TextBlock Text="{Binding ArcResult.EndLabelText}"
                                                       FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{Binding ArcResult.ArcStrokeBrush}" />
                                        </Border>

                                        <!-- Эквидистантная дуга направления круговой интерполяции -->
                                        <Path Data="{Binding ArcResult.EquidistantArcPathData}"
                                              Stroke="{Binding ArcResult.ArcStrokeBrush}"
                                              StrokeThickness="1.8" />

                                        <!-- Наконечник стрелки на эквидистантной дуге -->
                                        <Polygon Points="{Binding ArcResult.EquidistantArrowHeadPoints}"
                                                 Fill="{Binding ArcResult.ArcStrokeBrush}" />

                                        <!-- Подпись кадра G02 / G03 -->
                                      <!--  <TextBlock Text="{Binding ArcResult.GCodeCommand}"
                                                    Canvas.Left="{Binding ArcResult.LabelFeedX}"
                                                    Canvas.Top="{Binding ArcResult.LabelFeedY}"
                                                    FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                    Foreground="{Binding ArcResult.ArcStrokeBrush}" /> -->

                                        <!-- Точка вершины угла -->
                                        <Ellipse Width="5" Height="5" Fill="#78909C"
                                                 Canvas.Left="{Binding ArcResult.CanvasCornerX}"
                                                 Canvas.Top="{Binding ArcResult.CanvasCornerY}"
                                                Margin="-2.5,-2.5,0,0" />

                                        <!-- Подпись координат вершины угла -->
                                        <Border Canvas.Left="{Binding ArcResult.LabelCornerX}"
                                                Canvas.Top="{Binding ArcResult.LabelCornerY}"
                                                Background="#E6FFFFFF" CornerRadius="3" Padding="3,1">
                                            <TextBlock Text="{Binding ArcResult.CornerLabelText}"
                                                FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold"
                                                Foreground="#546E7A" />
                                        </Border>
                                    </Canvas>

                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- КАРТОЧКА 3: РАСЧЁТ ГЛУХИХ ОТВЕРСТИЙ, КОНУСА СВЕРЛА И ЦИКЛОВ G81 / G83 -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="3. Расчёт глухих отверстий, конуса сверла и циклов сверления"
                                   FontSize="16" FontWeight="Bold" Foreground="#263238" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" Background="#ECEFF1" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding HoleResult.TipAngleDegrees, StringFormat='Угол сверла 2φ: {0:0.##}°'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#37474F" />
                        </Border>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="490" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ЛЕВАЯ КОЛОНКА: ПЕРЕКЛЮЧАТЕЛИ, УГОЛ СВЕРЛА И ВВОД ПАРАМЕТРОВ -->
                        <StackPanel Grid.Column="0">
                            <!-- БЛОК ИЗ 2 СЛАЙДЕРОВ -->
                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- Слайдер 1: По цилиндру L_цил / По кончику L_полн -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="По цилиндру L_цил" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsTotalDepthInput, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="По кончику L_полн" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <!-- Слайдер 2: Горизонтально (токарный) / Вертикально (фрезерный) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Горизонтально (ток.)" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsHoleVertical, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Вертикально (фрез.)" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- БЛОК КНОПОК УГЛОВ СВЕРЛА -->
                            <TextBlock Text="Угол при вершине сверла 2φ:" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6" />
                            <UniformGrid Columns="5" Margin="0,0,0,10">
                                <Button Content="90°" Command="{Binding SelectDrillAngleCommand}" CommandParameter="90"
                                        Background="{Binding Drill90Bg}" Foreground="{Binding Drill90Fg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                <Button Content="118°" Command="{Binding SelectDrillAngleCommand}" CommandParameter="118"
                                        Background="{Binding Drill118Bg}" Foreground="{Binding Drill118Fg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                <Button Content="135°" Command="{Binding SelectDrillAngleCommand}" CommandParameter="135"
                                        Background="{Binding Drill135Bg}" Foreground="{Binding Drill135Fg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                <Button Content="140°" Command="{Binding SelectDrillAngleCommand}" CommandParameter="140"
                                        Background="{Binding Drill140Bg}" Foreground="{Binding Drill140Fg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                <Button Content="Свой" Command="{Binding SelectDrillAngleCommand}" CommandParameter="Custom"
                                        Background="{Binding DrillCustomBg}" Foreground="{Binding DrillCustomFg}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                            </UniformGrid>

                            <!-- Поле ручного ввода произвольного угла (активно при выборе кнопки "Свой") -->
                            <TextBox Text="{Binding CustomDrillAngleText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsCustomDrillAngle}"
                                     core:NumericInputBehavior.IsDecimal="True"
                                     materialDesign:HintAssist.Hint="Произвольный угол при вершине 2φ (°)"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     MaxLength="3"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="14" Padding="10,8" Margin="0,0,0,12" />

                            <!-- БЛОК ПОЛЕЙ ВВОДА (D, L, Z_нач, R) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding DrillDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Диаметр сверла D (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding HoleInputDepthText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="{Binding HoleDepthInputLabel}"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding HoleStartZText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Координата торца Z_нач (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding HoleRetractRText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Безопасный отвод R (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />
                            </Grid>
                            
                                                        <!-- Настройка рабочей подачи F и автоподбора по материалу -->
                            <Border Background="#F5F7F8" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox Content="Учитывать рабочую подачу F в циклах G81 / G83"
                                              IsChecked="{Binding UseHoleFeed, Mode=TwoWay}"
                                              FontSize="12.5" Cursor="Hand" />

                                    <CheckBox Content="Автоматически подобрать подачу по материалу"
                                              IsChecked="{Binding AutoCalculateHoleFeed, Mode=TwoWay}"
                                              IsEnabled="{Binding UseHoleFeed}"
                                              FontSize="12.5" Margin="0,6,0,0" Cursor="Hand" />
                                </StackPanel>
                            </Border>

                            <!-- Выбор группы ISO 513 и конкретной марки (видим при включённом автоподборе) -->
                            <StackPanel Visibility="{Binding AutoCalculateHoleFeed, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding IsHoleMaterialSelectorActive}"
                                        Margin="0,0,0,6" Cursor="">

                                <!-- 6 цветных кнопок групп ISO -->
                                <ItemsControl ItemsSource="{Binding IsoGroups}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectHoleIsoGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{Binding BadgeColor}"
                                                    BorderBrush="{Binding BadgeColor}"
                                                    Foreground="White"
                                                    Height="32" Margin="0,0,4,0" Padding="0"
                                                    FontSize="13.5" FontWeight="Bold" Cursor="Hand"
                                                    ToolTip="{Binding Name}">
                                                <TextBlock Text="{Binding CodeLetter}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Бейдж выбранной группы ISO -->
                                <Border Background="{Binding SelectedHoleIsoGroup.BadgeBackground}"
                                        BorderBrush="{Binding SelectedHoleIsoGroup.BadgeColor}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{Binding SelectedHoleIsoGroup.BadgeColor}" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedHoleIsoGroup.CodeLetter}" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedHoleIsoGroup.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Выпадающий список марок выбранной группы ISO -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding FilteredHoleGrades}"
                                              SelectedItem="{Binding SelectedHoleMaterial}"
                                              materialDesign:HintAssist.Hint="Конкретная марка (необязательно)"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GostGrade}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding DinGrade, StringFormat='({0})'}" Foreground="#78909C" FontSize="11.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding ClearHoleGradeCommand}"
                                            Visibility="{Binding HasSelectedHoleMaterial, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Width="36" Height="36" Padding="0" Margin="8,0,0,0"
                                            ToolTip="Сбросить выбор марки (считать по группе ISO)"
                                            Cursor="Hand" />
                                </Grid>
                                <!-- Пресеты интенсивности режимов (Щадящий / Оптимальный / Форсированный) -->
                                <TextBlock Text="Интенсивность режимов:" FontSize="12" Foreground="#546E7A" Margin="0,10,0,6" />
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Button Content="Щадящий" Command="{Binding SelectHoleIntensityCommand}" CommandParameter="Gentle"
                                            Background="{Binding HoleGentleBg}" Foreground="{Binding HoleGentleFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Оптимальный" Command="{Binding SelectHoleIntensityCommand}" CommandParameter="Optimal"
                                            Background="{Binding HoleOptimalBg}" Foreground="{Binding HoleOptimalFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Форсированный" Command="{Binding SelectHoleIntensityCommand}" CommandParameter="Aggressive"
                                            Background="{Binding HoleAggressiveBg}" Foreground="{Binding HoleAggressiveFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                </UniformGrid>
                                <TextBlock Text="{Binding HoleIntensityNote}"
                                            FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="2,0,0,4" />
                            </StackPanel>

                            <TextBlock Text="{Binding HoleFeedAutoNote}"
                                       Visibility="{Binding AutoCalculateHoleFeed, Converter={StaticResource BoolToVis}}"
                                       FontSize="11.5" Foreground="#1565C0" TextWrapping="Wrap" Margin="2,0,0,10" />

                            <!-- Поля рабочей подачи F (мм/об) и оборотов шпинделя S (об/мин) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding HoleFeedRateText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UseHoleFeed}"
                                         IsReadOnly="{Binding AutoCalculateHoleFeed}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Рабочая подача F (мм/об)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding HoleSpindleRpmText, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding AutoCalculateHoleFeed}"
                                         core:NumericInputBehavior.IsInteger="True"
                                         materialDesign:HintAssist.Hint="Обороты шпинделя S (об/мин)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="6"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14" Padding="10,8" />
                            </Grid>

                            <!-- Настройка округления размеров на схеме -->
                            <Border Background="#F5F7F8" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                <CheckBox Content="Округлять размеры на схеме до 0.1 мм"
                                          IsChecked="{Binding RoundHoleSchemeValues, Mode=TwoWay}"
                                          FontSize="12.5" Cursor="Hand" />
                            </Border>

                            <!-- Предупреждение (если глубина меньше высоты конуса сверла) -->
                            <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                    Visibility="{Binding HoleResult.HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding HoleResult.WarningMessage}" Foreground="#E65100" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <!-- Сообщение об ошибке -->
                            <TextBlock Text="{Binding HoleResult.ErrorMessage}" Foreground="#C62828" FontSize="12.5" TextWrapping="Wrap" Margin="2,0,0,0" />
                        </StackPanel>

                        <!-- ПРАВАЯ КОЛОНКА: ВЕРХНИЙ ЭСКИЗ И НИЖНИЕ БЛОКИ РЕЗУЛЬТАТОВ -->
                        <StackPanel Grid.Column="2">

                            <!-- БЛОК 1: ВЕКТОРНЫЙ РАЗРЕЗ ОТВЕРСТИЯ -->
                            <Border Background="#FAFAFA" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8"
                                    Height="225" Margin="0,0,0,12">
                                <Grid>
                                    <TextBlock Text="Схема глухого отверстия (разрез)" FontSize="11" Foreground="#78909C" Margin="10,6,0,0" VerticalAlignment="Top" />

                                    <Canvas Width="320" Height="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Visibility="{Binding HoleResult.IsValid, Converter={StaticResource BoolToVis}}">

                                        <!-- Тело детали вокруг отверстия -->
                                        <Polygon Points="{Binding HoleResult.PartBodyPoints}"
                                                 Fill="#1E455A64" Stroke="#455A64" StrokeThickness="1.5" StrokeLineJoin="Round" />

                                        <!-- Контур просверленного отверстия -->
                                        <Polyline Points="{Binding HoleResult.HoleOutlinePoints}"
                                                  Stroke="{Binding HoleResult.HoleStrokeBrush}"
                                                  StrokeThickness="2.5" StrokeLineJoin="Round" />

                                        <!-- Линия перехода цилиндра в заборный конус -->
                                        <Line X1="{Binding HoleResult.ShoulderLineX1}" Y1="{Binding HoleResult.ShoulderLineY1}"
                                              X2="{Binding HoleResult.ShoulderLineX2}" Y2="{Binding HoleResult.ShoulderLineY2}"
                                              Stroke="#00897B" StrokeThickness="1.2" StrokeDashArray="3 2" />

                                        <!-- Осевая линия отверстия -->
                                        <Line X1="{Binding HoleResult.AxisLineX1}" Y1="{Binding HoleResult.AxisLineY1}"
                                              X2="{Binding HoleResult.AxisLineX2}" Y2="{Binding HoleResult.AxisLineY2}"
                                              Stroke="#D32F2F" StrokeThickness="1" StrokeDashArray="8 3 1 3" />

                                        <!-- Зелёная базовая линия Z0 на торце -->
                                        <Line X1="{Binding HoleResult.ZeroLineX1}" Y1="{Binding HoleResult.ZeroLineY1}"
                                              X2="{Binding HoleResult.ZeroLineX2}" Y2="{Binding HoleResult.ZeroLineY2}"
                                              Stroke="#2E7D32" StrokeThickness="1.2" StrokeDashArray="8 3 1 3" />

                                        <TextBlock Text="Z0"
                                                   Canvas.Left="{Binding HoleResult.ZeroLabelX}"
                                                   Canvas.Top="{Binding HoleResult.ZeroLabelY}"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />

                                        <!-- Размерная и выносные линии полной глубины L -->
                                        <Line X1="{Binding HoleResult.DimLineLX1}" Y1="{Binding HoleResult.DimLineLY1}"
                                              X2="{Binding HoleResult.DimLineLX2}" Y2="{Binding HoleResult.DimLineLY2}"
                                              Stroke="{Binding HoleResult.HoleStrokeBrush}" StrokeThickness="1.2" />
                                        <Path Data="{Binding HoleResult.ExtLinesLPoints}"
                                              Stroke="{Binding HoleResult.HoleStrokeBrush}" StrokeThickness="1.1" />

                                        <!-- Размерная и выносные линии высоты конуса h -->
                                        <Line X1="{Binding HoleResult.DimLineHX1}" Y1="{Binding HoleResult.DimLineHY1}"
                                              X2="{Binding HoleResult.DimLineHX2}" Y2="{Binding HoleResult.DimLineHY2}"
                                              Stroke="#E65100" StrokeThickness="1.2" />
                                        <Path Data="{Binding HoleResult.ExtLinesHPoints}"
                                              Stroke="#E65100" StrokeThickness="1.1" />

                                        <!-- Размерная и выносные линии цилиндрической части L_ц -->
                                        <Line X1="{Binding HoleResult.DimLineCylX1}" Y1="{Binding HoleResult.DimLineCylY1}"
                                              X2="{Binding HoleResult.DimLineCylX2}" Y2="{Binding HoleResult.DimLineCylY2}"
                                              Stroke="#00897B" StrokeThickness="1.2" />
                                        <Path Data="{Binding HoleResult.ExtLinesCylPoints}"
                                              Stroke="#00897B" StrokeThickness="1.1" />
                                        <TextBlock Text="{Binding HoleResult.CylDepthLabelText}"
                                                   Canvas.Left="{Binding HoleResult.LabelCylX}"
                                                   Canvas.Top="{Binding HoleResult.LabelCylY}"
                                                   FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#00695C" />

                                        <!-- Подпись диаметра отверстия ØD -->
                                        <TextBlock Text="{Binding HoleResult.DiameterLabelText}"
                                                   Canvas.Left="{Binding HoleResult.LabelDiamX}"
                                                   Canvas.Top="{Binding HoleResult.LabelDiamY}"
                                                   FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#263238" />

                                        <!-- Подпись высоты конуса h -->
                                        <TextBlock Text="{Binding HoleResult.ConeHeightLabelText}"
                                                   Canvas.Left="{Binding HoleResult.LabelConeX}"
                                                   Canvas.Top="{Binding HoleResult.LabelConeY}"
                                                   FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#E65100" />

                                        <!-- Подпись полной глубины L -->
                                        <TextBlock Text="{Binding HoleResult.TotalDepthLabelText}"
                                                   Canvas.Left="{Binding HoleResult.LabelTotalX}"
                                                   Canvas.Top="{Binding HoleResult.LabelTotalY}"
                                                   FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{Binding HoleResult.HoleStrokeBrush}" />
                                    </Canvas>
                                </Grid>
                            </Border>

                            <!-- БЛОК 2: ВЫСОТА КОНУСА И РАЗМЕРЫ ОТВЕРСТИЯ -->
                            <Border Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock Text="Высота заборного конуса h:" FontSize="13" FontWeight="SemiBold" Foreground="#37474F" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding HoleResult.ConeHeight, StringFormat='{}{0:0.###} мм'}"
                                               FontSize="15" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right" />
                                </DockPanel>
                            </Border>

                            <Border Background="#F5F7F8" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Cursor="">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Длина цилиндрической части L_цил:" FontSize="13" Foreground="#37474F" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding HoleResult.CylindricalDepth, StringFormat='{}{0:0.###} мм'}"
                                                   FontSize="14" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Полная глубина по кончику L_полн:" FontSize="13" Foreground="#37474F" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding HoleResult.TotalDepth, StringFormat='{}{0:0.###} мм'}"
                                                   FontSize="14" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <Separator Margin="0,2,0,6" />

                                    <DockPanel>
                                        <TextBlock Text="Конечная координата Z_кон:" FontSize="13" FontWeight="SemiBold" Foreground="#37474F" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding HoleResult.EndZ, StringFormat='{}{0:0.###} мм'}"
                                                   FontSize="14.5" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <Separator Margin="0,6,0,6" />

                                    <DockPanel>
                                        <TextBlock Text="Машинное время сверления T_м (G81):" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding HoleResult.MachiningTimeText}"
                                                   FontSize="14" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- БЛОК 3: ДВОЙНОЙ БЛОК ЦИКЛОВ СВЕРЛЕНИЯ (G81 И G83) -->
                            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <!-- Вариант 1: Простое сверление G81 -->
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Command="{Binding CopyHoleG81Command}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="28" Padding="8,0" VerticalAlignment="Center" Cursor="Hand"
                                                ToolTip="Скопировать цикл G81">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="G81" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Простое сверление (G81):" FontSize="11" Foreground="#2E7D32" />
                                            <TextBlock Text="{Binding HoleResult.G81Snippet}"
                                                       FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#1B5E20" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Separator Margin="0,0,0,8" />

                                    <!-- Вариант 2: Глубокое сверление с выводом стружки G83 -->
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding CopyHoleG83Command}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="28" Padding="8,0" VerticalAlignment="Center" Cursor="Hand"
                                                ToolTip="Скопировать цикл G83">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="G83" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Глубокое сверление (G83, Q = 0.5·D):" FontSize="11" Foreground="#2E7D32" />
                                            <TextBlock Text="{Binding HoleResult.G83Snippet}"
                                                       FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#1B5E20" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- КАРТОЧКА 4: ЕДИНЫЙ РЕШАТЕЛЬ «ТОКАРНЫЙ КОНУС ЧПУ / ПРЯМОУГОЛЬНЫЙ ТРЕУГОЛЬНИК» -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="4. Расчёт токарных конусов ЧПУ и прямоугольных треугольников"
                                   FontSize="16" FontWeight="Bold" Foreground="#263238" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" Background="#ECEFF1" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding Card4BadgeText}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#37474F" />
                        </Border>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ЛЕВАЯ КОЛОНКА: ПЕРЕКЛЮЧАТЕЛЬ РЕЖИМА И ВВОД ПАРАМЕТРОВ -->
                        <StackPanel Grid.Column="0">

                            <!-- БЛОК 1: ГЛАВНЫЙ СЛАЙДЕР РЕЖИМА КАРТОЧКИ -->
                            <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Токарный конус ЧПУ" FontSize="12.5" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsTriangleMode, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                    <TextBlock Grid.Column="2" Text="Прямоугольный треугольник" FontSize="12.5" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- БЛОК 2: ПАРАМЕТРЫ ТОКАРНОГО КОНУСА ЧПУ -->
                            <StackPanel Visibility="{Binding IsConeMode, Converter={StaticResource BoolToVis}}">

                                <!-- 3 геометрических слайдера конуса -->
                                <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="На увеличение X" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsConeDecreasingX, Mode=TwoWay}" IsEnabled="{Binding IsConeXDirectionEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                            <TextBlock Grid.Column="2" Text="На уменьшение X" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Справа налево" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsConeLeftToRight, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                            <TextBlock Grid.Column="2" Text="Слева направо" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Вал (наруж.)" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsConeHole, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                            <TextBlock Grid.Column="2" Text="Отверстие (внутр.)" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Выбор способа расчёта конуса -->
                                <TextBlock Text="Что известно по чертежу:" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6" />
                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <Button Content="D_нач, D_кон, L" Command="{Binding SelectConeSolveKindCommand}" CommandParameter="ByTwoDiametersAndLength"
                                            Background="{Binding ConeKind1Bg}" Foreground="{Binding ConeKind1Fg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="D_нач, L, угол α" Command="{Binding SelectConeSolveKindCommand}" CommandParameter="ByStartDiameterLengthAndAngle"
                                            Background="{Binding ConeKind2Bg}" Foreground="{Binding ConeKind2Fg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="D_нач, D_кон, угол α" Command="{Binding SelectConeSolveKindCommand}" CommandParameter="ByTwoDiametersAndAngle"
                                            Background="{Binding ConeKind3Bg}" Foreground="{Binding ConeKind3Fg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0" Padding="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand" />
                                </UniformGrid>

                                <!-- Быстрые пресеты стандартных конусностей -->
                                <TextBlock Text="Быстрый выбор стандартной конусности (1 : N):" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6" />
                                <UniformGrid Columns="4" Margin="0,0,0,12">
                                    <Button Content="1 : 5" Command="{Binding SelectConicityPresetCommand}" CommandParameter="5"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Margin="0,0,4,0" Padding="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" />
                                    <Button Content="1 : 10" Command="{Binding SelectConicityPresetCommand}" CommandParameter="10"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Margin="0,0,4,0" Padding="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" />
                                    <Button Content="1 : 20" Command="{Binding SelectConicityPresetCommand}" CommandParameter="20"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Margin="0,0,4,0" Padding="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" />
                                    <Button Content="1 : 50" Command="{Binding SelectConicityPresetCommand}" CommandParameter="50"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Margin="0" Padding="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" />
                                </UniformGrid>

                                <!-- Инструментальные конусы Морзе (ГОСТ 25557) и 7:24 (ГОСТ 15945) -->
                                <TextBlock Text="Инструментальные конусы (Морзе / ISO):" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6" />
                                <UniformGrid Columns="6" Margin="0,0,0,12">
                                    <Button Content="КМ1" Command="{Binding SelectConicityPresetCommand}" CommandParameter="20.047"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Margin="0,0,3,0" Padding="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                                            ToolTip="Конус Морзе №1 (1 : 20.047)" />
                                    <Button Content="КМ2" Command="{Binding SelectConicityPresetCommand}" CommandParameter="20.020"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Margin="0,0,3,0" Padding="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                                            ToolTip="Конус Морзе №2 (1 : 20.020)" />
                                    <Button Content="КМ3" Command="{Binding SelectConicityPresetCommand}" CommandParameter="19.922"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Margin="0,0,3,0" Padding="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                                            ToolTip="Конус Морзе №3 (1 : 19.922)" />
                                    <Button Content="КМ4" Command="{Binding SelectConicityPresetCommand}" CommandParameter="19.254"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Margin="0,0,3,0" Padding="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                                            ToolTip="Конус Морзе №4 (1 : 19.254)" />
                                    <Button Content="КМ5" Command="{Binding SelectConicityPresetCommand}" CommandParameter="19.002"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Margin="0,0,3,0" Padding="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                                            ToolTip="Конус Морзе №5 (1 : 19.002)" />
                                    <Button Content="7 : 24" Command="{Binding SelectConicityPresetCommand}" CommandParameter="3.42857"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Margin="0" Padding="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                                            ToolTip="Инструментальный конус 7:24 (ISO 30/40/50)" />
                                </UniformGrid>

                                <!-- Поля ввода размеров конуса -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding ConeStartDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                             core:NumericInputBehavior.IsDecimal="True"
                                             materialDesign:HintAssist.Hint="Нач. диаметр D_нач (мм)"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                    <TextBox Grid.Column="2"
                                             Text="{Binding ConeEndDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsConeEndDiameterEnabled}"
                                             core:NumericInputBehavior.IsDecimal="True"
                                             materialDesign:HintAssist.Hint="Кон. диаметр D_кон (мм)"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding ConeLengthText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsConeLengthEnabled}"
                                             core:NumericInputBehavior.IsDecimal="True"
                                             materialDesign:HintAssist.Hint="Длина конуса L (мм)"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                    <TextBox Grid.Column="2"
                                             Text="{Binding ConeSlopeAngleText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsConeAngleEnabled}"
                                             core:NumericInputBehavior.IsDecimal="True"
                                             materialDesign:HintAssist.Hint="Угол уклона α (°)"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                                </Grid>

                                <TextBox Text="{Binding ConeStartZText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Начальная координата Z_нач (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" Margin="0,0,0,10" />

                                <!-- Настройка рабочей подачи F и автоподбора по материалу -->
                                <Border Background="#F5F7F8" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox Content="Учитывать рабочую подачу F в кадрах G01"
                                                  IsChecked="{Binding UseConeFeed, Mode=TwoWay}"
                                                  FontSize="12.5" Cursor="Hand" />

                                        <CheckBox Content="Автоматически подобрать подачу по материалу"
                                                  IsChecked="{Binding AutoCalculateConeFeed, Mode=TwoWay}"
                                                  IsEnabled="{Binding UseConeFeed}"
                                                  FontSize="12.5" Margin="0,6,0,0" Cursor="Hand" />
                                    </StackPanel>
                                </Border>

                                <!-- Выбор группы ISO 513 и конкретной марки (видим при включённом автоподборе) -->
                                <StackPanel Visibility="{Binding AutoCalculateConeFeed, Converter={StaticResource BoolToVis}}"
                                            IsEnabled="{Binding IsConeMaterialSelectorActive}"
                                            Margin="0,0,0,6" Cursor="">

                                    <!-- 6 цветных кнопок групп ISO -->
                                    <ItemsControl ItemsSource="{Binding IsoGroups}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectConeIsoGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{Binding BadgeColor}"
                                                        BorderBrush="{Binding BadgeColor}"
                                                        Foreground="White"
                                                        Height="32" Margin="0,0,4,0" Padding="0"
                                                        FontSize="13.5" FontWeight="Bold" Cursor="Hand"
                                                        ToolTip="{Binding Name}">
                                                    <TextBlock Text="{Binding CodeLetter}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Бейдж выбранной группы ISO -->
                                    <Border Background="{Binding SelectedConeIsoGroup.BadgeBackground}"
                                            BorderBrush="{Binding SelectedConeIsoGroup.BadgeColor}"
                                            BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{Binding SelectedConeIsoGroup.BadgeColor}" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding SelectedConeIsoGroup.CodeLetter}" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding SelectedConeIsoGroup.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Выпадающий список марок выбранной группы ISO -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding FilteredConeGrades}"
                                                  SelectedItem="{Binding SelectedConeMaterial}"
                                                  materialDesign:HintAssist.Hint="Конкретная марка (необязательно)"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding GostGrade}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding DinGrade, StringFormat='({0})'}" Foreground="#78909C" FontSize="11.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Button Grid.Column="1"
                                                Content="✕"
                                                Command="{Binding ClearConeGradeCommand}"
                                                Visibility="{Binding HasSelectedConeMaterial, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Width="36" Height="36" Padding="0" Margin="8,0,0,0"
                                                ToolTip="Сбросить выбор марки (считать по группе ISO)"
                                                Cursor="Hand" />
                                    </Grid>
                                    <!-- Пресеты интенсивности режимов (Щадящий / Оптимальный / Форсированный) -->
                                    <TextBlock Text="Интенсивность режимов:" FontSize="12" Foreground="#546E7A" Margin="0,10,0,6" />
                                    <UniformGrid Columns="3" Margin="0,0,0,6">
                                        <Button Content="Щадящий" Command="{Binding SelectConeIntensityCommand}" CommandParameter="Gentle"
                                                Background="{Binding ConeGentleBg}" Foreground="{Binding ConeGentleFg}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                        <Button Content="Оптимальный" Command="{Binding SelectConeIntensityCommand}" CommandParameter="Optimal"
                                                Background="{Binding ConeOptimalBg}" Foreground="{Binding ConeOptimalFg}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                        <Button Content="Форсированный" Command="{Binding SelectConeIntensityCommand}" CommandParameter="Aggressive"
                                                Background="{Binding ConeAggressiveBg}" Foreground="{Binding ConeAggressiveFg}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    </UniformGrid>
                                    <TextBlock Text="{Binding ConeIntensityNote}"
                                               FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="2,0,0,4" />
                                </StackPanel>

                                <TextBlock Text="{Binding ConeFeedAutoNote}"
                                           Visibility="{Binding AutoCalculateConeFeed, Converter={StaticResource BoolToVis}}"
                                           FontSize="11.5" Foreground="#1565C0" TextWrapping="Wrap" Margin="2,0,0,10" />

                                <!-- Поля рабочей подачи F (мм/об) и оборотов шпинделя S (об/мин) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding ConeFeedRateText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding UseConeFeed}"
                                             IsReadOnly="{Binding AutoCalculateConeFeed}"
                                             core:NumericInputBehavior.IsDecimal="True"
                                             materialDesign:HintAssist.Hint="Подача F на конусе (мм/об)"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             MaxLength="7"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             FontSize="14" Padding="10,8" />

                                    <TextBox Grid.Column="2"
                                             Text="{Binding ConeSpindleRpmText, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding AutoCalculateConeFeed}"
                                             core:NumericInputBehavior.IsInteger="True"
                                             materialDesign:HintAssist.Hint="Обороты шпинделя S (об/мин)"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             MaxLength="6"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            FontSize="14" Padding="10,8" />
                                </Grid>
                            </StackPanel>

                            <!-- БЛОК 3: ПАРАМЕТРЫ ПРЯМОУГОЛЬНОГО ТРЕУГОЛЬНИКА -->
                            <StackPanel Visibility="{Binding IsTriangleMode, Converter={StaticResource BoolToVis}}">

                                <TextBlock Text="Выберите два известных параметра треугольника:" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6" />
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Button Content="Катеты a и b" Command="{Binding SelectTriangleKindCommand}" CommandParameter="TwoLegs"
                                            Background="{Binding TriKind1Bg}" Foreground="{Binding TriKind1Fg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Катет a, гипот. c" Command="{Binding SelectTriangleKindCommand}" CommandParameter="LegAndHypotenuse"
                                            Background="{Binding TriKind2Bg}" Foreground="{Binding TriKind2Fg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Катет a, угол α" Command="{Binding SelectTriangleKindCommand}" CommandParameter="LegAndOppositeAngle"
                                            Background="{Binding TriKind3Bg}" Foreground="{Binding TriKind3Fg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0" Padding="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand" />
                                </UniformGrid>

                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <Button Content="Катет a, прилеж. угол β" Command="{Binding SelectTriangleKindCommand}" CommandParameter="LegAndAdjacentAngle"
                                            Background="{Binding TriKind4Bg}" Foreground="{Binding TriKind4Fg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0,0,4,0" Padding="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Гипотенуза c и угол α" Command="{Binding SelectTriangleKindCommand}" CommandParameter="HypotenuseAndAngle"
                                            Background="{Binding TriKind5Bg}" Foreground="{Binding TriKind5Fg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Margin="0" Padding="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand" />
                                </UniformGrid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding TriangleParam1Text, UpdateSourceTrigger=PropertyChanged}"
                                             core:NumericInputBehavior.IsDecimal="True"
                                             materialDesign:HintAssist.Hint="{Binding TriangleParam1Hint}"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                    <TextBox Grid.Column="2"
                                             Text="{Binding TriangleParam2Text, UpdateSourceTrigger=PropertyChanged}"
                                             core:NumericInputBehavior.IsDecimal="True"
                                             materialDesign:HintAssist.Hint="{Binding TriangleParam2Hint}"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                                </Grid>
                            </StackPanel>

                            <!-- Предупреждения и ошибки -->
                            <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                    Visibility="{Binding TriangleResult.HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TriangleResult.WarningMessage}" Foreground="#E65100" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding TriangleResult.ErrorMessage}" Foreground="#C62828" FontSize="12.5" TextWrapping="Wrap" Margin="2,0,0,0" />
                        </StackPanel>

                        <!-- ПРАВАЯ КОЛОНКА: ВЕРХНИЙ ЭСКИЗ И НИЖНИЕ БЛОКИ РЕЗУЛЬТАТОВ -->
                        <StackPanel Grid.Column="2">

                            <!-- БЛОК 4: ВЕКТОРНЫЙ ЭСКИЗ ДЛЯ ОБОИХ РЕЖИМОВ -->
                            <Border Background="#FAFAFA" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8"
                                    Height="225" Margin="0,0,0,12">
                                <Grid>
                                    <TextBlock Text="Геометрический эскиз" FontSize="11" Foreground="#78909C" Margin="10,6,0,0" VerticalAlignment="Top" />

                                    <Canvas Width="320" Height="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Visibility="{Binding TriangleResult.IsValid, Converter={StaticResource BoolToVis}}">

                                        <!-- СЛОЙ 1: ЭСКИЗ ТОКАРНОГО КОНУСА ЧПУ -->
                                        <Canvas Width="320" Height="200"
                                                Visibility="{Binding IsConeMode, Converter={StaticResource BoolToVis}}">

                                            <!-- Тело заготовки -->
                                            <Polygon Points="{Binding TriangleResult.ConePartBodyPoints}" Fill="#1E455A64" />
                                            <Polyline Points="{Binding TriangleResult.ConePartOutlinePoints}" Stroke="#455A64" StrokeThickness="1.5" StrokeLineJoin="Round" />

                                            <!-- Зелёные оси ноля детали X0 и Z0 -->
                                            <Line X1="10" Y1="{Binding TriangleResult.CenterLineY}" X2="310" Y2="{Binding TriangleResult.CenterLineY}"
                                                  Stroke="#2E7D32" StrokeThickness="1.2" StrokeDashArray="8 3 1 3" />
                                            <TextBlock Text="X0" Canvas.Left="8" Canvas.Top="{Binding TriangleResult.CenterLineY}"
                                                       Margin="0,-14,0,0" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />

                                            <Line X1="{Binding TriangleResult.ZeroLineX}" Y1="12" X2="{Binding TriangleResult.ZeroLineX}" Y2="188"
                                                  Stroke="#2E7D32" StrokeThickness="1.2" StrokeDashArray="8 3 1 3" />
                                            <TextBlock Text="Z0" Canvas.Left="{Binding TriangleResult.ZeroLineX}" Canvas.Top="12"
                                                       Margin="4,0,0,0" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />

                                            <!-- Образующая конуса (траектория G01) -->
                                            <Line X1="{Binding TriangleResult.CanvasStartX}" Y1="{Binding TriangleResult.CanvasStartY}"
                                                  X2="{Binding TriangleResult.CanvasEndX}" Y2="{Binding TriangleResult.CanvasEndY}"
                                                  Stroke="{Binding TriangleResult.ConeStrokeBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                            <!-- Вынесенный вектор подачи G01 -->
                                            <Line X1="{Binding TriangleResult.FeedVectorStartX}" Y1="{Binding TriangleResult.FeedVectorStartY}"
                                                  X2="{Binding TriangleResult.FeedVectorEndX}" Y2="{Binding TriangleResult.FeedVectorEndY}"
                                                  Stroke="{Binding TriangleResult.ConeStrokeBrush}" StrokeThickness="1.8" />
                                            <Polygon Points="{Binding TriangleResult.FeedArrowHeadPoints}" Fill="{Binding TriangleResult.ConeStrokeBrush}" />

                                            <!-- Точки начала и конца конуса -->
                                            <Ellipse Width="7" Height="7" Fill="#2E7D32"
                                                     Canvas.Left="{Binding TriangleResult.CanvasStartX}" Canvas.Top="{Binding TriangleResult.CanvasStartY}" Margin="-3.5,-3.5,0,0" />
                                            <Ellipse Width="7" Height="7" Fill="{Binding TriangleResult.ConeStrokeBrush}"
                                                     Canvas.Left="{Binding TriangleResult.CanvasEndX}" Canvas.Top="{Binding TriangleResult.CanvasEndY}" Margin="-3.5,-3.5,0,0" />

                                            <!-- Подписи координат -->
                                            <TextBlock Text="{Binding TriangleResult.StartLabelText}"
                                                       Canvas.Left="{Binding TriangleResult.LabelStartX}" Canvas.Top="{Binding TriangleResult.LabelStartY}"
                                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />
                                            <TextBlock Text="{Binding TriangleResult.EndLabelText}"
                                                       Canvas.Left="{Binding TriangleResult.LabelEndX}" Canvas.Top="{Binding TriangleResult.LabelEndY}"
                                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{Binding TriangleResult.ConeStrokeBrush}" />
                                        </Canvas>

                                        <!-- СЛОЙ 2: ЭСКИЗ ПРЯМОУГОЛЬНОГО ТРЕУГОЛЬНИКА -->
                                        <Canvas Width="320" Height="200"
                                                Visibility="{Binding IsTriangleMode, Converter={StaticResource BoolToVis}}">

                                            <!-- Заливка и контур прямоугольного треугольника -->
                                            <Polygon Points="{Binding TriangleResult.TrianglePolygonPoints}"
                                                     Fill="#1A1565C0" Stroke="#1565C0" StrokeThickness="2.2" StrokeLineJoin="Round" />

                                            <!-- Значок прямого угла 90° -->
                                            <Polyline Points="{Binding TriangleResult.RightAngleMarkPoints}"
                                                      Stroke="#D32F2F" StrokeThickness="1.4" />

                                            <!-- Подписи сторон a, b, c и угла α -->
                                            <TextBlock Text="{Binding TriangleResult.SideALabelText}"
                                                       Canvas.Left="{Binding TriangleResult.LabelSideAX}" Canvas.Top="{Binding TriangleResult.LabelSideAY}"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#263238" />
                                            <TextBlock Text="{Binding TriangleResult.SideBLabelText}"
                                                       Canvas.Left="{Binding TriangleResult.LabelSideBX}" Canvas.Top="{Binding TriangleResult.LabelSideBY}"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#263238" />
                                            <TextBlock Text="{Binding TriangleResult.HypCLabelText}"
                                                       Canvas.Left="{Binding TriangleResult.LabelHypCX}" Canvas.Top="{Binding TriangleResult.LabelHypCY}"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#1565C0" />
                                            <TextBlock Text="{Binding TriangleResult.AngleAlphaLabelText}"
                                                       Canvas.Left="{Binding TriangleResult.LabelAlphaX}" Canvas.Top="{Binding TriangleResult.LabelAlphaY}"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#E65100" />
                                        </Canvas>

                                    </Canvas>
                                </Grid>
                            </Border>

                            <!-- БЛОК 5: РЕЗУЛЬТАТЫ И КАДР G01 (РЕЖИМ «ТОКАРНЫЙ КОНУС ЧПУ») -->
                            <StackPanel Visibility="{Binding IsConeMode, Converter={StaticResource BoolToVis}}">
                                <Border Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock Text="Угол уклона α (половина угла конуса):" FontSize="13" FontWeight="SemiBold" Foreground="#37474F" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.ConeSlopeAngleDeg, StringFormat='{}{0:0.###}°'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </Border>

                                <Border Background="#F5F7F8" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Полный угол конуса 2α:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.ConeFullAngleDeg, StringFormat='{}{0:0.###}°'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <!-- Зелёный бейдж при совпадении со стандартным конусом -->
                                        <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,0,0,8"
                                                Visibility="{Binding TriangleResult.HasStandardConeMatch, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding TriangleResult.StandardConeMatchText}"
                                                       FontSize="12" FontWeight="Bold" Foreground="#2E7D32" TextWrapping="Wrap" />
                                        </Border>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Конусность K (1 : N):" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.ConicityRatioText}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="В других единицах:" FontSize="12" Foreground="#546E7A" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.ConicityMultiUnitsText}"
                                                       FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Уклон S (на сторону):" FontSize="12.5" Foreground="#546E7A" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.SlopeMultiUnitsText}"
                                                       FontSize="12.5" FontWeight="SemiBold" Foreground="#37474F" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Длина образующей (гипотенуза):" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.ConeGeneratrixLength, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <Separator Margin="0,2,0,6" />

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Точка начала конуса:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" FontSize="13.5" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="X{0:0.###}   Z{1:0.###}">
                                                        <Binding Path="TriangleResult.ConeStartDiameter" />
                                                        <Binding Path="TriangleResult.ConeStartZ" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DockPanel>

                                        <DockPanel>
                                            <TextBlock Text="Точка конца конуса:" FontSize="13" FontWeight="SemiBold" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" FontSize="14" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="X{0:0.###}   Z{1:0.###}">
                                                        <Binding Path="TriangleResult.ConeEndDiameter" />
                                                        <Binding Path="TriangleResult.ConeEndZ" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DockPanel>
                                        <Separator Margin="0,6,0,6" />

                                        <DockPanel>
                                            <TextBlock Text="Машинное время прохода T_м:" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.MachiningTimeText}"
                                                            FontSize="14" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Готовый фрагмент УП (кадр G01) с копированием -->
                                <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding CopyConeGCodeCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="30" Padding="10,0" VerticalAlignment="Center" Cursor="Hand"
                                                ToolTip="Скопировать кадры G01 для стойки ЧПУ">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="G-код" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="Управляющая программа (G01):" FontSize="11" Foreground="#2E7D32" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding TriangleResult.ConeGCodeSnippet}"
                                                        FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#1B5E20" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- БЛОК 6: РЕЗУЛЬТАТЫ (РЕЖИМ «ПРЯМОУГОЛЬНЫЙ ТРЕУГОЛЬНИК») -->
                            <StackPanel Visibility="{Binding IsTriangleMode, Converter={StaticResource BoolToVis}}">
                                <Border Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock Text="Гипотенуза c:" FontSize="13.5" FontWeight="SemiBold" Foreground="#37474F" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.HypotenuseC, StringFormat='{}{0:0.###} мм'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </Border>

                                <Border Background="#F5F7F8" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Вертикальный катет a:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.SideA, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Горизонтальный катет b:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.SideB, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <Separator Margin="0,2,0,6" />

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Острый угол α (напротив катета a):" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.AngleAlphaDeg, StringFormat='{}{0:0.###}°'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Острый угол β (напротив катета b):" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.AngleBetaDeg, StringFormat='{}{0:0.###}°'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <Separator Margin="0,2,0,6" />

                                        <DockPanel>
                                            <TextBlock Text="Площадь прямоугольного треугольника S:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriangleResult.Area, StringFormat='{}{0:0.###} мм²'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- КАРТОЧКА 5: ПРЯМОУГОЛЬНЫЕ КАНАВКИ И ОТРЕЗКА С ЦИКЛОМ G75 -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="5. Расчёт прямоугольных канавок и отрезки с циклом G75"
                                   FontSize="16" FontWeight="Bold" Foreground="#263238" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" Background="#ECEFF1" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding Card5BadgeText}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#37474F" />
                        </Border>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="470" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ЛЕВАЯ КОЛОНКА: ПЕРЕКЛЮЧАТЕЛИ, ЧЕКБОКСЫ И ВВОД ПАРАМЕТРОВ -->
                        <StackPanel Grid.Column="0" Cursor="">
                            <!-- БЛОК 1: ГЛАВНЫЙ СЛАЙДЕР И СЛАЙДЕР НАПРАВЛЕНИЯ -->
                            <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Наружная канавка (G75)" FontSize="12.5" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsGroovePartOffMode, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                    <TextBlock Grid.Column="2" Text="Отрезка детали (G75)" FontSize="12.5" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>

                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Справа налево" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsGrooveLeftToRight, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                    <TextBlock Grid.Column="2" Text="Слева направо" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>


                            <!-- БЛОК 2: ОСНОВНЫЕ КООРДИНАТЫ И РЕЖИМЫ ЦИКЛА G75 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding GrooveStockDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Диаметр детали D_дет (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding GrooveBottomDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsGrooveChannelMode}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Диаметр дна D_дна (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding GrooveStartZText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="{Binding GrooveStartZHint}"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding GrooveEndZText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsGrooveChannelMode}"
                                         materialDesign:HintAssist.Hint="Конечная стенка Z_кон (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding GrooveApproachOffsetXText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Запас подвода по X (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding GrooveRetractRText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Величина отскока R (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding GrooveStepPMmText, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding AutoCalculateGrooveFeed}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Шаг P (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding GrooveFeedRateText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Подача F (мм/об)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         IsReadOnly="{Binding AutoCalculateGrooveFeed}"
                                         MaxLength="5"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="4"
                                         Text="{Binding GrooveSpindleRpmText, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding AutoCalculateGrooveFeed}"
                                         core:NumericInputBehavior.IsInteger="True"
                                         materialDesign:HintAssist.Hint="Обороты S (об/мин)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="6"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                            </Grid>

                            <!-- Автоподбор рабочей подачи F для G75 по материалу и ширине резца B -->
                            <Border Background="#F5F7F8" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Cursor="">
                                <CheckBox Content="Автоматически подобрать подачу F и шаг P по материалу"
                                          IsChecked="{Binding AutoCalculateGrooveFeed, Mode=TwoWay}"
                                          FontSize="12.5" Cursor="Hand" />
                            </Border>

                            <StackPanel Visibility="{Binding AutoCalculateGrooveFeed, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,6">

                                <!-- 6 цветных кнопок групп ISO -->
                                <ItemsControl ItemsSource="{Binding IsoGroups}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectGrooveIsoGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{Binding BadgeColor}"
                                                    BorderBrush="{Binding BadgeColor}"
                                                    Foreground="White"
                                                    Height="32" Margin="0,0,4,0" Padding="0"
                                                    FontSize="13.5" FontWeight="Bold" Cursor="Hand"
                                                    ToolTip="{Binding Name}">
                                                <TextBlock Text="{Binding CodeLetter}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Бейдж выбранной группы ISO -->
                                <Border Background="{Binding SelectedGrooveIsoGroup.BadgeBackground}"
                                        BorderBrush="{Binding SelectedGrooveIsoGroup.BadgeColor}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{Binding SelectedGrooveIsoGroup.BadgeColor}" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedGrooveIsoGroup.CodeLetter}" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedGrooveIsoGroup.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Выпадающий список марок выбранной группы ISO -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding FilteredGrooveGrades}"
                                              SelectedItem="{Binding SelectedGrooveMaterial}"
                                              materialDesign:HintAssist.Hint="Конкретная марка (необязательно)"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GostGrade}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding DinGrade, StringFormat='({0})'}" Foreground="#78909C" FontSize="11.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding ClearGrooveGradeCommand}"
                                            Visibility="{Binding HasSelectedGrooveMaterial, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Width="36" Height="36" Padding="0" Margin="8,0,0,0"
                                            ToolTip="Сбросить выбор марки (считать по группе ISO)"
                                            Cursor="Hand" />
                                </Grid>
                                <!-- Пресеты интенсивности режимов (Щадящий / Оптимальный / Форсированный) -->
                                <TextBlock Text="Интенсивность режимов:" FontSize="12" Foreground="#546E7A" Margin="0,10,0,6" />
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Button Content="Щадящий" Command="{Binding SelectGrooveIntensityCommand}" CommandParameter="Gentle"
                                            Background="{Binding GrooveGentleBg}" Foreground="{Binding GrooveGentleFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Оптимальный" Command="{Binding SelectGrooveIntensityCommand}" CommandParameter="Optimal"
                                            Background="{Binding GrooveOptimalBg}" Foreground="{Binding GrooveOptimalFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Форсированный" Command="{Binding SelectGrooveIntensityCommand}" CommandParameter="Aggressive"
                                            Background="{Binding GrooveAggressiveBg}" Foreground="{Binding GrooveAggressiveFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                </UniformGrid>
                                <TextBlock Text="{Binding GrooveIntensityNote}"
                                            FontSize="11.5" Foreground="#546E7A" TextWrapping="Wrap" Margin="2,0,0,4" Cursor="" />

                            </StackPanel>

                            <TextBlock Text="{Binding GrooveFeedAutoNote}"
                                       Visibility="{Binding AutoCalculateGrooveFeed, Converter={StaticResource BoolToVis}}"
                                       FontSize="11.5" Foreground="#1565C0" TextWrapping="Wrap" Margin="2,0,0,10" />


                            <!-- БЛОК 3: УЧЁТ ТОЛЩИНЫ РЕЗЦА (#N) И ПАРАМЕТРЫ ОТРЕЗКИ -->
                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel Cursor="">
                                    <CheckBox IsChecked="{Binding ConsiderGrooveToolWidth, Mode=TwoWay}"
                                              Content="Учитывать толщину резца (вывод в двух вариантах: числовой и с #)"
                                              FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" Margin="0,0,0,10" Cursor="Hand" />

                                    <StackPanel Visibility="{Binding ConsiderGrooveToolWidth, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Стандартная ширина пластины B:" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6" />
                                        <UniformGrid Columns="4" Margin="0,0,0,10">
                                            <Button Content="2 мм" Command="{Binding SelectGrooveToolWidthCommand}" CommandParameter="2"
                                                    Background="{Binding ToolW2Bg}" Foreground="{Binding ToolW2Fg}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                            <Button Content="3 мм" Command="{Binding SelectGrooveToolWidthCommand}" CommandParameter="3"
                                                    Background="{Binding ToolW3Bg}" Foreground="{Binding ToolW3Fg}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                            <Button Content="4 мм" Command="{Binding SelectGrooveToolWidthCommand}" CommandParameter="4"
                                                    Background="{Binding ToolW4Bg}" Foreground="{Binding ToolW4Fg}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                            <Button Content="5 мм" Command="{Binding SelectGrooveToolWidthCommand}" CommandParameter="5"
                                                    Background="{Binding ToolW5Bg}" Foreground="{Binding ToolW5Fg}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                        </UniformGrid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                     Text="{Binding GrooveToolWidthText, UpdateSourceTrigger=PropertyChanged}"
                                                     core:NumericInputBehavior.IsDecimal="True"
                                                     materialDesign:HintAssist.Hint="Толщина резца B (мм)"
                                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                     MaxLength="4" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                            <TextBox Grid.Column="2"
                                                     Text="{Binding GrooveMacroVarNumberText, UpdateSourceTrigger=PropertyChanged}"
                                                     core:NumericInputBehavior.IsInteger="True"
                                                     materialDesign:HintAssist.Hint="Номер переменной (#)"
                                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                     MaxLength="6" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- БЛОК ЧИСТОВОЙ ОБРАБОТКИ КОНТУРА КАНАВКИ (ТОЛЬКО В РЕЖИМЕ НАРУЖНОЙ КАНАВКИ) -->
                            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                                    Visibility="{Binding IsGrooveChannelMode, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding IncludeGrooveFinishPass, Mode=TwoWay}"
                                              Content="Добавить чистовой проход по стенкам и дну (G01)"
                                                FontSize="12.5" FontWeight="SemiBold" Foreground="#1B5E20" Cursor="Hand" />

                                    <StackPanel Visibility="{Binding IncludeGrooveFinishPass, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">

                                        <!-- Переключатель: Без припуска (быстрая зачистка дна) / С припуском (стенки и дно) -->
                                        <Border Background="#FFFFFF" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Без припуска (дно)" FontSize="12" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsGrooveFinishWithAllowance, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                                <TextBlock Grid.Column="2" Text="С припуском (стенки+дно)" FontSize="12" FontWeight="SemiBold" Foreground="#1B5E20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>

                                        <!-- Поля припусков (показываются только при выборе "С припуском") -->
                                        <StackPanel Visibility="{Binding IsGrooveFinishWithAllowance, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Припуски, оставляемые циклом G75 под чистовой проход:" FontSize="11.5" Foreground="#2E7D32" Margin="0,0,0,8" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0"
                                                        Text="{Binding GrooveFinishAllowanceXText, UpdateSourceTrigger=PropertyChanged}"
                                                        core:NumericInputBehavior.IsDecimal="True"
                                                        materialDesign:HintAssist.Hint="Припуск по дну ΔX (на стор., мм)"
                                                        materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                         MaxLength="5" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="13.5" Padding="10,8" />

                                                <TextBox Grid.Column="2"
                                                        Text="{Binding GrooveFinishAllowanceZText, UpdateSourceTrigger=PropertyChanged}"
                                                        core:NumericInputBehavior.IsDecimal="True"
                                                        materialDesign:HintAssist.Hint="Припуск на стенки ΔZ (мм)"
                                                        materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                        MaxLength="5" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="13.5" Padding="10,8" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Дополнительные опции режима "Отрезка детали (G75)" -->
                            <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                                    Visibility="{Binding IsGroovePartOffMode, Converter={StaticResource BoolToVis}}">
                                <StackPanel Cursor="">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding UseGrooveAxisOvertravel, Mode=TwoWay}"
                                                  Content="Перебег за ось (переход через X0)"
                                                  FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center" Cursor="Hand" />

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding GrooveAxisOvertravelText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding UseGrooveAxisOvertravel}"
                                                 core:NumericInputBehavior.IsDecimal="True"
                                                 materialDesign:HintAssist.Hint="Перебег (мм)"
                                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                 MaxLength="3" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="13.5" Padding="8,6" />
                                    </Grid>

                                    <CheckBox IsChecked="{Binding ReduceGrooveFeedNearCenter, Mode=TwoWay}"
                                              Content="Снижать подачу в 2 раза к центру (дорезка G01 с Ø6 мм)"
                                              FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" Cursor="Hand" />
                                </StackPanel>
                            </Border>

                            <!-- Информационная подсказка (привязка кромки, число проходов) -->
                            <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                    Visibility="{Binding GrooveResult.HasInfo, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding GrooveResult.InfoMessage}" Foreground="#1565C0" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <!-- Предупреждения -->
                            <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                    Visibility="{Binding GrooveResult.HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding GrooveResult.WarningMessage}" Foreground="#E65100" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <!-- Ошибки ввода -->
                            <TextBlock Text="{Binding GrooveResult.ErrorMessage}" Foreground="#C62828" FontSize="12.5" TextWrapping="Wrap" Margin="2,0,0,0" />
                        </StackPanel>

                        <!-- ПРАВАЯ КОЛОНКА: ЭСКИЗ И БЛОКИ G-КОДА G75 -->
                        <StackPanel Grid.Column="2">

                            <!-- БЛОК 4: ВЕКТОРНЫЙ ЭСКИЗ КАНАВКИ / ОТРЕЗКИ G75 -->
                            <Border Background="#FAFAFA" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8"
                                    Height="225" Margin="0,0,0,12">
                                <Grid>
                                    <TextBlock Text="Схема обработки канавки / отрезки (G75)" FontSize="11" Foreground="#78909C" Margin="10,6,0,0" VerticalAlignment="Top" />

                                    <Canvas Width="320" Height="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Visibility="{Binding GrooveResult.IsValid, Converter={StaticResource BoolToVis}}">
                                        <!-- Слой чистового припуска по стенкам и дну канавки -->
                                        <Canvas Visibility="{Binding GrooveResult.ShowFinishAllowanceLayer, Converter={StaticResource BoolToVis}}">
                                            <Polygon Points="{Binding GrooveResult.FinishAllowancePolygonPoints}"
                                                      Fill="#4D4CAF50" />
                                            <Polyline Points="{Binding GrooveResult.RoughOutlinePoints}"
                                                     Stroke="#2E7D32" StrokeThickness="1.3" StrokeDashArray="3 2" />
                                        </Canvas>

                                        <!-- Тело вала с прямоугольной канавкой или прорезью отрезки -->
                                        <Polygon Points="{Binding GrooveResult.PartBodyPoints}" Fill="#1E455A64" />
                                        <Polyline Points="{Binding GrooveResult.PartOutlinePoints}" Stroke="#455A64" StrokeThickness="1.5" StrokeLineJoin="Round" />

                                        <!-- Зелёные оси ноля детали X0 и Z0 -->
                                        <Line X1="10" Y1="{Binding GrooveResult.CenterLineY}" X2="310" Y2="{Binding GrooveResult.CenterLineY}"
                                              Stroke="#2E7D32" StrokeThickness="1.2" StrokeDashArray="8 3 1 3" />
                                        <TextBlock Text="X0" Canvas.Left="8" Canvas.Top="{Binding GrooveResult.CenterLineY}"
                                                   Margin="0,-14,0,0" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />

                                        <Line X1="{Binding GrooveResult.ZeroLineX}" Y1="12" X2="{Binding GrooveResult.ZeroLineX}" Y2="188"
                                              Stroke="#2E7D32" StrokeThickness="1.2" StrokeDashArray="8 3 1 3" />
                                        <TextBlock Text="Z0" Canvas.Left="{Binding GrooveResult.ZeroLineX}" Canvas.Top="12"
                                                   Margin="4,0,0,0" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />

                                        <!-- Пластина канавочного / отрезного резца шириной B -->
                                        <Rectangle Canvas.Left="{Binding GrooveResult.ToolLeftX}"
                                                   Canvas.Top="{Binding GrooveResult.ToolTopY}"
                                                   Width="{Binding GrooveResult.ToolWidthPx}"
                                                   Height="{Binding GrooveResult.ToolHeightPx}"
                                                   Fill="#33EF6C00" Stroke="#EF6C00" StrokeThickness="1.5" RadiusX="1.5" RadiusY="1.5" />

                                        <!-- Траектория первого врезания G75 (стрелка вниз по X) -->
                                        <Line X1="{Binding GrooveResult.PlungeX}" Y1="{Binding GrooveResult.PlungeStartY}"
                                              X2="{Binding GrooveResult.PlungeX}" Y2="{Binding GrooveResult.PlungeEndY}"
                                              Stroke="{Binding GrooveResult.AccentBrush}" StrokeThickness="2.2" StrokeDashArray="4 2" />
                                        <Polygon Points="{Binding GrooveResult.PlungeArrowPoints}" Fill="{Binding GrooveResult.AccentBrush}" />

                                        <!-- Зелёная точка привязанной кромки резца -->
                                        <Ellipse Width="7" Height="7" Fill="#2E7D32"
                                                 Canvas.Left="{Binding GrooveResult.AnchorDotX}"
                                                 Canvas.Top="{Binding GrooveResult.AnchorDotY}"
                                                 Margin="-3.5,-3.5,0,0" />

                                        <TextBlock Text="{Binding GrooveResult.ZWallStartLabelText}"
                                                   Canvas.Left="{Binding GrooveResult.LabelZWallStartX}" Canvas.Top="{Binding GrooveResult.LabelZWallStartY}"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#455A64" />

                                        <!-- Подписи координат Z_старт, Z_кон и X_кон -->
                                        <TextBlock Text="{Binding GrooveResult.ZStartLabelText}"
                                                   Canvas.Left="{Binding GrooveResult.LabelZStartX}" Canvas.Top="{Binding GrooveResult.LabelZStartY}"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />
                                        <TextBlock Text="{Binding GrooveResult.ZEndLabelText}"
                                                   Canvas.Left="{Binding GrooveResult.LabelZEndX}" Canvas.Top="{Binding GrooveResult.LabelZEndY}"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#455A64" />
                                        <TextBlock Text="{Binding GrooveResult.BottomDiaLabelText}"
                                                   Canvas.Left="{Binding GrooveResult.LabelBottomDiaX}" Canvas.Top="{Binding GrooveResult.LabelBottomDiaY}"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{Binding GrooveResult.AccentBrush}" />

                                        <!-- Размерная линия ширины канавки W -->
                                        <Canvas Visibility="{Binding GrooveResult.ShowWidthDimension, Converter={StaticResource BoolToVis}}">
                                            <Line X1="{Binding GrooveResult.WidthDimLeftX}" Y1="{Binding GrooveResult.WidthDimY}"
                                                  X2="{Binding GrooveResult.WidthDimRightX}" Y2="{Binding GrooveResult.WidthDimY}"
                                                  Stroke="#1565C0" StrokeThickness="1.2" />
                                            <Polygon Points="{Binding GrooveResult.WidthLeftArrowPoints}" Fill="#1565C0" />
                                            <Polygon Points="{Binding GrooveResult.WidthRightArrowPoints}" Fill="#1565C0" />
                                            <TextBlock Text="{Binding GrooveResult.WidthLabelText}"
                                                       Canvas.Left="{Binding GrooveResult.LabelWidthX}" Canvas.Top="{Binding GrooveResult.LabelWidthY}"
                                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#1565C0" />

                                            <!-- Размерная линия ширины канавки W с выносными линиями -->
                                            <Canvas Visibility="{Binding GrooveResult.ShowWidthDimension, Converter={StaticResource BoolToVis}}">
                                                <Line X1="{Binding GrooveResult.WidthDimLeftX}" Y1="122"
                                                  X2="{Binding GrooveResult.WidthDimLeftX}" Y2="{Binding GrooveResult.WidthDimY}"
                                                  Stroke="#90CAF9" StrokeThickness="1" StrokeDashArray="2 2" />
                                                <Line X1="{Binding GrooveResult.WidthDimRightX}" Y1="122"
                                                  X2="{Binding GrooveResult.WidthDimRightX}" Y2="{Binding GrooveResult.WidthDimY}"
                                                  Stroke="#90CAF9" StrokeThickness="1" StrokeDashArray="2 2" />
                                                <Line X1="{Binding GrooveResult.WidthDimLeftX}" Y1="{Binding GrooveResult.WidthDimY}"
                                                  X2="{Binding GrooveResult.WidthDimRightX}" Y2="{Binding GrooveResult.WidthDimY}"
                                                  Stroke="#1565C0" StrokeThickness="1.2" />
                                                <Polygon Points="{Binding GrooveResult.WidthLeftArrowPoints}" Fill="#1565C0" />
                                                <Polygon Points="{Binding GrooveResult.WidthRightArrowPoints}" Fill="#1565C0" />
                                                <TextBlock Text="{Binding GrooveResult.WidthLabelText}"
                                                       Canvas.Left="{Binding GrooveResult.LabelWidthX}" Canvas.Top="{Binding GrooveResult.LabelWidthY}"
                                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#1565C0" />
                                                <!-- Вертикальная размерная линия глубины канавки t (на сторону) -->
                                                <Line X1="{Binding GrooveResult.DepthExtStartX}" Y1="{Binding GrooveResult.DepthDimTopY}"
                                                  X2="{Binding GrooveResult.DepthDimX}" Y2="{Binding GrooveResult.DepthDimTopY}"
                                                  Stroke="#90CAF9" StrokeThickness="1" StrokeDashArray="2 2" />
                                                <Line X1="{Binding GrooveResult.DepthExtStartX}" Y1="{Binding GrooveResult.DepthDimBottomY}"
                                                  X2="{Binding GrooveResult.DepthDimX}" Y2="{Binding GrooveResult.DepthDimBottomY}"
                                                  Stroke="#90CAF9" StrokeThickness="1" StrokeDashArray="2 2" />
                                                <Line X1="{Binding GrooveResult.DepthDimX}" Y1="{Binding GrooveResult.DepthDimTopY}"
                                                  X2="{Binding GrooveResult.DepthDimX}" Y2="{Binding GrooveResult.DepthDimBottomY}"
                                                  Stroke="#1565C0" StrokeThickness="1.2" />
                                                <Polygon Points="{Binding GrooveResult.DepthTopArrowPoints}" Fill="#1565C0" />
                                                <Polygon Points="{Binding GrooveResult.DepthBottomArrowPoints}" Fill="#1565C0" />
                                                <TextBlock Text="{Binding GrooveResult.DepthLabelText}"
                                                       Canvas.Left="{Binding GrooveResult.LabelDepthX}" Canvas.Top="{Binding GrooveResult.LabelDepthY}"
                                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#1565C0" />
                                            </Canvas>
                                        </Canvas>
                                    </Canvas>
                                </Grid>
                            </Border>

                            <!-- БЛОК 5: РЕЗУЛЬТАТЫ РАСЧЁТА И ВАРИАНТЫ G-КОДА G75 -->
                            <StackPanel Visibility="{Binding GrooveResult.IsValid, Converter={StaticResource BoolToVis}}">

                                <!-- Карточка расчётных координат и шагов -->
                                <Border Background="#F5F7F8" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Безопасный диаметр подвода (G00):" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GrooveResult.ApproachDiameterX, StringFormat='X{0:0.###}'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Конечный диаметр обработки:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GrooveResult.TargetDiameterX, StringFormat='X{0:0.###}'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Глубина врезания:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GrooveResult.RadialDepth, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6"
                                                   Visibility="{Binding IsGrooveChannelMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Ширина канавки W:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GrooveResult.GrooveWidthMm, StringFormat='{}{0:0.###} мм'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Вылет лезвия (мин / макс):" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GrooveResult.BladeOverhangRangeText}"
                                                       FontSize="13.5" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <Separator Margin="0,2,0,6" />

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Координаты обработки по оси Z:" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" FontSize="13.5" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="Z{0:0.###} → Z{1:0.###}">
                                                        <Binding Path="GrooveResult.ComputedStartZ" />
                                                        <Binding Path="GrooveResult.ComputedEndZ" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DockPanel>

                                        <DockPanel>
                                            <TextBlock Text="Параметры цикла Fanuc (P / Q):" FontSize="13" Foreground="#37474F" />
                                            <TextBlock DockPanel.Dock="Right" FontSize="13.5" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="P{0}   Q{1}">
                                                        <Binding Path="GrooveResult.StepPMicrons" />
                                                        <Binding Path="GrooveResult.StepQMicrons" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DockPanel>
                                        <Separator Margin="0,6,0,6" />

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Суммарный путь врезания L_рез:" FontSize="13" Foreground="#546E7A" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GrooveResult.TotalCuttingPathMm, StringFormat='{}{0:0.##} мм'}"
                                                        FontSize="13.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel>
                                            <TextBlock Text="Машинное время прохода T_м:" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GrooveResult.MachiningTimeText}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ВАРИАНТ 1: ОБЫЧНЫЙ ЧИСЛОВОЙ G-КОД G75 -->
                                <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding CopyGrooveStandardGCodeCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="30" Padding="10,0" VerticalAlignment="Center" Cursor="Hand"
                                                ToolTip="Скопировать обычный числовой G-код G75">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="G-код" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="Вариант 1 — обычный G-код" FontSize="11" Foreground="#2E7D32" />
                                            <TextBlock Text="(числовой расчёт):" FontSize="11" Foreground="#2E7D32" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding GrooveResult.StandardGCodeSnippet}"
                                                       FontFamily="Consolas" 
                                                       FontSize="13" 
                                                       FontWeight="Bold" 
                                                       Foreground="#1B5E20" 
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- ВАРИАНТ 2: ПАРАМЕТРИЧЕСКИЙ G-КОД С ПЕРЕМЕННОЙ #N (ТОЛЬКО ПРИ УЧЁТЕ ТОЛЩИНЫ РЕЗЦА) -->
                                <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="8" Padding="10"
                                        Visibility="{Binding GrooveResult.ConsiderToolWidth, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding CopyGrooveMacroGCodeCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="30" Padding="10,0" VerticalAlignment="Center" Cursor="Hand"
                                                ToolTip="Скопировать параметрический G-код с переменной #">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="G-код (#)" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="Вариант 2 — параметрический G-код" FontSize="11" Foreground="#1565C0" />
                                            <TextBlock Text="(с переменной #):" FontSize="11" Foreground="#1565C0" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding GrooveResult.MacroGCodeSnippet}"
                                                       FontFamily="Consolas" 
                                                       FontSize="13" 
                                                       FontWeight="Bold" 
                                                       Foreground="#0D47A1" 
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- КАРТОЧКА 6: СОПРЯЖЕНИЕ КОНУС — ЦИЛИНДР ДУГОЙ РАДИУСА R -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="6. Расчёт сопряжения «Конус — Цилиндр» дугой радиуса R"
                                   FontSize="16" FontWeight="Bold" Foreground="#263238" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" Background="#E3F2FD" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding Card6BadgeText}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#1565C0" />
                        </Border>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ЛЕВАЯ КОЛОНКА: ПЕРЕКЛЮЧАТЕЛИ И ВВОД ПАРАМЕТРОВ -->
                        <StackPanel Grid.Column="0">
                            <!-- БЛОК 1: ПЕРЕКЛЮЧАТЕЛИ ГЕОМЕТРИИ И РЕЗЦЕДЕРЖАТЕЛЯ -->
                            <Border Background="#F5F7F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Переключатель 1: Конус -> Цилиндр / Цилиндр -> Конус -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Конус → Цилиндр" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsBlendConcaveFillet, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Цилиндр → Конус (галтель)" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <!-- Переключатель 2: Справа налево / Слева направо -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Справа налево" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsBlendLeftToRight, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Слева направо" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <!-- Переключатель 3: Вал / Отверстие -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Вал (наружная)" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsBlendHole, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Отверстие (внутр.)" FontSize="12.5" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <Separator Margin="0,2,0,8" />

                                    <!-- Переключатель 4: Задний / Передний резцедержатель -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Задний резец" FontSize="12.5" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsBlendFrontTurret, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" Cursor="Hand" />
                                        <TextBlock Grid.Column="2" Text="Передний резец" FontSize="12.5" FontWeight="SemiBold" Foreground="#E65100" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- БЛОК 2: ПРЕСЕТЫ РАДИУСОВ R И ПОЛЯ ВВОДА -->
                            <TextBlock Text="Стандартные радиусы сопряжения R (ГОСТ 10948):" FontSize="12" Foreground="#546E7A" Margin="0,0,0,6" />
                            <UniformGrid Columns="6" Margin="0,0,0,12">
                                <Button Content="1" Command="{Binding SelectBlendRadiusCommand}" CommandParameter="1" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,3,0" Padding="0" FontSize="12" Cursor="Hand" />
                                <Button Content="1.6" Command="{Binding SelectBlendRadiusCommand}" CommandParameter="1.6" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,3,0" Padding="0" FontSize="12" Cursor="Hand" />
                                <Button Content="2" Command="{Binding SelectBlendRadiusCommand}" CommandParameter="2" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,3,0" Padding="0" FontSize="12" Cursor="Hand" />
                                <Button Content="3" Command="{Binding SelectBlendRadiusCommand}" CommandParameter="3" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,3,0" Padding="0" FontSize="12" Cursor="Hand" />
                                <Button Content="5" Command="{Binding SelectBlendRadiusCommand}" CommandParameter="5" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,3,0" Padding="0" FontSize="12" Cursor="Hand" />
                                <Button Content="8" Command="{Binding SelectBlendRadiusCommand}" CommandParameter="8" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0" Padding="0" FontSize="12" Cursor="Hand" />
                            </UniformGrid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding BlendCylinderDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Диаметр цилиндра D_цил (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding BlendCornerZText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Координата угла Z_угла (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="12" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding BlendConeAngleText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Угол уклона конуса α (°)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="10" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding BlendRadiusText, UpdateSourceTrigger=PropertyChanged}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Радиус сопряжения R (мм)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="10" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                            </Grid>

                            <!-- БЛОК 3 (ЧАСТЬ 1): КОМПЕНСАЦИЯ РАДИУСА ПЛАСТИНЫ И НАСТРОЙКА ПОДАЧИ -->
                            <Border Background="#F5F7F8" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox Content="Компенсировать радиус при вершине пластины r_ε (без G41/G42)"
                                              IsChecked="{Binding CompensateBlendToolNose, Mode=TwoWay}"
                                              FontSize="12" Cursor="Hand" />
                                    <TextBox Text="{Binding BlendToolNoseRadiusText, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding CompensateBlendToolNose, Converter={StaticResource BoolToVis}}"
                                             core:NumericInputBehavior.IsDecimal="True"
                                             materialDesign:HintAssist.Hint="Радиус при вершине пластины r_ε (мм)"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             MaxLength="6" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             FontSize="13.5" Padding="10,6" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#F5F7F8" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox Content="Учитывать рабочую подачу F в G-коде"
                                              IsChecked="{Binding UseBlendFeed, Mode=TwoWay}"
                                              FontSize="12.5" Cursor="Hand" />
                                    <CheckBox Content="Автоматически подобрать подачу по материалу"
                                              IsChecked="{Binding AutoCalculateBlendFeed, Mode=TwoWay}"
                                              IsEnabled="{Binding UseBlendFeed}"
                                              FontSize="12.5" Margin="0,6,0,0" Cursor="Hand" />
                                </StackPanel>
                            </Border>

                            <!-- БЛОК 3 (ЧАСТЬ 2): ВЫБОР ГРУППЫ ISO 513, МАРКИ СТАЛИ И ИНТЕНСИВНОСТИ -->
                            <StackPanel Visibility="{Binding AutoCalculateBlendFeed, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding IsBlendMaterialSelectorActive}"
                                        Margin="0,0,0,6">

                                <!-- 6 цветных кнопок групп ISO -->
                                <ItemsControl ItemsSource="{Binding IsoGroups}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectBlendIsoGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{Binding BadgeColor}"
                                                    BorderBrush="{Binding BadgeColor}"
                                                    Foreground="White"
                                                    Height="32" Margin="0,0,4,0" Padding="0"
                                                    FontSize="13.5" FontWeight="Bold" Cursor="Hand"
                                                    ToolTip="{Binding Name}">
                                                <TextBlock Text="{Binding CodeLetter}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Бейдж выбранной группы ISO -->
                                <Border Background="{Binding SelectedBlendIsoGroup.BadgeBackground}"
                                        BorderBrush="{Binding SelectedBlendIsoGroup.BadgeColor}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{Binding SelectedBlendIsoGroup.BadgeColor}" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedBlendIsoGroup.CodeLetter}" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedBlendIsoGroup.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Выпадающий список марок выбранной группы ISO -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding FilteredBlendGrades}"
                                              SelectedItem="{Binding SelectedBlendMaterial}"
                                              materialDesign:HintAssist.Hint="Конкретная марка (необязательно)"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GostGrade}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding DinGrade, StringFormat='({0})'}" Foreground="#78909C" FontSize="11.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding ClearBlendGradeCommand}"
                                            Visibility="{Binding HasSelectedBlendMaterial, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Width="36" Height="36" Padding="0" Margin="8,0,0,0"
                                            ToolTip="Сбросить выбор марки (считать по группе ISO)"
                                            Cursor="Hand" />
                                </Grid>

                                <!-- Пресеты интенсивности режимов -->
                                <TextBlock Text="Интенсивность режимов:" FontSize="12" Foreground="#546E7A" Margin="0,10,0,6" />
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Button Content="Щадящий" Command="{Binding SelectBlendIntensityCommand}" CommandParameter="Gentle"
                                            Background="{Binding BlendGentleBg}" Foreground="{Binding BlendGentleFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Оптимальный" Command="{Binding SelectBlendIntensityCommand}" CommandParameter="Optimal"
                                            Background="{Binding BlendOptimalBg}" Foreground="{Binding BlendOptimalFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,4,0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                    <Button Content="Форсированный" Command="{Binding SelectBlendIntensityCommand}" CommandParameter="Aggressive"
                                            Background="{Binding BlendAggressiveBg}" Foreground="{Binding BlendAggressiveFg}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand" />
                                </UniformGrid>
                            </StackPanel>

                            <!-- БЛОК 3 (ЧАСТЬ 3): ПОЛЯ РАБОЧЕЙ ПОДАЧИ F И ОБОРОТОВ ШПИНДЕЛЯ S -->
                            <TextBlock Text="{Binding BlendFeedAutoNote}"
                                       Visibility="{Binding AutoCalculateBlendFeed, Converter={StaticResource BoolToVis}}"
                                       FontSize="11.5" Foreground="#1565C0" TextWrapping="Wrap" Margin="2,0,0,10" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding BlendFeedRateText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UseBlendFeed}"
                                         IsReadOnly="{Binding AutoCalculateBlendFeed}"
                                         core:NumericInputBehavior.IsDecimal="True"
                                         materialDesign:HintAssist.Hint="Подача F на дуге (мм/об)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="7" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding BlendSpindleRpmText, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding AutoCalculateBlendFeed}"
                                         core:NumericInputBehavior.IsInteger="True"
                                         materialDesign:HintAssist.Hint="Обороты шпинделя S (об/мин)"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         MaxLength="6" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Padding="10,8" />
                            </Grid>

                            <!-- БЛОК 4: ПРЕДУПРЕЖДЕНИЯ И ОШИБКИ ВВОДА -->
                            <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                    Visibility="{Binding BlendResult.HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding BlendResult.WarningMessage}" Foreground="#E65100" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding BlendResult.ErrorMessage}" Foreground="#C62828" FontSize="12.5" TextWrapping="Wrap" Margin="2,0,0,0" />

                        </StackPanel>

                        <!-- ПРАВАЯ КОЛОНКА: ВЕКТОРНЫЙ ЭСКИЗ, КООРДИНАТЫ И G-КОД -->
                        <StackPanel Grid.Column="2">
                            <!-- БЛОК 5: ВЕКТОРНЫЙ ЭСКИЗ СОПРЯЖЕНИЯ КОНУСА И ЦИЛИНДРА -->
                            <Border Background="#FAFAFA" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8"
                                    Height="225" Margin="0,0,0,12">
                                <Grid>
                                    <TextBlock Text="Схема сопряжения конуса и цилиндра" FontSize="11" Foreground="#78909C" Margin="10,6,0,0" VerticalAlignment="Top" />

                                    <Canvas Width="320" Height="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Visibility="{Binding BlendResult.IsValid, Converter={StaticResource BoolToVis}}">

                                        <!-- Тело детали -->
                                        <Path Data="{Binding BlendResult.PartBodyPathData}" Fill="#1E455A64" />
                                        <Path Data="{Binding BlendResult.PartOutlinePathData}" Stroke="#455A64" StrokeThickness="2" StrokeLineJoin="Round" />

                                        <!-- Осевая линия X0 и линия угла пересечения -->
                                        <Line X1="14" Y1="{Binding BlendResult.CenterLineY}" X2="306" Y2="{Binding BlendResult.CenterLineY}"
                                              Stroke="#2E7D32" StrokeThickness="1" StrokeDashArray="8 3 1 3" />
                                        <Line X1="{Binding BlendResult.ZeroLineX}" Y1="12" X2="{Binding BlendResult.ZeroLineX}" Y2="188"
                                              Stroke="#2E7D32" StrokeThickness="1.1" StrokeDashArray="6 3" />

                                        <!-- Дуга сопряжения -->
                                        <Path Data="{Binding BlendResult.ArcPathData}"
                                              Stroke="{Binding BlendResult.ArcStrokeBrush}"
                                              StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                        <!-- Вершина теоретического пересечения -->
                                        <Ellipse Width="6" Height="6" Fill="#78909C"
                                                 Canvas.Left="{Binding BlendResult.CanvasCornerX}" Canvas.Top="{Binding BlendResult.CanvasCornerY}" Margin="-3,-3,0,0" />

                                        <!-- Точки касания Start и End -->
                                        <Ellipse Width="7" Height="7" Fill="#263238"
                                                 Canvas.Left="{Binding BlendResult.CanvasStartX}" Canvas.Top="{Binding BlendResult.CanvasStartY}" Margin="-3.5,-3.5,0,0" />
                                        <Ellipse Width="8" Height="8" Fill="{Binding BlendResult.ArcStrokeBrush}"
                                                 Canvas.Left="{Binding BlendResult.CanvasEndX}" Canvas.Top="{Binding BlendResult.CanvasEndY}" Margin="-4,-4,0,0" />

                                        <!-- Подписи координат -->
                                        <Border Canvas.Left="{Binding BlendResult.LabelStartX}" Canvas.Top="{Binding BlendResult.LabelStartY}"
                                                Background="#E6FFFFFF" CornerRadius="3" Padding="3,1">
                                            <TextBlock Text="{Binding BlendResult.StartLabelText}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#263238" />
                                        </Border>

                                        <Border Canvas.Left="{Binding BlendResult.LabelEndX}" Canvas.Top="{Binding BlendResult.LabelEndY}"
                                                Background="#E6FFFFFF" CornerRadius="3" Padding="3,1">
                                            <TextBlock Text="{Binding BlendResult.EndLabelText}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{Binding BlendResult.ArcStrokeBrush}" />
                                        </Border>

                                        <Border Canvas.Left="{Binding BlendResult.LabelCornerX}" Canvas.Top="{Binding BlendResult.LabelCornerY}"
                                                Background="#E6FFFFFF" CornerRadius="3" Padding="3,1">
                                            <TextBlock Text="{Binding BlendResult.CornerLabelText}" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="#546E7A" />
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Border>

                            <!-- БЛОК 6: РАСЧЁТНЫЕ КООРДИНАТЫ ТОЧЕК КАСАНИЯ И СМЕЩЕНИЯ -->
                            <Border Background="#F5F7F8" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                    Visibility="{Binding BlendResult.IsValid, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Точка начала дуги (X_нач, Z_нач):" FontSize="13" Foreground="#37474F" />
                                        <TextBlock DockPanel.Dock="Right" FontSize="13.5" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="X{0:0.###}   Z{1:0.###}">
                                                    <Binding Path="BlendResult.StartX" />
                                                    <Binding Path="BlendResult.StartZ" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Точка конца дуги (X_кон, Z_кон):" FontSize="13" Foreground="#37474F" />
                                        <TextBlock DockPanel.Dock="Right" FontSize="13.5" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="X{0:0.###}   Z{1:0.###}">
                                                    <Binding Path="BlendResult.EndX" />
                                                    <Binding Path="BlendResult.EndZ" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DockPanel>

                                    <Separator Margin="0,2,0,6" />

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Смещение точек касания ΔZ / ΔX:" FontSize="12.5" Foreground="#546E7A" />
                                        <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="ΔZ = {0:0.###} мм  |  ΔX = {1:0.###} мм">
                                                    <Binding Path="BlendResult.TangentOffsetZ" />
                                                    <Binding Path="BlendResult.TangentDeltaX" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Смещение центра дуги (I, K):" FontSize="12.5" Foreground="#546E7A" />
                                        <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Foreground="#263238" HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="I{0:0.###}   K{1:0.###}">
                                                    <Binding Path="BlendResult.CenterOffsetI" />
                                                    <Binding Path="BlendResult.CenterOffsetK" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DockPanel>

                                    <Separator Margin="0,4,0,6" />

                                    <DockPanel>
                                        <TextBlock Text="Расчётный радиус траектории / Время:" FontSize="12.5" FontWeight="SemiBold" Foreground="#2E7D32" />
                                        <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="R{0:0.###} мм  •  {1}">
                                                    <Binding Path="BlendResult.EffectiveArcRadius" />
                                                    <Binding Path="BlendResult.MachiningTimeText" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- БЛОК 7: ДВОЙНОЙ БЛОК G-КОДА (R И I, K) -->
                            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="10"
                                    Visibility="{Binding BlendResult.IsValid, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <!-- Вариант 1: Через радиус R -->
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Command="{Binding CopyBlendGCodeRadiusCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="28" Padding="8,0" VerticalAlignment="Center" Cursor="Hand"
                                                ToolTip="Скопировать G-код через радиус R">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="R" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Через радиус (R):" FontSize="11" Foreground="#2E7D32" />
                                            <TextBlock Text="{Binding BlendResult.GCodeRadiusSnippet}"
                                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#1B5E20" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Separator Margin="0,0,0,8" />

                                    <!-- Вариант 2: Через координаты центра I, K -->
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding CopyBlendGCodeIKCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="28" Padding="8,0" VerticalAlignment="Center" Cursor="Hand"
                                                ToolTip="Скопировать G-код через центр I, K">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="I, K" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Через центр (I, K):" FontSize="11" Foreground="#2E7D32" />
                                            <TextBlock Text="{Binding BlendResult.GCodeIKSnippet}"
                                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#1B5E20" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
