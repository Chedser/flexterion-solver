<Window x:Class="MechCore.Views.AboutWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:MechCore.Controls"
            xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
            xmlns:core="clr-namespace:MechCore.Core"
            Title="О программе"
            Width="440"
            SizeToContent="Height"
            ResizeMode="NoResize"
            WindowStartupLocation="CenterOwner"
            Background="#ECEFF1"
            Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#1565C0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#0D47A1" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Фирменная шапка в стиле MainWindow -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="20,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CogOutline" Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static core:AppInfo.Name}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{x:Static core:AppInfo.Version}" FontSize="13" Opacity="0.8" VerticalAlignment="Bottom" Margin="8,0,0,2" />
                    </StackPanel>
                    <TextBlock Text="Инженерный комплекс мехобработки и ЧПУ" FontSize="12" Opacity="0.85" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Основное содержимое -->
        <StackPanel Grid.Row="1" Margin="20">
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="О системе" FontSize="14" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,6" />
                    <TextBlock Text="Справочная база ГОСТ и ЕСДП, расчёт режимов резания, геометрии и генерация управляющих программ для токарной и фрезерной обработки."
                               FontSize="12.5" Foreground="#546E7A" TextWrapping="Wrap" LineHeight="18" />

                    <Separator Margin="0,14" />

                    <TextBlock Text="Контакты разработчика" FontSize="14" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,10" />

                    <!-- Telegram -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="Send" Width="18" Height="18" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock FontSize="13" VerticalAlignment="Center">
                            <Run Text="Telegram: " Foreground="#546E7A" />
                            <Hyperlink NavigateUri="https://t.me/vectorflex" RequestNavigate="OnContactLinkNavigate">
                                @vectorflex
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- GitHub -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="Github" Width="18" Height="18" Foreground="#263238" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock FontSize="13" VerticalAlignment="Center">
                            <Run Text="GitHub: " Foreground="#546E7A" />
                            <Hyperlink NavigateUri="https://github.com/Chedser" RequestNavigate="OnContactLinkNavigate">
                                Vectorflex
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="EmailOutline" Width="18" Height="18" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock FontSize="13" VerticalAlignment="Center">
                            <Run Text="Почта: " Foreground="#546E7A" />
                            <Hyperlink NavigateUri="mailto:vectorflex@gmail.com" RequestNavigate="OnContactLinkNavigate">
                                vectorflex@gmail.com
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Нижняя строка с копирайтом и кнопкой закрытия -->
            <DockPanel LastChildFill="False">
                <TextBlock Text="{x:Static core:AppInfo.Copyright}"
                           FontSize="12"
                           Foreground="#78909C"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <Button Content="Закрыть"
                        Click="OnCloseClicked"
                        IsCancel="True"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="20,0" Height="32"
                        DockPanel.Dock="Right" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
