<Window x:Class="MechCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:core="clr-namespace:MechCore.Core"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
        Title="Flexterion — Инженерный комплекс" 
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <core:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ (HEADER) -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,12">
            <DockPanel LastChildFill="False" Cursor="">

                <!-- Название приложения (кликабельно — открывает окно «О программе») -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="О программе Flexterion"
                            MouseLeftButtonUp="OnAboutClicked">
                    <materialDesign:PackIcon Kind="CogOutline" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{x:Static core:AppInfo.Name}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static core:AppInfo.Version}" FontSize="12" Opacity="0.7" VerticalAlignment="Bottom" Margin="8,0,0,2" />
                </StackPanel>

                <!-- Переключатель режимов: Оператор / Инженер -->
                <Border DockPanel.Dock="Right" Background="#28000000" CornerRadius="8" Padding="14,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Подпись слева: Оператор -->
                        <TextBlock Text="Оператор" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Opacity" Value="1.0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineerMode}" Value="True">
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Круглый слайдер (тумблер) без галочки -->
                        <ToggleButton IsChecked="{Binding IsEngineerMode, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Cursor="Hand"
                                      Width="44" Height="22">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Track"
                                            Background="#44FFFFFF"
                                            CornerRadius="11"
                                            Padding="2">
                                        <Ellipse x:Name="Thumb"
                                            Width="18" Height="18"
                                            Fill="White"
                                            HorizontalAlignment="Left">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="Track" Property="Background" Value="#FFB300" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Подпись справа: Инженер -->
                        <TextBlock Text="Инженер" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="Opacity" Value="0.55" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineerMode}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>
                </Border>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- 2. НИЖНЯЯ ЧАСТЬ: МЕНЮ СЛЕВА + КОНТЕНТ СПРАВА -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Часть 2: Боковое меню -->
            <materialDesign:Card Grid.Column="0" Margin="0" UniformCornerRadius="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,16">

                        <!-- ОБЩИЙ БЛОК -->
                        <TextBlock Text="ОБЩИЙ БЛОК" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="16,0,0,8" />
                        <ListBox x:Name="GeneralMenuListBox" SelectedIndex="0">
                            <!-- Пункт 1: Допуски и посадки -->
                            <ListBoxItem Padding="16,12" Cursor="Hand" Selected="OnTolerancesMenuSelected">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="RulerSquare" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Допуски и посадки" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Пункт 2: Справочник резьб -->
                            <ListBoxItem Padding="16,12" Cursor="Hand" IsEnabled="{Binding IsThreadsReady}" Selected="OnThreadsMenuSelected">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ScrewMachineFlatTop" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Справочник резьб" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Пункт 3: Материаловедение -->
                            <ListBoxItem Padding="16,12" Cursor="Hand" IsEnabled="{Binding IsMaterialsReady}" Selected="OnMaterialsMenuSelected">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Atom" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Материаловедение" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Пункт 4: Справочник ГОСТов -->
                            <ListBoxItem Padding="16,12" Cursor="Hand" IsEnabled="{Binding IsGostReady}" Selected="OnGostDirectoryMenuSelected">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BookOpenPageVariantOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Справочник ГОСТов" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Пункт 5: Калькулятор Windows -->
                            <ListBoxItem Padding="16,12" Cursor="Hand" PreviewMouseLeftButtonDown="OnCalculatorMenuClicked">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Calculator" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Калькулятор Windows" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <Separator Margin="12,16" />

                        <!-- ТОКАРНЫЙ БЛОК -->
                        <TextBlock Text="ТОКАРНАЯ ОБРАБОТКА" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="16,0,0,8" />
                        <ListBox x:Name="TurningMenuListBox">
                            <ListBoxItem Padding="16,12" Cursor="Hand" IsEnabled="{Binding IsTurningHeaderReady}" Selected="OnTurningHeaderMenuSelected">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Шапка программы" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Padding="16,12" Cursor="Hand" IsEnabled="{Binding IsTurningCuttingReady}" Selected="OnTurningCuttingMenuSelected">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AxisZRotateClockwise" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Режимы резания" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Padding="16,12" Cursor="Hand" IsEnabled="{Binding IsGeometryReady}" Selected="OnGeometryMenuSelected">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TriangleOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Геометрия и циклы" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <Separator Margin="12,16" />

                        <!-- ФРЕЗЕРНЫЙ БЛОК -->
                        <TextBlock Text="ФРЕЗЕРНАЯ ОБРАБОТКА" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="16,0,0,8" />
                        <ListBox x:Name="MillingMenuListBox">
                            <ListBoxItem Padding="16,12" Cursor="Hand" IsEnabled="{Binding IsMillingHeaderReady}" Selected="OnMillingHeaderMenuSelected">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Шапка программы" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Padding="16,12" Cursor="Hand" IsEnabled="{Binding IsMillingCuttingReady}" Selected="OnMillingCuttingMenuSelected">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SawBlade" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Режимы резания" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Padding="16,12" Cursor="Hand" IsEnabled="{Binding IsMillingGeometryReady}" Selected="OnMillingGeometryMenuSelected">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="VectorCircleVariant" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Геометрия и циклы" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                        <Separator Margin="12,16" />

                        <!-- СПРАВКА / О ПРОГРАММЕ -->
                        <ListBox>
                            <ListBoxItem Padding="16,12" Cursor="Hand" PreviewMouseLeftButtonDown="OnAboutClicked">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="О программе" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- Часть 3: Рабочая область справа с кэшированием открытых экранов -->
            <Border Grid.Column="1" Padding="24">
                <ItemsControl ItemsSource="{Binding CachedScreens}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Content}"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</Window>
