<UserControl x:Class="MechCore.Controls.EngineeringChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             x:Name="RootControl">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок графика -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TitleTextBlock"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialDesignBody}"/>
            <TextBlock x:Name="DescriptionTextBlock"
                       FontSize="11.5"
                       Opacity="0.72"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Рабочее поле Canvas -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="6"
                Background="#FAFAFA"
                ClipToBounds="True">
            <Grid>
                <Canvas x:Name="ChartCanvas"
                        MinHeight="240"
                        Background="Transparent"
                        SizeChanged="ChartCanvas_SizeChanged"
                        MouseMove="ChartCanvas_MouseMove"
                        MouseLeave="ChartCanvas_MouseLeave"/>

                <!-- Интерактивный прицел и плавающий тултип -->
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                    <Line x:Name="CrosshairV"
                          Stroke="#90A4AE"
                          StrokeThickness="1"
                          StrokeDashArray="3,3"
                          Visibility="Collapsed"/>
                    <Line x:Name="CrosshairH"
                          Stroke="#90A4AE"
                          StrokeThickness="1"
                          StrokeDashArray="3,3"
                          Visibility="Collapsed"/>

                    <Border x:Name="HoverTooltip"
                            Background="#263238"
                            CornerRadius="4"
                            Padding="8,5"
                            Visibility="Collapsed">
                        <TextBlock x:Name="HoverTooltipText"
                                   Foreground="White"
                                   FontSize="11"
                                   FontFamily="Consolas"/>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!-- Легенда кривых -->
        <ItemsControl x:Name="LegendItemsControl" Grid.Row="2" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                        <Border Width="14" Height="3"
                                Background="{Binding StrokeBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Выбранный материал по ISO под легендой -->
        <Border x:Name="MaterialBadgeBorder"
                Grid.Row="3"
                Margin="0,6,0,0"
                Padding="8,4"
                CornerRadius="4"
                Background="#F5F7F9"
                BorderBrush="#CFD8DC"
                BorderThickness="1"
                HorizontalAlignment="Left"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="TagOutline"
                                         Width="14" Height="14"
                                         Foreground="#1565C0"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                <TextBlock x:Name="MaterialBadgeTextBlock"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="#263238"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
