<UserControl x:Class="MechCore.Controls.NumberPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             x:Name="RootControl">
    <Grid>
        <!-- Значок-кнопка для открытия каталога размеров -->
        <Button x:Name="OpenButton"
                Click="OnOpenButtonClick"
                ToolTip="Выбрать значение из таблицы"
                Style="{StaticResource MaterialDesignIconButton}"
                Width="32" Height="32" Padding="4" Cursor="Hand">
            <materialDesign:PackIcon Kind="ViewGridOutline" Width="20" Height="20" Foreground="#455A64" />
        </Button>

        <!-- Всплывающее окно с таблицей -->
        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <materialDesign:Card Margin="8" Padding="16" UniformCornerRadius="8"
                                 materialDesign:ElevationAssist.Elevation="Dp8"
                                 Background="White" BorderBrush="#CFD8DC" BorderThickness="1">
                <StackPanel MaxWidth="810">
                    <!-- Шапка окна: выпадающий список групп и кнопка закрытия -->
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Диапазон:" FontWeight="SemiBold" Foreground="#455A64" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ComboBox x:Name="GroupsComboBox"
                                  DisplayMemberPath="Title"
                                  SelectionChanged="OnGroupSelectionChanged"
                                  FontSize="14" FontWeight="Medium" MinWidth="290" />

                        <Button DockPanel.Dock="Right" Click="OnCloseButtonClick"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="28" Height="28" Margin="16,0,0,0" ToolTip="Закрыть">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                        </Button>
                    </DockPanel>

                    <!-- Таблица: вертикальные столбцы по 10 элементов с горизонтальной прокруткой -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="360">
                        <ItemsControl x:Name="ColumnsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Один вертикальный столбец из 10 элементов -->
                                    <ItemsControl ItemsSource="{Binding}" Margin="0,0,4,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding DisplayText}"
                                                        Tag="{Binding Value}"
                                                        Click="OnNumberCellClick"
                                                        Width="54" Height="28" Margin="0,0,0,3" Padding="2"
                                                        FontSize="12.5" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                            <Setter Property="BorderBrush" Value="#E0E0E0" />
                                                            <Setter Property="Foreground" Value="#263238" />
                                                            <Setter Property="Background" Value="White" />
                                                            <Style.Triggers>
                                                                <!-- Выделение первого элемента в каждом столбце -->
                                                                <DataTrigger Binding="{Binding IsColumnHeader}" Value="True">
                                                                    <Setter Property="Background" Value="#E3F2FD" />
                                                                    <Setter Property="BorderBrush" Value="#64B5F6" />
                                                                    <Setter Property="Foreground" Value="#0D47A1" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </materialDesign:Card>
        </Popup>
    </Grid>
</UserControl>
